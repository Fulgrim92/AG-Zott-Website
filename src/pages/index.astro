<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(ScrollTrigger, SplitText);
  const motionOK = () => document.documentElement.dataset.motion !== 'off';

  // Three.js brain after first paint
  const brain = document.querySelector<HTMLElement>('[data-hero-brain]');
  if (brain) {
    const go = () => import('../scripts/heroBrain').then((m) => m.initHeroBrain(brain)).catch(() => brain.classList.add('no-webgl'));
    'requestIdleCallback' in window ? (window as any).requestIdleCallback(go, { timeout: 900 }) : setTimeout(go, 300);
  }
  // Deep-dive modules load when the visitor gets close
  const lazy = (sel: string, load: (el: HTMLElement) => void) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); load(el); } }, { rootMargin: '150% 0px' });
    io.observe(el);
  };
  lazy('[data-ga]', (el) => import('../scripts/abstract').then((m) => { m.initAbstract(el); ScrollTrigger.refresh(); }));
  lazy('[data-dp]', (el) => import('../scripts/pipeline').then((m) => m.initPipeline(el)));
  // Deep links (#methods) work after the lazy modules add their pin spacing
  if (location.hash === '#methods') setTimeout(() => document.getElementById('methods')?.scrollIntoView(), 600);

  // Hero entrance
  if (motionOK()) {
    const title = document.querySelector<HTMLElement>('[data-hero-title]');
    const tl = gsap.timeline({ delay: 0.15 });
    if (title) {
      const split = SplitText.create(title, { type: 'words,lines', mask: 'lines', aria: 'auto' });
      tl.from(split.words, { yPercent: 110, duration: 1.1, ease: 'expo.out', stagger: 0.045 });
    }
    tl.from('[data-intro]', { y: 18, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 }, 0.3);
    // Hero text drifts up and fades as the page scrolls on
    gsap.to('.hero__text', { yPercent: -12, opacity: 0.2, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });
  }

  // Muted autoplay of preview videos when visible
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    new IntersectionObserver(([e]) => { if (e.isIntersecting && motionOK()) v.play().catch(() => {}); else v.pause(); }, { threshold: 0.3 }).observe(v);
  });

  // Summary video: muted background loop behind "What we do", plus the full version with captions in a dialog
  const bgVideo = document.querySelector<HTMLVideoElement>('[data-about-video]');
  if (bgVideo) {
    let seen = false;
    const sync = () => { if (seen && motionOK()) bgVideo.play().catch(() => {}); else bgVideo.pause(); };
    new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }, { threshold: 0.1 }).observe(bgVideo);
    document.addEventListener('agz:motion', sync);
  }
  const dlg = document.querySelector<HTMLDialogElement>('[data-watch-dialog]');
  document.querySelector('[data-watch]')?.addEventListener('click', () => {
    if (!dlg) return;
    dlg.showModal();
    dlg.querySelector('video')?.play().catch(() => {});
  });
  dlg?.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
  dlg?.addEventListener('close', () => dlg.querySelector('video')?.pause());
</script>
