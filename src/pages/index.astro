---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import Icon from '../components/Icon.astro';
import Emblem from '../components/Emblem.astro';
import ImagingField from '../components/ImagingField.astro';
import FunderLogo from '../components/FunderLogo.astro';
import NeuralBackdrop from '../components/NeuralBackdrop.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import GraphicalAbstract from '../components/GraphicalAbstract.astro';
import DataPipeline from '../components/DataPipeline.astro';
import GlymphaticTracer from '../components/GlymphaticTracer.astro';
import AnatomyIntro from '../components/AnatomyIntro.astro';
import OcularDive from '../components/OcularDive.astro';
import Logo from '../components/Logo.astro';
import team from '../data/team.json';
import EphysSlice from '../components/EphysSlice.astro';
import home from '../data/home.json';
import assets from '../data/assets.json';
import site from '../data/site.json';
import news from '../data/news.json';
import papers from '../data/papers.json';
import { url } from '../lib/url';
import { existsSync } from 'node:fs';

// *word* → highlighted
const hl = (s: string) => s.replace(/\*(.+?)\*/g, '<span class="hl">$1</span>');
const H = home.hero;
const latestPaperNews = [...news].filter((n) => n.category === 'Paper' && !n.placeholder).sort((a, b) => b.date.localeCompare(a.date))[0];
const rec2 = assets.twoPhoton.recordings[1] ?? assets.twoPhoton.recordings[0];
const confocal = assets.ihc.sections[assets.ihc.sections.length - 1];

// Latest findings: newest papers that carry a plain-language summary
const findings = [...papers].filter((p: any) => !p.placeholder && p.summary).sort((a, b) => b.year - a.year).slice(0, 3);
const newsByDoi = Object.fromEntries(news.filter((n) => n.link?.includes('doi.org')).map((n) => [n.link!.split('doi.org/')[1], n.date]));
const fmtMonth = (d?: string, y?: number) => (d ? new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : String(y));
// Journal mastheads for the findings cards: typographic, in each journal's house colours (no logo files)
const JOURNALS: Record<string, { mast: string; cls: string }> = {
  'Science': { mast: 'Science', cls: 'science' },
  'Nature Communications': { mast: 'nature communications', cls: 'natcomms' },
  'PNAS': { mast: 'PNAS', cls: 'pnas' },
  'Neuron': { mast: 'Neuron', cls: 'cell' },
  'Seminars in Cell & Developmental Biology': { mast: 'Seminars in Cell & Developmental Biology', cls: 'elsevier' },
  'Annual Review of Neuroscience': { mast: 'Annual Review of Neuroscience', cls: 'annrev' },
};
const journalMeta = (p: any) => {
  const name = shortJournal(p.journal, p.journalShort);
  const vol = (p.journal.match(/\s(\d+)[(:]/) ?? [])[1];
  return { name, vol, ...(JOURNALS[name] ?? { mast: name, cls: 'generic' }) };
};
const shortJournal = (j: string, s?: string) => s || j.replace(/\s*\(.*?\)/, '').replace(/\s[\d(].*$/, '');
const authorsShort = (a: string) => { const l = a.split(', '); return l.length > 3 ? `${l.slice(0, 3).join(', ')} … ${l[l.length - 1]}` : a; };

// Hero team strip: PI first, then members (photos from team.json, initials until a photo is added)
const heroTeam = (team as any[]).slice(0, 4).map((m) => ({
  label: m.placeholder ? m.position : m.name,
  role: m.placeholder ? 'Open position' : m.position,
  photo: m.photo,
  initials: m.name.replace(/\[.*?\]/g, '').trim().split(/\s+/).map((w: string) => w[0]).slice(0, 2).join('') || '?',
  ph: m.placeholder,
}));
const methods = [
  { href: '/research/two-photon/', title: 'Two-photon imaging', text: 'In vivo calcium imaging of hundreds of CA1 neurons to detect early, β-amyloid-driven hyperactivity.', media: 'video', label: 'data' },
  ...(site.features.glymphatic ? [{ href: '/research/glymphatic/', title: 'Glymphatic system', text: 'Tracer imaging in mice and MRI in humans: how fluid flow clears the brain, from models to patients.', media: 'glym', label: 'schematic' }] : []),
  { href: '/research/immunohistochemistry/', title: 'Immunohistochemistry', text: 'Staining and confocal imaging of brain sections to map amyloid plaques and the cells around them.', media: 'image', label: 'published' },
  { href: '/research/electrophysiology/', title: 'Electrophysiology', text: 'Brain-slice recordings of synaptic plasticity (LTP), EEG and field potentials: network function from hours to milliseconds.', media: 'trace', label: 'schematic' },
];
// Funders shown in the hero. Official logo files go in public/assets/logos/ (see FunderLogo.astro);
// until they exist, the funder's name is shown as text (never a redrawn logo).
const logo = (b: string) => { const f = [`${b}.svg`, `${b}.png`].find((x) => existsSync(`${process.cwd()}/public/assets/logos/${x}`)); return f ? url(`/assets/logos/${f}`) : null; };
const heroFunders = [
  { id: 'ERC', name: 'European Research Council', logos: [logo('eu-emblem'), logo('erc')].filter(Boolean) as string[] },
  { id: 'DFG', name: 'Deutsche Forschungsgemeinschaft', logos: [logo('dfg')].filter(Boolean) as string[] },
];
// Summary video (rendered in video/, see video/README.md); falls back to the animated imaging field if absent
const vid = (f: string) => existsSync(`${process.cwd()}/public/assets/video/${f}`);
const summaryVideo = vid('summary-bg.mp4') ? { bg: url('/assets/video/summary-bg.mp4'), full: url('/assets/video/summary.mp4'), poster: url('/assets/video/summary-poster.jpg') } : null;
// Cover motif per theme for publication cards (decorative, not data)
const motif = (p: any) => p.themes.includes('immunohistochemistry') ? 'ihc' : p.themes.includes('electrophysiology') ? 'ephys' : 'cells';
---
<Base>
  <!-- ======================= Hero ======================= -->
  <section class="hero theme-dark" aria-labelledby="hero-h">
    <div class="hero__aurora" aria-hidden="true"><i></i><i></i><i></i></div>
    <NeuralBackdrop density={0.9} opacity={0.8} />
    <div class="hero__brain" data-hero-brain data-atlas={url('/assets/atlas/')}>
      <canvas aria-hidden="true"></canvas>
      <div class="hero__fallback" aria-hidden="true"></div>
      <span class="hero__scan" aria-hidden="true"></span>
    </div>
    <div class="hero__inner container container--wide">
      <div class="hero__brand" data-intro>
        <span class="hero__ring" aria-hidden="true"></span>
        <Logo size={104} class="hero__logo" />
        <p class="hero__name" aria-hidden="true">AG Zott</p>
        <p class="hero__sub">{site.tagline ?? 'Hippocampal circuits in health and Alzheimer’s disease'}</p>
      </div>
      <a class="hero__team" href={url('/team/')} data-intro aria-label="Meet the team">
        <ul role="list">
          {heroTeam.map((m, i) => (
            <li class:list={['hero__member', { 'is-ph': m.ph }]} style={`--i:${i}`}>
              <span class="hero__face">{m.photo ? <img src={url(m.photo)} alt="" loading="lazy" /> : <span>{m.initials}</span>}</span>
              <span class="hero__who"><b>{m.label}</b><small>{m.role}</small></span>
            </li>
          ))}
        </ul>
        <span class="hero__teamlink">Meet the team <span aria-hidden="true">→</span></span>
      </a>
      <div class="hero__text">
        {latestPaperNews && (
          <a class="hero__news" href={url(`/news/${latestPaperNews.slug}/`)} data-intro>
            <span class="hero__new">New</span><span class="hero__newst">{latestPaperNews.title}</span><span aria-hidden="true">→</span>
          </a>
        )}
        <p class="eyebrow" data-intro>{H.eyebrow}</p>
        <h1 id="hero-h" data-hero-title set:html={hl(H.title)} />
        <p class="lead" data-intro>{H.lead}</p>
        <div class="hero__cta" data-intro>
          <a class="btn btn--primary" href={url(H.primary.href)} data-magnetic>{H.primary.label} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={url(H.secondary.href)}>{H.secondary.label}</a>
        </div>
        <a class="hero__funders" href={url('/funding/')} data-intro>
          <span class="hero__fundlbl">Funded by</span>
          {heroFunders.map((f) => (
            <span class:list={['hero__funder', { 'has-logo': f.logos.length }]} data-nb-anchor title={f.logos.length ? f.name : `${f.name} (official logo file not yet added: public/assets/logos/)`}>
              {f.logos.length
                ? f.logos.map((src) => <img src={src} alt={`${f.name} logo`} class={`hero__flogo hero__flogo--${f.id.toLowerCase()}`} />)
                : <><b>{f.id}</b><small>{f.name}</small></>}
            </span>
          ))}
        </a>
      </div>
    </div>
    <p class="hero__cap small" data-intro>{H.caption} <a href="https://atlas.brain-map.org/" rel="noopener">Allen Institute</a></p>
    <a class="hero__scroll" href="#about" aria-label="Scroll to content"><span></span></a>
  </section>

  <!-- ======================= What we do ======================= -->
  <section class="section section--tight about theme-dark" id="about" data-scan aria-labelledby="about-h">
    {summaryVideo ? (
      <div class="about__video" aria-hidden="true">
        <video poster={summaryVideo.poster} muted loop playsinline preload="metadata" data-about-video>
          <source src={summaryVideo.bg.replace('.mp4', '.webm')} type="video/webm" /><source src={summaryVideo.bg} type="video/mp4" />
        </video>
      </div>
    ) : <ImagingField />}
    <div class="container container--wide about__grid">
      <div>
        <p class="eyebrow">{home.about.eyebrow}</p>
        <h2 id="about-h" data-split>{home.about.title}</h2>
        <p class="muted" data-reveal>{home.about.text}</p>
        {summaryVideo && (
          <button class="about__watch" type="button" data-watch data-reveal>
            <span class="about__play" aria-hidden="true"><svg viewBox="0 0 24 24" width="16" height="16"><path d="M8 5v14l11-7z" fill="currentColor" /></svg></span>
            {home.about.watchLabel}
          </button>
        )}
      </div>
      <ul class="about__cards" role="list">
        {home.about.cards.map((c) => (
          <li class="card about__card" data-reveal>
            <span class="about__icon"><Emblem name={c.icon} size={116} /></span>
            <h3>{c.title}</h3>
            <p class="muted small">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
    {summaryVideo && (
      <dialog class="watch" data-watch-dialog aria-label={home.about.watchLabel}>
        <video poster={summaryVideo.poster} controls playsinline preload="none">
          <source src={summaryVideo.full.replace('.mp4', '.webm')} type="video/webm" /><source src={summaryVideo.full} type="video/mp4" />
        </video>
        <form method="dialog"><button class="watch__close" aria-label="Close">×</button></form>
      </dialog>
    )}
  </section>

  <!-- ======================= Rundown ======================= -->
  <section class="rundown" aria-labelledby="rundown-h">
    <div class="container container--wide rundown__in">
      <p class="eyebrow">{home.rundown.eyebrow}</p>
      <h2 id="rundown-h" data-split>{home.rundown.title}</h2>
      <ol class="rundown__map" role="list" data-reveal>
        {home.rundown.items.map((it, i) => <li><a href={it.href}><span class="mono">{String(i + 1).padStart(2, '0')}</span>{it.label}</a></li>)}
      </ol>
    </div>
  </section>

  <!-- ======================= Approach ======================= -->
  <section class="section section--tight approach" id="approach" data-scan aria-labelledby="approach-h">
    <div class="container container--wide approach__grid">
      <div class="approach__intro">
        <p class="eyebrow">{home.approach.eyebrow}</p>
        <h2 id="approach-h" data-split>{home.approach.title}</h2>
        <p class="muted" data-reveal>{home.approach.text}</p>
        <a class="btn" href={url(home.approach.link.href)} data-reveal>{home.approach.link.label} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ul class="methods" role="list">
        {methods.map((m) => (
          <li data-reveal>
            <a class="method" href={url(m.href)}>
              <div class="method__media theme-dark">
                {m.media === 'video' && <video src={url(rec2.src)} poster={url(rec2.poster)} muted loop playsinline preload="none" data-autoplay aria-label={rec2.alt}></video>}
                {m.media === 'image' && <img src={url(confocal.src)} alt={confocal.alt} loading="lazy" />}
                {m.media === 'glym' && <GlymphaticTracer compact />}
                {m.media === 'trace' && <EphysSlice />}
                <span class="method__label">
                  {m.label === 'data' && <Label kind="data" />}
                  {m.label === 'published' && <Label kind="data" text="Published data" />}
                  {m.label === 'schematic' && <Label kind="schematic" />}
                </span>
              </div>
              <h3>{m.title}</h3>
              <p class="muted small">{m.text}</p>
              <span class="link-arrow small">Learn more</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Findings ======================= -->
  <section class="section section--tight findings" id="findings" data-scan aria-labelledby="find-h">
    <div class="container container--wide">
      <div class="sec-head">
        <div><p class="eyebrow">{home.findings.eyebrow}</p><h2 id="find-h" data-split>{home.findings.title}</h2></div>
        <a class="link-arrow" href={url(home.findings.link.href)}>{home.findings.link.label}</a>
      </div>
      <ul class="pubs" role="list">
        {findings.map((p: any, i) => (
          <li data-reveal>
            <a class="pub" href={p.doi ? `https://doi.org/${p.doi}` : url('/papers/')} rel="noopener">
              <div class={`pub__cover pub__cover--${motif(p)} jm--${journalMeta(p).cls}`} aria-hidden="true">
                <span class="pub__mast"><span>{journalMeta(p).mast}</span></span>
                <svg viewBox="0 0 200 200" data-cover={motif(p)}>
                  {motif(p) === 'cells' && Array.from({ length: 22 }, (_, k) => {
                    const a = k * 2.4, r = 18 + (k * 37) % 70;
                    return <circle cx={100 + Math.cos(a) * r} cy={100 + Math.sin(a) * r} r={6 + (k % 4) * 2} class={k % 5 === 0 ? 'on' : ''} style={`--d:${(k % 7) * 0.4}s`} />;
                  })}
                  {motif(p) === 'ihc' && Array.from({ length: 30 }, (_, k) => <circle cx={(k * 53) % 200} cy={(k * 89) % 200} r={2 + (k % 5)} class={k % 3 ? '' : 'on'} style={`--d:${(k % 6) * 0.5}s`} />)}
                  {motif(p) === 'ephys' && <path d="M0 100 L30 100 L36 60 L42 140 L48 100 L90 100 L96 50 L102 150 L108 100 L200 100" class="ln" />}
                </svg>
                <span class="pub__journal">{journalMeta(p).vol ? `Vol. ${journalMeta(p).vol} · ` : ''}{p.year}</span>
              </div>
              <div class="pub__body">
                <p class="pub__meta"><span>{fmtMonth(newsByDoi[p.doi], p.year)}</span><span>{shortJournal(p.journal, p.journalShort)}</span></p>
                <h3>{p.title}</h3>
                <p class="pub__sum small muted">{p.summary}</p>
                <p class="pub__auth small" set:html={authorsShort(p.authors).replace(/Zott B/g, '<b>Zott B</b>')} />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Team ======================= -->
  <section class="section section--tight team" id="team" data-scan aria-labelledby="team-h">
    <div class="container container--wide team__grid">
      <div>
        <p class="eyebrow">{home.team.eyebrow}</p>
        <h2 id="team-h" data-split>{home.team.title}</h2>
        <p class="muted" data-reveal>{home.team.text}</p>
        <a class="btn" href={url(home.team.link.href)} data-reveal>{home.team.link.label} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <TeamCarousel />
    </div>
  </section>

  <!-- ======================= Join + funding ======================= -->
  <section class="section section--tight join" id="join" data-scan aria-labelledby="join-h">
    <div class="container container--wide join__grid">
      <div class="join__card" data-reveal>
        <h2 id="join-h">{home.join.title}</h2>
        <p class="muted">{home.join.text}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={url(home.join.primary.href)} data-magnetic>{home.join.primary.label} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={url(home.join.secondary.href)}>{home.join.secondary.label}</a>
        </div>
      </div>
      <a class="fund" href={url('/funding/')} data-reveal>
        <p class="eyebrow">Funding</p>
        <p class="fund__text">Our research is supported by the European Research Council and the Deutsche Forschungsgemeinschaft.</p>
        <div class="fund__logos"><FunderLogo funder="EU" height={40} /><FunderLogo funder="ERC" height={40} /><FunderLogo funder="DFG" height={40} /></div>
      </a>
    </div>
  </section>

  <!-- ======================= Deep dive ======================= -->
  <div class="deep theme-dark" id="methods">
    <header class="deep__intro section" aria-labelledby="deep-h">
      <NeuralBackdrop density={1.2} opacity={0.7} />
      <div class="container deep__head">
        <p class="eyebrow">{home.deep.eyebrow}</p>
        <h2 id="deep-h" data-split set:html={hl(home.deep.title)} />
        <p class="lead" data-reveal>{home.deep.lead}</p>
        <ol class="deep__parts" role="list" data-reveal>
          {home.deep.parts.map((p, i) => <li><span class="mono">0{i + 1}</span>{p}</li>)}
        </ol>
      </div>
    </header>

    <OcularDive />
    <div class="deep__part container container--wide"><p class="deep__partlbl"><span class="mono">01</span> {home.deep.parts[0]}</p></div>
    <AnatomyIntro />
    <div class="deep__part container container--wide"><p class="deep__partlbl"><span class="mono">02</span> {home.deep.parts[1]}</p></div>
    <GraphicalAbstract />
    <div class="deep__part container container--wide"><p class="deep__partlbl"><span class="mono">03</span> {home.deep.parts[2]}</p></div>
    <DataPipeline />
  </div>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: min(100svh, 920px); display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; overflow: hidden; padding: calc(var(--header-h) + var(--s6)) clamp(var(--s2), 5vw, var(--s6)) var(--s7);
    background: radial-gradient(900px 600px at 78% 45%, #0f3346 0%, transparent 70%), linear-gradient(180deg, #06141b, #081c25 60%, #071820); }
  .hero__brain { position: absolute; inset: 0 -4% 0 40%; }
  /* slow aurora in the lab colours behind everything */
  .hero__aurora { position: absolute; inset: -20%; pointer-events: none; filter: blur(60px); opacity: .55; }
  .hero__aurora i { position: absolute; width: 46%; height: 46%; border-radius: 50%; mix-blend-mode: screen; animation: aurora 22s ease-in-out infinite alternate; }
  .hero__aurora i:nth-child(1) { left: 48%; top: 18%; background: radial-gradient(circle, rgba(95, 211, 198, .45), transparent 65%); }
  .hero__aurora i:nth-child(2) { left: 62%; top: 42%; background: radial-gradient(circle, rgba(77, 255, 154, .22), transparent 65%); animation-duration: 28s; animation-delay: -9s; }
  .hero__aurora i:nth-child(3) { left: 30%; top: 50%; background: radial-gradient(circle, rgba(155, 140, 255, .25), transparent 65%); animation-duration: 34s; animation-delay: -15s; }
  @keyframes aurora { 0% { transform: translate(0, 0) scale(1); } 50% { transform: translate(-8%, 6%) scale(1.15); } 100% { transform: translate(6%, -5%) scale(.92); } }
  /* a two-photon raster line slowly sweeping over the brain */
  .hero__scan { position: absolute; left: 10%; right: 6%; top: 0; height: 90px; pointer-events: none; opacity: 0;
    background: linear-gradient(180deg, transparent, rgba(255, 90, 74, .035) 75%, rgba(255, 120, 100, .32) 99%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent); mask-image: linear-gradient(90deg, transparent, #000 30%, #000 70%, transparent);
    animation: hero-scan 7s cubic-bezier(.45, 0, .55, 1) 3.6s infinite; }
  @keyframes hero-scan { 0% { transform: translateY(-90px); opacity: 0; } 8% { opacity: .7; } 70% { opacity: .7; } 100% { transform: translateY(calc(100vh - 40px)); opacity: 0; } }
  :global(:root[data-motion='off']) .hero__aurora i, :global(:root[data-motion='off']) .hero__scan { animation: none; }
  .hero__brain canvas { width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero__brain.is-ready canvas { opacity: 1; }
  .hero__brain { -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%); mask-composite: intersect; }
  .hero__fallback { display: none; position: absolute; inset: 10% 5% 10% 20%; border-radius: 50%; filter: blur(30px);
    background: radial-gradient(40% 45% at 50% 50%, rgba(95, 211, 198, .35), transparent 70%), radial-gradient(30% 30% at 60% 55%, rgba(77, 255, 154, .25), transparent 70%); }
  .hero__brain:global(.no-webgl) .hero__fallback { display: block; }
  .hero__inner { position: relative; z-index: 1; width: 100%; min-width: 0; display: grid; gap: var(--s3) clamp(var(--s4), 5vw, var(--s7));
    grid-template-columns: minmax(0, .82fr) minmax(0, 1.18fr); grid-template-areas: 'brand text' 'team text'; align-items: start; }
  .hero__text { grid-area: text; max-width: 680px; min-width: 0; align-self: center; text-shadow: 0 2px 24px rgba(2, 10, 14, .7); }
  /* brand panel: the title card of the summary video */
  .hero__brand { grid-area: brand; position: relative; display: grid; justify-items: center; align-content: center; gap: 6px; padding: var(--s5) var(--s3) var(--s4);
    border-radius: 22px; overflow: hidden; isolation: isolate; text-align: center;
    background: radial-gradient(90% 80% at 50% 35%, #0b2a31, #03090c 75%); border: 1px solid rgba(95, 211, 198, .18); box-shadow: 0 30px 70px -40px #000; }
  .hero__ring { position: absolute; left: 50%; top: 42%; width: 240px; height: 240px; margin: -120px 0 0 -120px; border-radius: 50%; z-index: -1;
    background: radial-gradient(circle, rgba(77, 255, 154, .16), transparent 62%); animation: hero-breathe 6s ease-in-out infinite; }
  @keyframes hero-breathe { 50% { transform: scale(1.15); opacity: .7; } }
  .hero__brand :global(.hero__logo) { width: clamp(72px, 8vw, 104px); height: auto; filter: drop-shadow(0 0 18px rgba(95, 211, 198, .35)); }
  .hero__name { margin: var(--s1) 0 0; font-family: var(--font-serif); font-size: clamp(2.6rem, 5vw, 4.4rem); line-height: 1; color: #e8f4f2; letter-spacing: -.01em; }
  .hero__sub { margin: 0; color: #8fb3bb; font-size: .95rem; max-width: 30ch; }
  /* team strip */
  .hero__team { grid-area: team; display: grid; gap: 10px; text-decoration: none; color: inherit; }
  .hero__team ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(0, 1fr)); gap: 10px; }
  .hero__member { display: grid; justify-items: center; gap: 8px; padding: 12px 8px 10px; border-radius: 16px; text-align: center; min-width: 0;
    background: rgba(6, 22, 27, .7); border: 1px solid rgba(95, 211, 198, .16); backdrop-filter: blur(6px);
