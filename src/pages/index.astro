---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import assets from '../data/assets.json';
import CA1Layers from '../components/CA1Layers.astro';
import FunderLogo from '../components/FunderLogo.astro';
import site from '../data/site.json';
import news from '../data/news.json';
import papers from '../data/papers.json';
import { url } from '../lib/url';

const methods = [
  { href: '/research/two-photon/', title: 'Two-photon imaging', sub: 'Hippocampal CA1', color: 'var(--green)', text: 'Watching hundreds of neurons in the living hippocampus — and catching the earliest, Alzheimer’s-related hyperactivity.' },
  { href: '/research/immunohistochemistry/', title: 'Immunohistochemistry', sub: 'Plaques & cells', color: 'var(--blue)', text: 'Staining brain sections to map amyloid plaques and the cells around them.' },
  { href: '/research/electrophysiology/', title: 'Electrophysiology', sub: 'EEG · LTP · LFP', color: 'var(--red)', text: 'From seizures in the whole brain to plasticity at single synapses.' },
  ...(site.features.glymphatic ? [{ href: '/research/glymphatic/', title: 'Glymphatic system', sub: 'Brain clearance', color: 'var(--magenta)', text: 'How cerebrospinal fluid moves through brain tissue and clears waste.' }] : []),
];
const rec = assets.twoPhoton.recordings[0];
const latestNews = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 3);
const latestPapers = [...papers].sort((a, b) => b.year - a.year).slice(0, 3);
---
<Base>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute"><filter id="home-lut" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.15 0.15 0.15 0 0  0.5 0.5 0.5 0 0.02  0.25 0.25 0.25 0 0  0 0 0 1 0" /></filter></svg>
  <!-- ======== HERO: brain → hippocampus → CA1 ======== -->
  <section class="hero" data-hero aria-labelledby="hero-title">
    <canvas class="hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
    <div class="hero__fallback" aria-hidden="true"></div>
    <div class="hero__veil" aria-hidden="true"></div>

    <div class="hero__steps">
      <div class="hero__step is-current" data-step>
        <p class="eyebrow">Neuroscience research group</p>
        <h1 id="hero-title">{site.name}<span class="hero__tag">{site.tagline}.</span></h1>
        <p class="lead">Two-photon imaging, immunohistochemistry and electrophysiology — to understand how hippocampal circuits fail early in Alzheimer’s disease — and how to protect them.</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href="#ca1" data-enter-ca1>Enter CA1 ↓</a>
          <a class="btn" href={url('/research/')}>Our research</a>
        </div>
      </div>
      <div class="hero__step" data-step>
        <p class="eyebrow" style="--accent:var(--magenta)">01 — The hippocampus</p>
        <h2>A curved structure deep in the temporal lobe, essential for forming new memories.</h2>
      </div>
      <div class="hero__step" data-step>
        <p class="eyebrow">02 — Region CA1</p>
        <h2>Here, thousands of pyramidal neurons line up in a single layer — the hippocampus’ main output.</h2>
      </div>
    </div>

    <div class="hero__meta"><Label kind="schematic" text="Illustrative schematic — not anatomical data" /></div>
  </section>

  <!-- ======== CA1 layers ======== -->
  <section id="ca1" class="section" aria-labelledby="ca1-h">
    <div class="container">
      <p class="eyebrow" data-reveal>03 — Inside CA1</p>
      <h2 id="ca1-h" data-reveal>Explore the layers we image and record from</h2>
      <p class="lead" data-reveal>Select a layer to see what it contains. Our two-photon imaging focuses on the cell bodies of stratum pyramidale; dendrites in the layers above and below receive the circuit’s inputs.</p>
      <div data-reveal style="margin-top:var(--s5)"><CA1Layers /></div>

      <div class="grid grid-2" style="margin-top:var(--s6)" data-reveal>
        <figure class="figure home-2p">
          <video src={url(rec.src)} poster={url(rec.poster)} muted loop playsinline preload="metadata" data-autoplay aria-label={rec.alt}></video>
          <figcaption><Label kind="data" /> <span>In vivo two-photon imaging of CA1 pyramidal neurons ({rec.label}). Cells flash when active · 4× real time. <a href={url('/research/two-photon/')}>Explore recordings →</a></span></figcaption>
        </figure>
        <div>
          <p class="eyebrow">Mission</p>
          <p class="lead ph">{site.mission}</p>
          <p class="muted ph">{site.summary}</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ======== Methods ======== -->
  <section class="section section--tight" aria-labelledby="methods-h">
    <div class="container">
      <p class="eyebrow" data-reveal>Research</p>
      <h2 id="methods-h" data-reveal>Complementary windows on the same circuit</h2>
      <div class="grid grid-3 methods" style="margin-top:var(--s5)">
        {methods.map((m, i) => (
          <a href={url(m.href)} class="card method" style={`--card-c:${m.color}`} data-reveal>
            <span class="card__glow" aria-hidden="true"></span>
            <span class="method__num mono">0{i + 1}</span>
            <span class="method__sub">{m.sub}</span>
            <h3>{m.title}</h3>
            <p class="muted">{m.text}</p>
            <span class="method__go">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ======== News + Papers ======== -->
  <section class="section section--tight" aria-label="Latest">
    <div class="container grid grid-2" style="gap:var(--s6)">
      <div data-reveal>
        <div class="row-head"><h2>News</h2><a href={url('/news/')}>All news →</a></div>
        <ul class="list" role="list">
          {latestNews.map((n) => (
            <li>
              <time class="mono muted" datetime={n.date}>{n.date}</time>
              <a href={url(`/news/${n.slug}/`)} class:list={[{ ph: n.placeholder }]}>{n.title}</a>
            </li>
          ))}
        </ul>
      </div>
      <div data-reveal>
        <div class="row-head"><h2>Papers</h2><a href={url('/papers/')}>All papers →</a></div>
        <ul class="list" role="list">
          {latestPapers.map((p) => (
            <li>
              <span class="mono muted">{p.year} · {p.journal}</span>
              <span class:list={[{ ph: p.placeholder }]}>{p.title}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ======== Funding acknowledgment ======== -->
  <section class="section section--tight" aria-labelledby="fund-h">
    <div class="container funding-strip" data-reveal>
      <div>
        <p class="eyebrow">Support</p>
        <h2 id="fund-h" style="font-size:1.6rem">Our research is supported by the European Research Council and the Deutsche Forschungsgemeinschaft.</h2>
        <a href={url('/funding/')}>Funded projects, grant identifiers &amp; acknowledgments →</a>
      </div>
      <div class="funding-strip__logos">
        <FunderLogo funder="EU" height={48} />
        <FunderLogo funder="ERC" height={48} />
        <FunderLogo funder="DFG" height={48} />
      </div>
    </div>
  </section>

  <!-- ======== CTA ======== -->
  <section class="section section--tight" aria-labelledby="join-h">
    <div class="container join" data-reveal>
      <h2 id="join-h">Curious about the hippocampus?</h2>
      <p class="lead">We welcome enquiries from students, postdocs and collaborators.</p>
      <div class="hero__cta">
        <a class="btn btn--primary" href={url('/contact/')}>Contact &amp; open positions</a>
        <a class="btn" href={url('/teaching/')}>Thesis projects</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { position: relative; height: 100vh; min-height: 560px; overflow: hidden; display: grid; align-items: center; }
  .hero__canvas, .hero__fallback, .hero__veil { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__fallback { display: none; background:
    radial-gradient(40% 35% at 70% 45%, color-mix(in srgb, var(--magenta) 18%, transparent), transparent 70%),
    radial-gradient(25% 20% at 74% 48%, color-mix(in srgb, var(--green) 28%, transparent), transparent 70%),
    radial-gradient(60% 60% at 60% 50%, color-mix(in srgb, var(--blue) 10%, transparent), transparent 70%); }
  .hero.no-webgl .hero__canvas { display: none; }
  .hero.no-webgl .hero__fallback { display: block; }
  .hero__veil { background: linear-gradient(90deg, var(--bg) 0%, color-mix(in srgb, var(--bg) 70%, transparent) 38%, transparent 70%); pointer-events: none; }
  .hero__steps { position: relative; z-index: 2; padding: 0 clamp(var(--s3), 6vw, var(--s7)); display: grid; }
  .hero__step { grid-area: 1 / 1; max-width: 640px; transition: opacity .6s var(--ease), transform .6s var(--ease); }
  .hero.is-pinned .hero__step:not(.is-current) { opacity: 0; transform: translateY(20px); pointer-events: none; visibility: hidden; }
  /* Without pinning (reduced motion / no JS), only the intro step is shown in the hero */
  .hero:not(.is-pinned) .hero__step:not(:first-child) { display: none; }
  .hero__step h2 { font-size: clamp(1.8rem, 3.6vw, 3rem); }
  .hero__tag { display: block; font-size: .42em; color: var(--text-2); font-style: italic; margin-top: .4em; }
  .hero__cta { display: flex; gap: var(--s2); flex-wrap: wrap; margin-top: var(--s4); }
  .hero__meta { position: absolute; right: var(--s3); bottom: var(--s3); z-index: 2; }
  @media (max-width: 767px) {
    .hero { height: calc(100svh - 60px); align-items: end; padding-bottom: var(--s7); }
    .hero__veil { background: linear-gradient(0deg, var(--bg) 10%, color-mix(in srgb, var(--bg) 60%, transparent) 55%, transparent); }
    .hero__steps { padding: 0 var(--s2); }
  }

  .method { display: flex; flex-direction: column; gap: 4px; min-height: 280px; }
  .method__num { color: var(--card-c); }
  .method__sub { font-family: var(--font-mono); font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); margin-top: var(--s4); }
  .method h3 { margin: 6px 0 var(--s2); }
  .method__go { margin-top: auto; color: var(--card-c); font-size: .9rem; }

  .row-head { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid var(--line); margin-bottom: var(--s2); }
  .row-head h2 { font-size: 1.8rem; margin: 0 0 var(--s2); }
  .row-head a { font-size: .9rem; color: var(--text-2); }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { display: grid; gap: 2px; padding: var(--s2) 0; border-bottom: 1px solid var(--line); }
  .list .mono { font-size: .75rem; }

  .funding-strip { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); flex-wrap: wrap;
    padding: var(--s5); border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-2); }
  .funding-strip > div:first-child { max-width: 640px; }
  .funding-strip__logos { display: flex; gap: var(--s3); align-items: center; flex-wrap: wrap; }

  .join { text-align: center; } .join p { margin-inline: auto; } .join .hero__cta { justify-content: center; }
  .home-2p video { width: 100%; aspect-ratio: 502 / 458; border-radius: var(--radius); border: 1px solid var(--line); background: #000; filter: url(#home-lut); }
</style>

<script>
  // Three.js is loaded only on the homepage, after first paint
  if (document.querySelector('[data-hero]')) import('../scripts/hero');
  // Muted autoplay of the CA1 recording when visible (skipped with reduced motion)
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && document.documentElement.dataset.motion !== 'off') v.play().catch(() => {}); else v.pause();
    }, { threshold: 0.3 }).observe(v);
  });
</script>
