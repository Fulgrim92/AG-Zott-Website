---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import FunderLogo from '../components/FunderLogo.astro';
import assets from '../data/assets.json';
import site from '../data/site.json';
import news from '../data/news.json';
import papers from '../data/papers.json';
import { datasets } from '../scripts/signals';
import { url, themeLabel } from '../lib/url';

const rec = assets.twoPhoton.recordings[0];
const rec2 = assets.twoPhoton.recordings[1] ?? rec;
const confocal = assets.ihc.sections[assets.ihc.sections.length - 1];
const latestNews = [...news].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const selected = [...papers].filter((p) => !p.placeholder).sort((a, b) => b.year - a.year).slice(0, 5);
const pi = site.pi;

// Build-time SVG path of the illustrative LFP (min/max decimation)
const lfp = datasets.lfp().series[0];
const cols = 400, per = Math.floor(lfp.y.length / cols);
let lfpPath = '';
for (let c = 0; c < cols; c++) {
  let lo = Infinity, hi = -Infinity;
  for (let i = c * per; i < (c + 1) * per; i++) { const v = lfp.y[i]; if (v < lo) lo = v; if (v > hi) hi = v; }
  const x = ((c / cols) * 1000).toFixed(1), Y = (v: number) => (150 - v * 150).toFixed(1);
  lfpPath += `${c ? 'L' : 'M'}${x} ${Y(hi)}L${x} ${Y(lo)}`;
}

const themes = [
  { href: '/research/two-photon/', key: 'two-photon', color: 'var(--green)', text: 'In vivo calcium imaging of hundreds of CA1 neurons to detect early, β-amyloid-driven hyperactivity.', media: 'video' },
  { href: '/research/immunohistochemistry/', key: 'immunohistochemistry', color: 'var(--blue)', text: 'Staining and confocal imaging of brain sections to map amyloid plaques and the cells around them.', media: 'image' },
  { href: '/research/electrophysiology/', key: 'electrophysiology', color: 'var(--red)', text: 'EEG, synaptic plasticity (LTP) and field potentials — network function from seconds to milliseconds.', media: 'trace' },
  ...(site.features.glymphatic ? [{ href: '/research/glymphatic/', key: 'glymphatic', color: 'var(--magenta)', text: 'How cerebrospinal fluid flows through brain tissue and clears waste such as β-amyloid.', media: 'flow' }] : []),
];
const steps = [
  { label: 'Brain', caption: 'The mouse brain. Our work focuses on the hippocampus, a structure essential for forming new memories.' },
  { label: 'Hippocampus', caption: 'The hippocampus (magenta), with region CA1 highlighted in green.' },
  { label: 'CA1', caption: 'CA1 pyramidal neurons. Each flash mimics a calcium transient — a neuron firing.' },
  { label: 'Recording', caption: `A real in vivo two-photon recording of CA1 neurons (${rec.label}), shown at 4× real time.` },
];
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
---
<Base>
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <filter id="home-lut" color-interpolation-filters="sRGB"><feColorMatrix type="matrix" values="0.15 0.15 0.15 0 0  0.5 0.5 0.5 0 0.02  0.25 0.25 0.25 0 0  0 0 0 1 0" /></filter>
  </svg>

  <!-- ======== Intro ======== -->
  <section class="intro" aria-labelledby="intro-h">
    <div class="intro__text">
      <p class="eyebrow" data-intro>Research group · TUM</p>
      <h1 id="intro-h"><span class="intro__name" data-hero-name>{site.name}</span></h1>
      <p class="intro__tag" data-intro>{site.tagline}</p>
      <p class="lead" data-intro>Long before memory loss and amyloid plaques, neurons in the hippocampus become abnormally active. We combine in vivo two-photon imaging, histology and electrophysiology to understand why this happens — and whether it can be prevented or reversed.</p>
      <p class="intro__pi" data-intro>
        <span class="mono">Group leader</span>
        <a href={url('/team/')}>{pi.name}</a>
      </p>
      <div class="intro__cta" data-intro>
        <a class="btn btn--primary" href={url('/research/')}>Our research</a>
        <a class="btn" href={url('/papers/')}>Publications</a>
        <a class="btn" href={url('/contact/')}>Join the lab</a>
      </div>
      <p class="intro__fund small" data-intro>Supported by the <a href={url('/funding/')}>European Research Council (ERC)</a> and the <a href={url('/funding/')}>Deutsche Forschungsgemeinschaft (DFG)</a>.</p>
    </div>

    <figure class="viz" data-hero aria-labelledby="viz-cap">
      <div class="viz__stage">
        <canvas class="viz__canvas" data-hero-canvas aria-hidden="true"></canvas>
        <div class="viz__fallback" aria-hidden="true"></div>
        <div class="viz__real" data-hero-real>
          <video src={url(rec.src)} poster={url(rec.poster)} muted loop playsinline preload="none" aria-label={rec.alt}></video>
        </div>
        <div class="viz__label"><Label kind="schematic" text="3D model: illustrative schematic" /></div>
      </div>
      <div class="viz__bar">
        <div role="tablist" aria-label="Zoom level" class="viz__tabs">
          {steps.map((s, i) => <button role="tab" data-viz-step aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{s.label}</button>)}
        </div>
        <figcaption id="viz-cap" class="viz__cap" aria-live="polite">
          {steps.map((s, i) => <span data-viz-caption hidden={i !== 0}>{s.caption}{i === 3 && <> <Label kind="data" /></>}</span>)}
        </figcaption>
      </div>
    </figure>
  </section>

  <!-- ======== Research ======== -->
  <section class="section section--tight" aria-labelledby="research-h">
    <div class="container">
      <div class="row-head">
        <div><p class="eyebrow">Research</p><h2 id="research-h" data-split>What we study</h2></div>
        <a href={url('/research/')}>All research →</a>
      </div>
      <ul class="themes" role="list">
        {themes.map((t) => (
          <li data-reveal>
            <a class="card theme" href={url(t.href)} style={`--card-c:${t.color}`}>
              <span class="card__glow" aria-hidden="true"></span>
              <div class="theme__media">
                {t.media === 'video' && <video src={url(rec2.src)} poster={url(rec2.poster)} muted loop playsinline preload="none" data-autoplay style="filter:url(#home-lut)" aria-label={rec2.alt}></video>}
                {t.media === 'image' && <img src={url(confocal.src)} alt={confocal.alt} loading="lazy" />}
                {t.media === 'trace' && <svg viewBox="0 0 1000 300" preserveAspectRatio="none" role="img" aria-label="Illustrative local field potential trace."><path d={lfpPath} class="theme__trace" /></svg>}
                {t.media === 'flow' && (
                  <svg viewBox="0 0 400 240" role="img" aria-label="Schematic of fluid flowing along an artery, through tissue and out along a vein.">
                    <rect x="40" y="0" width="22" height="240" fill="#c0392b" opacity=".8" /><rect x="338" y="0" width="22" height="240" fill="#2c3e8f" opacity=".9" />
                    {[40, 80, 120, 160, 200].map((y) => <path d={`M70 ${y - 20} C 160 ${y + 30}, 240 ${y - 30}, 330 ${y + 10}`} class="flow-path" />)}
                  </svg>
                )}
                <span class="theme__label">
                  {t.media === 'video' && <Label kind="data" />}
                  {t.media === 'image' && <Label kind="data" text="Published data" />}
                  {t.media === 'trace' && <Label kind="schematic" text="Simulation" />}
                  {t.media === 'flow' && <Label kind="schematic" text="Schematic" />}
                </span>
              </div>
              <h3>{themeLabel[t.key]}</h3>
              <p class="muted small">{t.text}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======== News + Publications ======== -->
  <section class="section section--tight" aria-label="News and publications">
    <div class="container two-col">
      <div>
        <div class="row-head"><h2 data-split>News</h2><a href={url('/news/')}>All news →</a></div>
        <ul class="list" role="list">
          {latestNews.map((n) => (
            <li data-reveal>
              <a class="row-link" href={url(`/news/${n.slug}/`)}>
                <time class="mono muted" datetime={n.date}>{fmt(n.date)} · {n.category}</time>
                <span class:list={[{ ph: n.placeholder }]}>{n.title}</span>
                <i aria-hidden="true">→</i>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <div class="row-head"><h2 data-split>Selected publications</h2><a href={url('/papers/')}>All →</a></div>
        <ol class="pubs" role="list">
          {selected.map((p) => (
            <li data-reveal>
              <span class="pubs__year mono">{p.year}</span>
              <div>
                <a href={p.doi ? `https://doi.org/${p.doi}` : url('/papers/')} class="pubs__title">{p.title}</a>
                <span class="pubs__authors">{p.authors.replace(/Zott B/g, '§').split('§').map((part, i, arr) => <>{part}{i < arr.length - 1 && <b>Zott B</b>}</>)}</span>
                <span class="pubs__journal">{p.journal}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <!-- ======== People ======== -->
  <section class="section section--tight" aria-labelledby="people-h">
    <div class="container">
      <div class="row-head"><div><p class="eyebrow">People</p><h2 id="people-h" data-split>The group</h2></div><a href={url('/team/')}>Team →</a></div>
      <div class="people">
        <article class="pi card" data-reveal>
          <div class="pi__photo" aria-hidden="true">{pi.photo ? <img src={url(pi.photo)} alt="" /> : <><span>BZ</span><small>photo placeholder</small></>}</div>
          <div>
            <p class="mono small" style="color:var(--accent);margin:0 0 4px">{pi.role}</p>
            <h3>{pi.name}</h3>
            <p class="muted small">{pi.bio}</p>
            <a href={url('/team/')}>Profile and team →</a>
          </div>
        </article>
        <article class="join card" data-reveal>
          <p class="eyebrow">Join us</p>
          <h3>Open positions &amp; theses</h3>
          <p class="muted small">We welcome applications from motivated students (BSc, MSc, MD/PhD) and postdocs interested in hippocampal circuits, imaging and Alzheimer’s disease.</p>
          <div class="intro__cta"><a class="btn btn--primary" href={url('/contact/')}>Contact</a><a class="btn" href={url('/teaching/')}>Thesis projects</a></div>
        </article>
      </div>
    </div>
  </section>

  <!-- ======== Funding ======== -->
  <section class="section section--tight" aria-labelledby="fund-h">
    <div class="container funding-strip" data-reveal>
      <div>
        <p class="eyebrow">Funding</p>
        <h2 id="fund-h" style="font-size:1.5rem">Our research is supported by the European Research Council and the Deutsche Forschungsgemeinschaft.</h2>
        <a href={url('/funding/')}>Funded projects and acknowledgments →</a>
      </div>
      <div class="funding-strip__logos">
        <FunderLogo funder="EU" height={44} />
        <FunderLogo funder="ERC" height={44} />
        <FunderLogo funder="DFG" height={44} />
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Intro ---------- */
  .intro { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: var(--s6); align-items: center;
    padding: var(--s7) clamp(var(--s3), 6vw, var(--s7)) var(--s6); max-width: 1400px; margin: 0 auto;
    background: radial-gradient(700px 400px at 80% 30%, color-mix(in srgb, var(--green) 6%, transparent), transparent 70%); }
  .intro h1 { margin: 0; }
  .intro__name { display: inline-block; }
  .intro__tag { font-family: var(--font-serif); font-style: italic; font-size: clamp(1.25rem, 2vw, 1.6rem); color: var(--text-2); margin: var(--s1) 0 var(--s3); }
  .intro__pi { display: flex; gap: 10px; align-items: baseline; flex-wrap: wrap; margin: var(--s3) 0; }
  .intro__pi .mono { font-size: .72rem; letter-spacing: .12em; text-transform: uppercase; color: var(--text-3); }
  .intro__pi a { font-family: var(--font-serif); font-size: 1.2rem; }
  .intro__cta { display: flex; gap: var(--s1); flex-wrap: wrap; }
  .intro__fund { color: var(--text-3); margin-top: var(--s3); }
  @media (max-width: 1100px) { .intro { grid-template-columns: 1fr; padding-top: var(--s6); } }
  @media (max-width: 767px) { .intro { padding: var(--s5) var(--s2) var(--s4); gap: var(--s4); } }

  .viz { margin: 0; border: 1px solid var(--line); border-radius: calc(var(--radius) + 4px); background: #05070b; overflow: hidden; }
  .viz__stage { position: relative; aspect-ratio: 5 / 4; }
  .viz__canvas, .viz__fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .viz__canvas { transition: filter 1s var(--ease); }
  .viz__canvas.is-dim { filter: brightness(.3) blur(3px); }
  .viz__fallback { display: none; background:
    radial-gradient(40% 35% at 55% 45%, color-mix(in srgb, var(--magenta) 18%, transparent), transparent 70%),
    radial-gradient(25% 20% at 60% 48%, color-mix(in srgb, var(--green) 28%, transparent), transparent 70%); }
  :global(.no-webgl) .viz__canvas { display: none; }
  :global(.no-webgl) .viz__fallback { display: block; }
  .viz__real { position: absolute; inset: 6%; display: flex; align-items: center; justify-content: center; opacity: 0; transform: scale(.94); transition: opacity .8s var(--ease), transform 1s var(--ease); pointer-events: none; }
  .viz__real.is-on { opacity: 1; transform: none; }
  .viz__real video { height: 100%; width: auto; max-width: 100%; object-fit: contain; aspect-ratio: 502 / 458; border-radius: 10px; filter: url(#home-lut);
    box-shadow: 0 20px 60px -20px color-mix(in srgb, var(--green) 40%, transparent); border: 1px solid color-mix(in srgb, var(--green) 35%, var(--line)); }
  .viz__label { position: absolute; left: 12px; top: 12px; transition: opacity .4s; }
  .viz__real.is-on ~ .viz__label { opacity: 0; }
  .viz__bar { display: grid; gap: 10px; padding: 14px 16px 16px; border-top: 1px solid var(--line); background: var(--bg-2); }
  .viz__tabs { display: flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); justify-self: start; flex-wrap: wrap; }
  .viz__tabs button { border: 0; background: transparent; color: var(--text-2); padding: .4em 1em; border-radius: 999px; cursor: pointer; font-size: .85rem; transition: color .2s, background .2s; }
  .viz__tabs button[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
  .viz__cap { font-size: .9rem; color: var(--text-2); min-height: 2.9em; }
  .viz__cap [hidden] { display: none; }

  /* ---------- Section heads ---------- */
  .row-head { display: flex; justify-content: space-between; align-items: end; gap: var(--s2); border-bottom: 1px solid var(--line); margin-bottom: var(--s3); padding-bottom: var(--s2); }
  .row-head h2 { margin: 0; font-size: clamp(1.6rem, 2.6vw, 2.2rem); }
  .row-head .eyebrow { margin-bottom: 6px; }
  .row-head > a { font-size: .9rem; color: var(--text-2); white-space: nowrap; }

  /* ---------- Research themes ---------- */
  .themes { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s3); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 1280px) { .themes { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .themes { grid-template-columns: 1fr; } }
  .section--tight { padding-block: var(--s6); }
  .theme { display: flex; flex-direction: column; gap: 6px; height: 100%; padding: var(--s2); }
  .theme__media { position: relative; aspect-ratio: 4 / 3; border-radius: 10px; overflow: hidden; background: #000; margin-bottom: var(--s1); }
  .theme__media video, .theme__media img, .theme__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .theme__media img { object-fit: contain; }
  .theme:hover .theme__media video, .theme:hover .theme__media img { transform: scale(1.05); }
  .theme__label { position: absolute; left: 8px; bottom: 8px; background: rgba(5,7,11,.75); border-radius: 6px; }
  .theme h3 { font-size: clamp(1.05rem, 1.35vw, 1.25rem); margin: 4px 0 0; overflow-wrap: anywhere; hyphens: auto; }
  .theme p { margin: 0; }
  .theme__trace { fill: none; stroke: var(--red); stroke-width: 1.3; vector-effect: non-scaling-stroke; }
  .flow-path { fill: none; stroke: var(--blue); stroke-width: 2; stroke-dasharray: 3 12; opacity: .8; animation: flow 2.4s linear infinite; }
  .flow-path:nth-child(even) { stroke: var(--magenta); animation-duration: 3.1s; }
  @keyframes flow { to { stroke-dashoffset: -60; } }

  /* ---------- News / publications ---------- */
  .two-col { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr); gap: var(--s6); }
  @media (max-width: 960px) { .two-col { grid-template-columns: 1fr; } }
  .list { list-style: none; padding: 0; margin: 0; }
  .list li { border-bottom: 1px solid var(--line); }
  .row-link { display: grid; grid-template-columns: 1fr auto; gap: 2px var(--s2); padding: var(--s2) var(--s1); text-decoration: none; border-radius: 8px; transition: background .3s, padding .4s var(--ease); background: none !important; }
  .row-link .mono { font-size: .75rem; }
  .row-link i { grid-column: 2; grid-row: 1 / span 2; align-self: center; font-style: normal; color: var(--accent); opacity: 0; transform: translateX(-8px); transition: all .35s var(--ease); }
  .row-link:hover { background: color-mix(in srgb, var(--accent) 6%, transparent) !important; padding-left: var(--s2); color: inherit; }
  .row-link:hover i { opacity: 1; transform: none; }
  .pubs { list-style: none; padding: 0; margin: 0; }
  .pubs li { display: grid; grid-template-columns: 52px 1fr; gap: var(--s2); padding: var(--s2) 0; border-bottom: 1px solid var(--line); }
  .pubs__year { color: var(--accent); font-size: .85rem; padding-top: 3px; }
  .pubs li > div { display: grid; gap: 3px; min-width: 0; }
  .pubs__title { font-family: var(--font-serif); font-size: 1.08rem; line-height: 1.35; text-decoration: none; background: none !important; }
  .pubs__title:hover { color: var(--accent); }
  .pubs__authors { font-size: .85rem; color: var(--text-2); }
  .pubs__authors b { color: var(--text); font-weight: 600; }
  .pubs__journal { font-size: .85rem; font-style: italic; color: var(--text-3); }

  /* ---------- People ---------- */
  .people { display: grid; grid-template-columns: minmax(0, 1.6fr) minmax(0, 1fr); gap: var(--s3); }
  @media (max-width: 960px) { .people { grid-template-columns: 1fr; } }
  .pi { display: grid; grid-template-columns: 150px 1fr; gap: var(--s3); align-items: start; }
  @media (max-width: 560px) { .pi { grid-template-columns: 1fr; } }
  .pi h3 { margin-bottom: var(--s1); }
  .pi__photo { aspect-ratio: 4 / 5; border-radius: 10px; display: grid; place-content: center; text-align: center; border: 1px dashed color-mix(in srgb, var(--amber) 50%, transparent); overflow: hidden; }
  .pi__photo img { width: 100%; height: 100%; object-fit: cover; }
  .pi__photo span { font-family: var(--font-serif); font-size: 2.4rem; color: var(--text-3); }
  .pi__photo small { font-size: .6rem; color: var(--amber); text-transform: uppercase; letter-spacing: .1em; }
  .join h3 { margin-bottom: var(--s1); }

  .funding-strip { display: flex; justify-content: space-between; align-items: center; gap: var(--s4); flex-wrap: wrap;
    padding: var(--s4); border: 1px solid var(--line); border-radius: var(--radius); background: var(--bg-2); }
  .funding-strip > div:first-child { max-width: 640px; }
  .funding-strip__logos { display: flex; gap: var(--s3); align-items: center; flex-wrap: wrap; }
</style>

<script>
  import { gsap } from 'gsap';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(SplitText);
  const motionOK = () => document.documentElement.dataset.motion !== 'off';

  // Three.js figure is loaded only on the homepage, after first paint
  if (document.querySelector('[data-hero]')) import('../scripts/hero');

  // Intro: the lab name rises letter by letter, then the supporting text
  if (motionOK()) {
    const name = document.querySelector<HTMLElement>('[data-hero-name]');
    const tl = gsap.timeline({ delay: 0.1 });
    if (name) {
      const split = SplitText.create(name, { type: 'chars', mask: 'chars', aria: 'auto' });
      tl.from(split.chars, { yPercent: 120, duration: 1.2, ease: 'expo.out', stagger: 0.05 });
    }
    tl.from('[data-intro]', { y: 18, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 }, 0.25);
  }

  // Muted autoplay of preview videos when visible (skipped with reduced motion)
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && motionOK()) v.play().catch(() => {}); else v.pause();
    }, { threshold: 0.3 }).observe(v);
  });
</script>
