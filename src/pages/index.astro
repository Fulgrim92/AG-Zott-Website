---
import Base from '../layouts/Base.astro';
import Label from '../components/Label.astro';
import Icon from '../components/Icon.astro';
import FunderLogo from '../components/FunderLogo.astro';
import NeuralBackdrop from '../components/NeuralBackdrop.astro';
import TeamCarousel from '../components/TeamCarousel.astro';
import GraphicalAbstract from '../components/GraphicalAbstract.astro';
import DataPipeline from '../components/DataPipeline.astro';
import home from '../data/home.json';
import assets from '../data/assets.json';
import site from '../data/site.json';
import news from '../data/news.json';
import papers from '../data/papers.json';
import { datasets } from '../scripts/signals';
import { url } from '../lib/url';

// *word* → highlighted
const hl = (s: string) => s.replace(/\*(.+?)\*/g, '<span class="hl">$1</span>');
const H = home.hero;
const latestPaperNews = [...news].filter((n) => n.category === 'Paper' && !n.placeholder).sort((a, b) => b.date.localeCompare(a.date))[0];
const rec2 = assets.twoPhoton.recordings[1] ?? assets.twoPhoton.recordings[0];
const confocal = assets.ihc.sections[assets.ihc.sections.length - 1];

// Latest findings: newest papers that carry a plain-language summary
const findings = [...papers].filter((p: any) => !p.placeholder && p.summary).sort((a, b) => b.year - a.year).slice(0, 3);
const newsByDoi = Object.fromEntries(news.filter((n) => n.link?.includes('doi.org')).map((n) => [n.link!.split('doi.org/')[1], n.date]));
const fmtMonth = (d?: string, y?: number) => (d ? new Date(d).toLocaleDateString('en-GB', { month: 'short', year: 'numeric' }) : String(y));
const shortJournal = (j: string, s?: string) => s || j.replace(/\s*\(.*?\)/, '').replace(/\s[\d(].*$/, '');
const authorsShort = (a: string) => { const l = a.split(', '); return l.length > 3 ? `${l.slice(0, 3).join(', ')} … ${l[l.length - 1]}` : a; };

// Build-time SVG of the illustrative LFP (min/max decimation)
const lfp = datasets.lfp().series[0];
const cols = 300, per = Math.floor(lfp.y.length / cols);
let lfpPath = '';
for (let c = 0; c < cols; c++) {
  let lo = Infinity, hi = -Infinity;
  for (let i = c * per; i < (c + 1) * per; i++) { const v = lfp.y[i]; if (v < lo) lo = v; if (v > hi) hi = v; }
  const x = ((c / cols) * 1000).toFixed(1), Y = (v: number) => (150 - v * 130).toFixed(1);
  lfpPath += `${c ? 'L' : 'M'}${x} ${Y(hi)}L${x} ${Y(lo)}`;
}
const methods = [
  { href: '/research/two-photon/', title: 'Two-photon imaging', text: 'In vivo calcium imaging of hundreds of CA1 neurons to detect early, β-amyloid-driven hyperactivity.', media: 'video', label: 'data' },
  { href: '/research/immunohistochemistry/', title: 'Immunohistochemistry', text: 'Staining and confocal imaging of brain sections to map amyloid plaques and the cells around them.', media: 'image', label: 'published' },
  { href: '/research/electrophysiology/', title: 'Electrophysiology', text: 'EEG, synaptic plasticity (LTP) and field potentials — network function from hours to milliseconds.', media: 'trace', label: 'schematic' },
];
// Cover motif per theme for publication cards (decorative, not data)
const motif = (p: any) => p.themes.includes('immunohistochemistry') ? 'ihc' : p.themes.includes('electrophysiology') ? 'ephys' : 'cells';
---
<Base>
  <!-- ======================= Hero ======================= -->
  <section class="hero theme-dark" aria-labelledby="hero-h">
    <NeuralBackdrop density={0.9} opacity={0.8} />
    <div class="hero__brain" data-hero-brain data-atlas={url('/assets/atlas/')}>
      <canvas aria-hidden="true"></canvas>
      <div class="hero__fallback" aria-hidden="true"></div>
    </div>
    <div class="hero__inner container container--wide">
      <div class="hero__text">
        {latestPaperNews && (
          <a class="hero__news" href={url(`/news/${latestPaperNews.slug}/`)} data-intro>
            <span class="hero__new">New</span><span class="hero__newst">{latestPaperNews.title}</span><span aria-hidden="true">→</span>
          </a>
        )}
        <p class="eyebrow" data-intro>{H.eyebrow}</p>
        <h1 id="hero-h" data-hero-title set:html={hl(H.title)} />
        <p class="lead" data-intro>{H.lead}</p>
        <div class="hero__cta" data-intro>
          <a class="btn btn--primary" href={url(H.primary.href)} data-magnetic>{H.primary.label} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={url(H.secondary.href)}>{H.secondary.label}</a>
        </div>
      </div>
    </div>
    <p class="hero__cap small" data-intro>{H.caption} <a href="https://atlas.brain-map.org/" rel="noopener">Allen Institute</a></p>
    <a class="hero__scroll" href="#about" aria-label="Scroll to content"><span></span></a>
  </section>

  <!-- ======================= What we do ======================= -->
  <section class="section section--tight about" id="about" aria-labelledby="about-h">
    <div class="container container--wide about__grid">
      <div>
        <p class="eyebrow">{home.about.eyebrow}</p>
        <h2 id="about-h" data-split>{home.about.title}</h2>
        <p class="muted" data-reveal>{home.about.text}</p>
      </div>
      <ul class="about__cards" role="list">
        {home.about.cards.map((c) => (
          <li class="card about__card" data-reveal>
            <span class="about__icon"><Icon name={c.icon} size={52} /></span>
            <h3>{c.title}</h3>
            <p class="muted small">{c.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Approach ======================= -->
  <section class="section section--tight approach" aria-labelledby="approach-h">
    <div class="container container--wide approach__grid">
      <div class="approach__intro">
        <p class="eyebrow">{home.approach.eyebrow}</p>
        <h2 id="approach-h" data-split>{home.approach.title}</h2>
        <p class="muted" data-reveal>{home.approach.text}</p>
        <a class="btn" href={url(home.approach.link.href)} data-reveal>{home.approach.link.label} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <ul class="methods" role="list">
        {methods.map((m) => (
          <li data-reveal>
            <a class="method" href={url(m.href)}>
              <div class="method__media theme-dark">
                {m.media === 'video' && <video src={url(rec2.src)} poster={url(rec2.poster)} muted loop playsinline preload="none" data-autoplay aria-label={rec2.alt}></video>}
                {m.media === 'image' && <img src={url(confocal.src)} alt={confocal.alt} loading="lazy" />}
                {m.media === 'trace' && <svg viewBox="0 0 1000 300" preserveAspectRatio="none" role="img" aria-label="Illustrative local field potential trace."><path d={lfpPath} class="method__trace" /></svg>}
                <span class="method__label">
                  {m.label === 'data' && <Label kind="data" />}
                  {m.label === 'published' && <Label kind="data" text="Published data" />}
                  {m.label === 'schematic' && <Label kind="schematic" text="Simulation" />}
                </span>
              </div>
              <h3>{m.title}</h3>
              <p class="muted small">{m.text}</p>
              <span class="link-arrow small">Learn more</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Team ======================= -->
  <section class="section section--tight team" aria-labelledby="team-h">
    <div class="container container--wide team__grid">
      <div>
        <p class="eyebrow">{home.team.eyebrow}</p>
        <h2 id="team-h" data-split>{home.team.title}</h2>
        <p class="muted" data-reveal>{home.team.text}</p>
        <a class="btn" href={url(home.team.link.href)} data-reveal>{home.team.link.label} <span class="arr" aria-hidden="true">→</span></a>
      </div>
      <TeamCarousel />
    </div>
  </section>

  <!-- ======================= Findings ======================= -->
  <section class="section section--tight findings" aria-labelledby="find-h">
    <div class="container container--wide">
      <div class="sec-head">
        <div><p class="eyebrow">{home.findings.eyebrow}</p><h2 id="find-h" data-split>{home.findings.title}</h2></div>
        <a class="link-arrow" href={url(home.findings.link.href)}>{home.findings.link.label}</a>
      </div>
      <ul class="pubs" role="list">
        {findings.map((p: any, i) => (
          <li data-reveal>
            <a class="pub" href={p.doi ? `https://doi.org/${p.doi}` : url('/papers/')} rel="noopener">
              <div class={`pub__cover pub__cover--${motif(p)}`} aria-hidden="true">
                <svg viewBox="0 0 200 200" data-cover={motif(p)}>
                  {motif(p) === 'cells' && Array.from({ length: 22 }, (_, k) => {
                    const a = k * 2.4, r = 18 + (k * 37) % 70;
                    return <circle cx={100 + Math.cos(a) * r} cy={100 + Math.sin(a) * r} r={6 + (k % 4) * 2} class={k % 5 === 0 ? 'on' : ''} style={`--d:${(k % 7) * 0.4}s`} />;
                  })}
                  {motif(p) === 'ihc' && Array.from({ length: 30 }, (_, k) => <circle cx={(k * 53) % 200} cy={(k * 89) % 200} r={2 + (k % 5)} class={k % 3 ? '' : 'on'} style={`--d:${(k % 6) * 0.5}s`} />)}
                  {motif(p) === 'ephys' && <path d="M0 100 L30 100 L36 60 L42 140 L48 100 L90 100 L96 50 L102 150 L108 100 L200 100" class="ln" />}
                </svg>
                <span class="pub__journal">{shortJournal(p.journal, p.journalShort)}</span>
              </div>
              <div class="pub__body">
                <p class="pub__meta"><span>{fmtMonth(newsByDoi[p.doi], p.year)}</span><span>{shortJournal(p.journal, p.journalShort)}</span></p>
                <h3>{p.title}</h3>
                <p class="pub__sum small muted">{p.summary}</p>
                <p class="pub__auth small" set:html={authorsShort(p.authors).replace(/Zott B/g, '<b>Zott B</b>')} />
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ======================= Deep dive ======================= -->
  <div class="deep theme-dark" id="methods">
    <header class="deep__intro section" aria-labelledby="deep-h">
      <NeuralBackdrop density={1.2} opacity={0.7} />
      <div class="container deep__head">
        <p class="eyebrow">{home.deep.eyebrow}</p>
        <h2 id="deep-h" data-split set:html={hl(home.deep.title)} />
        <p class="lead" data-reveal>{home.deep.lead}</p>
        <ol class="deep__parts" role="list" data-reveal>
          {home.deep.parts.map((p, i) => <li><span class="mono">0{i + 1}</span>{p}</li>)}
        </ol>
      </div>
    </header>

    <div class="deep__part container container--wide"><p class="deep__partlbl"><span class="mono">01</span> {home.deep.parts[0]}</p></div>
    <GraphicalAbstract />
    <div class="deep__part container container--wide"><p class="deep__partlbl"><span class="mono">02</span> {home.deep.parts[1]}</p></div>
    <DataPipeline />
  </div>

  <!-- ======================= Join + funding ======================= -->
  <section class="section section--tight join" aria-labelledby="join-h">
    <div class="container container--wide join__grid">
      <div class="join__card" data-reveal>
        <h2 id="join-h">{home.join.title}</h2>
        <p class="muted">{home.join.text}</p>
        <div class="hero__cta">
          <a class="btn btn--primary" href={url(home.join.primary.href)} data-magnetic>{home.join.primary.label} <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn" href={url(home.join.secondary.href)}>{home.join.secondary.label}</a>
        </div>
      </div>
      <a class="fund" href={url('/funding/')} data-reveal>
        <p class="eyebrow">Funding</p>
        <p class="fund__text">Our research is supported by the European Research Council and the Deutsche Forschungsgemeinschaft.</p>
        <div class="fund__logos"><FunderLogo funder="EU" height={40} /><FunderLogo funder="ERC" height={40} /><FunderLogo funder="DFG" height={40} /></div>
      </a>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero { position: relative; min-height: min(100svh, 920px); display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; overflow: hidden; padding: calc(var(--header-h) + var(--s6)) clamp(var(--s2), 5vw, var(--s6)) var(--s7);
    background: radial-gradient(900px 600px at 78% 45%, #0f3346 0%, transparent 70%), linear-gradient(180deg, #06141b, #081c25 60%, #071820); }
  .hero__brain { position: absolute; inset: 0 -4% 0 40%; }
  .hero__brain canvas { width: 100%; height: 100%; opacity: 0; transition: opacity 1.6s var(--ease); }
  .hero__brain.is-ready canvas { opacity: 1; }
  .hero__brain { -webkit-mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%); -webkit-mask-composite: source-in; mask-image: linear-gradient(90deg, transparent, #000 22%), linear-gradient(0deg, transparent, #000 18%); mask-composite: intersect; }
  .hero__fallback { display: none; position: absolute; inset: 10% 5% 10% 20%; border-radius: 50%; filter: blur(30px);
    background: radial-gradient(40% 45% at 50% 50%, rgba(95, 211, 198, .35), transparent 70%), radial-gradient(30% 30% at 60% 55%, rgba(77, 255, 154, .25), transparent 70%); }
  .hero__brain:global(.no-webgl) .hero__fallback { display: block; }
  .hero__inner { position: relative; z-index: 1; width: 100%; min-width: 0; }
  .hero__text { max-width: 680px; min-width: 0; }
  .hero h1 { overflow-wrap: break-word; hyphens: auto; }
  .hero h1 { font-size: clamp(2.4rem, 4.4vw, 4rem); line-height: 1.04; margin-bottom: var(--s3); }
  .hero h1 :global(.hl) { font-style: normal; color: var(--glow); }
  .hero .lead { max-width: 54ch; color: #c2d3d8; }
  .hero__cta { display: flex; gap: var(--s1) var(--s2); flex-wrap: wrap; margin-top: var(--s4); }
  .hero__news { display: inline-flex; align-items: center; gap: 10px; max-width: 100%; padding: 5px 14px 5px 5px; margin-bottom: var(--s4); border: 1px solid var(--line-2); border-radius: 999px;
    background: rgba(14, 39, 51, .6); backdrop-filter: blur(6px); text-decoration: none; font-size: .84rem; color: var(--text-2); transition: border-color .3s, color .3s; }
  .hero__news:hover { border-color: var(--glow); color: var(--text); }
  .hero__newst { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; min-width: 0; }
  .hero__new { flex: none; font: 600 .64rem var(--font-sans); letter-spacing: .12em; text-transform: uppercase; background: var(--glow); color: #04201c; border-radius: 999px; padding: 3px 9px; }
  .hero__cap { position: absolute; right: clamp(var(--s2), 4vw, var(--s5)); bottom: var(--s3); margin: 0; max-width: 34ch; text-align: right; color: var(--text-3); font-size: .74rem; z-index: 1; }
  .hero__cap a { color: inherit; }
  .hero__scroll { position: absolute; left: 50%; bottom: var(--s3); width: 26px; height: 42px; margin-left: -13px; border: 1.5px solid var(--line-2); border-radius: 14px; z-index: 1; }
  .hero__scroll span { position: absolute; left: 50%; top: 8px; width: 3px; height: 8px; margin-left: -1.5px; border-radius: 2px; background: var(--glow); animation: wheel 2.2s var(--ease) infinite; }
  @keyframes wheel { 0% { opacity: 0; transform: translateY(-4px); } 30% { opacity: 1; } 100% { opacity: 0; transform: translateY(14px); } }
  @media (max-width: 900px) {
    .hero { align-items: end; min-height: 100svh; }
    .hero__brain { inset: var(--header-h) -20% 40% -20%; }
    .hero__brain { -webkit-mask-image: linear-gradient(0deg, transparent 5%, #000 50%); mask-image: linear-gradient(0deg, transparent 5%, #000 50%); }
    .hero__cap, .hero__scroll { display: none; }
  }

  /* ---------- What we do ---------- */
  .about { background: var(--surface); }
  .about__grid { display: grid; grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.6fr); gap: var(--s6); align-items: center; }
  .about__cards { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  .about__card { text-align: center; padding: var(--s4) var(--s3); background: var(--surface-2); box-shadow: none; transition: transform .4s var(--ease), box-shadow .4s var(--ease), background .4s; }
  .about__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); background: var(--surface); }
  .about__icon { display: inline-grid; place-items: center; width: 84px; height: 84px; border-radius: 50%; margin-bottom: var(--s2);
    background: radial-gradient(circle, var(--primary-soft) 0 60%, transparent 61%); }
  .about__card h3 { font-family: var(--font-sans); font-weight: 600; font-size: 1.04rem; letter-spacing: 0; margin-bottom: 6px; }
  .about__card p { margin: 0 auto; }
  @media (max-width: 1100px) { .about__grid { grid-template-columns: 1fr; gap: var(--s4); } }
  @media (max-width: 720px) { .about__cards { grid-template-columns: 1fr; } .about__card { display: grid; grid-template-columns: 64px 1fr; text-align: left; gap: 0 var(--s2); align-items: center; padding: var(--s3); }
    .about__icon { width: 64px; height: 64px; margin: 0; grid-row: span 2; } .about__icon :global(svg) { width: 40px; height: 40px; } .about__card p { margin: 0; } }

  /* ---------- Approach ---------- */
  .approach { background: var(--bg); }
  .approach__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: var(--s6); align-items: center; }
  @media (max-width: 1100px) { .approach__grid { grid-template-columns: 1fr; gap: var(--s4); } }
  .methods { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  @media (max-width: 860px) { .methods { grid-template-columns: 1fr; } }
  .method { display: grid; gap: 6px; text-decoration: none; color: var(--text); }
  .method:hover { color: var(--text); }
  .method__media { position: relative; aspect-ratio: 4 / 3; border-radius: 12px; overflow: hidden; margin-bottom: var(--s1); box-shadow: var(--shadow-sm); transition: box-shadow .4s var(--ease), transform .4s var(--ease); }
  .method:hover .method__media { box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .method__media video, .method__media img, .method__media svg { width: 100%; height: 100%; object-fit: cover; transition: transform 1.2s var(--ease); }
  .method:hover .method__media video, .method:hover .method__media img { transform: scale(1.06); }
  .method__media img { object-fit: contain; background: #000; }
  .method__trace { fill: none; stroke: var(--red); stroke-width: 1.2; vector-effect: non-scaling-stroke; }
  .method__label { position: absolute; left: 8px; bottom: 8px; }
  .method h3 { font-family: var(--font-sans); font-weight: 600; font-size: 1.04rem; margin: 0; letter-spacing: 0; }
  .method p { margin: 0; }
  .method .link-arrow { margin-top: 4px; }

  /* ---------- Team ---------- */
  .team { background: var(--surface); }
  .team__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 2fr); gap: var(--s6); align-items: center; }
  @media (max-width: 1100px) { .team__grid { grid-template-columns: 1fr; gap: var(--s4); } }

  /* ---------- Findings ---------- */
  .findings { background: var(--bg); }
  .pubs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s3); }
  @media (max-width: 1000px) { .pubs { grid-template-columns: 1fr; } }
  .pub { display: grid; grid-template-columns: 132px minmax(0, 1fr); gap: var(--s2); height: 100%; padding: var(--s2); border-radius: var(--radius); background: var(--surface); border: 1px solid var(--line);
    text-decoration: none; color: var(--text); box-shadow: var(--shadow-sm); transition: transform .4s var(--ease), box-shadow .4s var(--ease), border-color .3s; }
  .pub:hover { transform: translateY(-3px); box-shadow: var(--shadow-md); color: var(--text); border-color: var(--line-2); }
  .pub__cover { position: relative; border-radius: 10px; overflow: hidden; aspect-ratio: 1; align-self: start; background: radial-gradient(circle at 40% 35%, #12384a, #061218); }
  .pub__cover svg { width: 100%; height: 100%; }
  .pub__cover circle { fill: #5fd3c6; opacity: .22; }
  .pub__cover circle.on { fill: #4dff9a; opacity: .2; animation: blink 3.2s ease-in-out var(--d) infinite; }
  .pub__cover--ihc circle { fill: #8f9bff; } .pub__cover--ihc circle.on { fill: #3fd8ff; }
  .pub__cover .ln { fill: none; stroke: #ff6b4a; stroke-width: 2; }
  @keyframes blink { 0%, 60%, 100% { opacity: .2; } 70% { opacity: .95; } }
  .pub__journal { position: absolute; left: 8px; bottom: 7px; right: 8px; font: 600 .6rem var(--font-sans); letter-spacing: .12em; text-transform: uppercase; color: #cfe3e6; }
  .pub__meta { display: flex; gap: 10px; margin: 0 0 6px; font-size: .68rem; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; color: var(--primary); }
  .pub__meta span + span { color: var(--text-3); }
  .pub h3 { font-size: 1.08rem; line-height: 1.3; margin: 0 0 8px; }
  .pub__sum { margin-bottom: 8px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
  .pub__auth { color: var(--text-3); margin: 0; font-size: .78rem; }
  .pub__auth :global(b) { color: var(--text-2); font-weight: 600; }
  @media (max-width: 480px) { .pub { grid-template-columns: 1fr; } .pub__cover { aspect-ratio: 3 / 1; } }

  /* ---------- Deep dive ---------- */
  .deep { position: relative; background: linear-gradient(180deg, #071820, #061218 40%, #071820); }
  .deep__intro { position: relative; overflow: hidden; text-align: center; padding-bottom: var(--s6);
    background: radial-gradient(800px 420px at 50% 100%, rgba(95, 211, 198, .1), transparent 70%); }
  .deep__intro::before { content: ''; position: absolute; inset: 0 0 auto; height: 140px; background: linear-gradient(180deg, var(--bg-light, #f7f9fa), transparent); opacity: .06; pointer-events: none; }
  .deep__head { display: grid; justify-items: center; }
  .deep__head h2 { font-size: clamp(2.6rem, 6vw, 5rem); max-width: none; }
  .deep__head h2 :global(.hl) { color: var(--glow); }
  .deep__head .lead { margin-inline: auto; max-width: 60ch; }
  .deep__parts { list-style: none; display: flex; gap: var(--s2); flex-wrap: wrap; justify-content: center; padding: 0; margin: var(--s3) 0 0; }
  .deep__parts li { display: inline-flex; gap: 10px; align-items: center; padding: 8px 16px; border: 1px solid var(--line-2); border-radius: 999px; font-size: .9rem; color: var(--text-2); }
  .deep__parts .mono { color: var(--glow); }
  .deep__part { padding: var(--s5) clamp(var(--s2), 4vw, var(--s6)) 0; }
  .deep__partlbl { display: flex; align-items: center; gap: 12px; margin: 0; font-size: .78rem; font-weight: 600; letter-spacing: .16em; text-transform: uppercase; color: var(--text-3); }
  .deep__partlbl .mono { color: var(--glow); }
  .deep__partlbl::after { content: ''; flex: 1; height: 1px; background: var(--line); }

  /* ---------- Join ---------- */
  .join { background: var(--bg); }
  .join__grid { display: grid; grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--s3); }
  @media (max-width: 960px) { .join__grid { grid-template-columns: 1fr; } }
  .join__card { padding: var(--s5); border-radius: 20px; color: #fff; background: radial-gradient(600px 300px at 90% 0%, rgba(95, 211, 198, .35), transparent 70%), linear-gradient(135deg, #13595f, #0b3a40); }
  .join__card h2 { font-size: clamp(1.7rem, 2.8vw, 2.4rem); }
  .join__card .muted { color: #cfe6e6; }
  .join__card .btn { background: transparent; border-color: rgba(255, 255, 255, .55); color: #fff; }
  .join__card .btn--primary { background: #fff; color: #0b3a40; border-color: #fff; }
  .join__card .btn:hover { border-color: #fff; color: #fff; background: rgba(255, 255, 255, .1); }
  .join__card .btn--primary:hover { background: #e6f4f3; color: #0b3a40; }
  .fund { display: grid; align-content: center; gap: 6px; padding: var(--s4); border-radius: 20px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; color: var(--text); box-shadow: var(--shadow-sm); transition: box-shadow .4s, transform .4s var(--ease); }
  .fund:hover { color: var(--text); box-shadow: var(--shadow-md); transform: translateY(-3px); }
  .fund__text { font-family: var(--font-serif); font-size: 1.25rem; line-height: 1.35; }
  .fund__logos { display: flex; gap: var(--s2); flex-wrap: wrap; align-items: center; }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  import { SplitText } from 'gsap/SplitText';
  gsap.registerPlugin(ScrollTrigger, SplitText);
  const motionOK = () => document.documentElement.dataset.motion !== 'off';

  // Three.js brain after first paint
  const brain = document.querySelector<HTMLElement>('[data-hero-brain]');
  if (brain) {
    const go = () => import('../scripts/heroBrain').then((m) => m.initHeroBrain(brain)).catch(() => brain.classList.add('no-webgl'));
    'requestIdleCallback' in window ? (window as any).requestIdleCallback(go, { timeout: 900 }) : setTimeout(go, 300);
  }
  // Deep-dive modules load when the visitor gets close
  const lazy = (sel: string, load: (el: HTMLElement) => void) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    const io = new IntersectionObserver(([e]) => { if (e.isIntersecting) { io.disconnect(); load(el); } }, { rootMargin: '150% 0px' });
    io.observe(el);
  };
  lazy('[data-ga]', (el) => import('../scripts/abstract').then((m) => { m.initAbstract(el); ScrollTrigger.refresh(); }));
  lazy('[data-dp]', (el) => import('../scripts/pipeline').then((m) => m.initPipeline(el)));
  // Deep links (#methods) work after the lazy modules add their pin spacing
  if (location.hash === '#methods') setTimeout(() => document.getElementById('methods')?.scrollIntoView(), 600);

  // Hero entrance
  if (motionOK()) {
    const title = document.querySelector<HTMLElement>('[data-hero-title]');
    const tl = gsap.timeline({ delay: 0.15 });
    if (title) {
      const split = SplitText.create(title, { type: 'words,lines', mask: 'lines', aria: 'auto' });
      tl.from(split.words, { yPercent: 110, duration: 1.1, ease: 'expo.out', stagger: 0.045 });
    }
    tl.from('[data-intro]', { y: 18, opacity: 0, duration: 0.9, ease: 'power3.out', stagger: 0.08 }, 0.3);
    // Hero text drifts up and fades as the page scrolls on
    gsap.to('.hero__text', { yPercent: -12, opacity: 0.2, ease: 'none', scrollTrigger: { trigger: '.hero', start: 'top top', end: 'bottom top', scrub: true } });
  }

  // Muted autoplay of preview videos when visible
  document.querySelectorAll<HTMLVideoElement>('video[data-autoplay]').forEach((v) => {
    new IntersectionObserver(([e]) => { if (e.isIntersecting && motionOK()) v.play().catch(() => {}); else v.pause(); }, { threshold: 0.3 }).observe(v);
  });
</script>
