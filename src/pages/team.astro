---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import team from '../data/team.json';
import site from '../data/site.json';
import papers from '../data/papers.json';
import { url } from '../lib/url';
const pi = team.find((m) => m.role === 'PI') ?? team[0];
const members = team.filter((m) => m !== pi);
const roles = [...new Set(members.map((m) => m.role))];
const piPapers = papers.filter((p) => !p.placeholder && p.authors.includes('Zott B')).sort((a, b) => b.year - a.year);
const initials = (n: string) => n.replace(/\[.*?\]/g, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('');
---
<Base title="Team">
  <PageHeader eyebrow="Team" title="The people behind the data" lead="Scientists, students and staff working together on hippocampal circuits." />
  <section class="section section--tight" aria-labelledby="pi-h">
    <div class="container pi">
      <div class="pi__photo" data-wipe>{pi.photo ? <img src={url(pi.photo)} alt={`Portrait of ${pi.name}`} /> : <div class="avatar" aria-hidden="true"><span>{initials(pi.name)}</span><small>photo placeholder</small></div>}</div>
      <div>
        <p class="mono small role">{pi.position}</p>
        <h2 id="pi-h" data-split>{pi.name}</h2>
        <p class="ph small">{pi.title} · {site.department}</p>
        <p class="lead">{pi.bio}</p>
        <p class="small ph">{pi.bioNote}</p>
        <ul class="chips" role="list">
          {pi.focus.map((c) => <li class="tag">{c}</li>)}
        </ul>
        <p class="links">
          <a href={url('/contact/')}>Contact</a>
          {Object.entries(pi.links).map(([k, v]) => <a href={v as string} rel="noopener">{k} ↗</a>)}
          <span class="ph small">ORCID · Google Scholar — to add</span>
        </p>
        {piPapers.length > 0 && (
          <>
            <h3 class="small-h">Selected publications</h3>
            <ul class="pi__pubs">{piPapers.map((p) => <li><a href={p.doi ? `https://doi.org/${p.doi}` : url('/papers/')}>{p.title}</a> <span class="muted">· {p.journal.split(/\s\d/)[0]}, {p.year}</span></li>)}</ul>
          </>
        )}
      </div>
    </div>
  </section>
  <section class="section section--tight">
    <div class="container">
      <h2 class="small-h" style="margin-bottom:var(--s3)">Group members</h2>
      <div class="filters" role="group" aria-label="Filter by role">
        <button class="btn btn--sm" aria-pressed="true" data-role="all">All</button>
        {roles.map((r) => <button class="btn btn--sm" aria-pressed="false" data-role={r}>{r}</button>)}
      </div>
      <ul class="people" role="list">
        {members.map((m) => (
          <li data-person data-role={m.role} data-reveal>
            <article class="person card">
              {m.photo
                ? <img src={url(m.photo)} alt={`Portrait of ${m.name}`} loading="lazy" width="320" height="320" />
                : <div class="avatar" aria-hidden="true"><span>{initials(m.name) || '—'}</span><small>photo placeholder</small></div>}
              <p class="mono small role">{m.position}</p>
              <h2 class:list={[{ ph: m.placeholder }]}>{m.name.replace('[PLACEHOLDER] ', '')}</h2>
              <p class:list={['muted small', { ph: m.placeholder }]}>{m.focus.join(' · ')}</p>
              <p class="links small">
                {m.email && <a href={`mailto:${m.email}`}>Email</a>}
                {m.orcid && <a href={m.orcid}>ORCID</a>}
              </p>
            </article>
          </li>
        ))}
      </ul>
      <p class="muted small" style="margin-top:var(--s5)">Former members are listed under <a href={url('/alumni/')}>Alumni</a>. Interested in joining? See <a href={url('/contact/')}>open positions</a>.</p>
    </div>
  </section>
</Base>
<style>
  .pi { display: grid; grid-template-columns: minmax(0, 300px) minmax(0, 1fr); gap: var(--s6); align-items: start; }
  @media (max-width: 860px) { .pi { grid-template-columns: 1fr; } .pi__photo { max-width: 280px; } }
  .pi__photo img, .pi__photo .avatar { width: 100%; aspect-ratio: 4 / 5; border-radius: var(--radius); object-fit: cover; margin: 0; }
  .pi .lead { max-width: 62ch; }
  .chips { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; padding: 0; margin: var(--s3) 0; }
  .pi .links { display: flex; gap: var(--s3); flex-wrap: wrap; align-items: baseline; }
  .small-h { font-family: var(--font-mono); font-size: .75rem; letter-spacing: .14em; text-transform: uppercase; color: var(--text-3); margin-top: var(--s4); }
  .pi__pubs { padding-left: 1.1em; display: grid; gap: 6px; font-size: .95rem; }
  .filters { display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: var(--s5); }
  .people { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); }
  .person { height: 100%; padding: var(--s3); }
  .person img, .avatar { width: 100%; aspect-ratio: 1; border-radius: 10px; object-fit: cover; margin-bottom: var(--s2); }
  .avatar { display: grid; place-content: center; text-align: center; border: 1px dashed color-mix(in srgb, var(--amber) 50%, transparent);
    background: radial-gradient(circle at 50% 40%, color-mix(in srgb, var(--accent) 10%, transparent), transparent 70%); }
  .avatar span { font-family: var(--font-serif); font-size: 2.4rem; color: var(--text-3); }
  .avatar small { font-size: .65rem; color: var(--amber); text-transform: uppercase; letter-spacing: .1em; }
  .role { color: var(--accent); margin: 0 0 4px; text-transform: uppercase; letter-spacing: .1em; }
  .person h2 { font-size: 1.25rem; margin-bottom: 6px; }
  .links { display: flex; gap: 12px; margin: 0; }
  [data-person][hidden] { display: none; }
</style>
<script>
  import { flipFilter } from '../scripts/flipfilter';
  const btns = document.querySelectorAll<HTMLButtonElement>('[data-role]:is(button)');
  btns.forEach((b) => b.addEventListener('click', () => {
    btns.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    const people = [...document.querySelectorAll<HTMLElement>('[data-person]')];
    flipFilter(people, () => people.forEach((p) => (p.hidden = b.dataset.role !== 'all' && p.dataset.role !== b.dataset.role)));
  }));
</script>
