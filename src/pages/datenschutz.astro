---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
---
<Base title="Datenschutz">
  <PageHeader eyebrow="Legal" title="Datenschutzerklärung" lead="Privacy policy" />
  <section class="section section--tight"><div class="container">
    <p class="banner"><strong class="ph">Placeholder.</strong> Use the institution’s privacy policy template and have it checked by the data-protection officer.</p>
    <h2>Technical facts for the policy</h2>
    <ul class="muted">
      <li>No cookies and no analytics or tracking are used.</li>
      <li>All fonts and scripts are self-hosted; no requests to third-party servers are made when viewing the site.</li>
      <li>Display preferences (reduced motion, colour palette) are stored only in your browser’s local storage and never transmitted.</li>
      <li>Server access logs depend on the hosting provider — <span class="ph">[to be specified]</span>.</li>
    </ul>
  </div></section>
</Base>
