---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import news from '../../data/news.json';
import { url } from '../../lib/url';
export function getStaticPaths() { return news.map((n) => ({ params: { slug: n.slug }, props: { n } })); }
const { n } = Astro.props;
const fmt = (d: string) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base title={n.title} description={n.body.slice(0, 150)}>
  <PageHeader eyebrow={`News · ${n.category}`} title={n.title}>
    <p class="mono small muted"><time datetime={n.date}>{fmt(n.date)}</time></p>
  </PageHeader>
  <article class="section section--tight">
    <div class="container">
      <p class:list={['lead', { ph: n.placeholder }]}>{n.body}</p>
      {n.link && <p><a class="btn" href={n.link} rel="noopener">{n.linkLabel ?? 'More'} ↗</a></p>}
      <p style="margin-top:var(--s5)"><a href={url('/news/')}>← All news</a></p>
    </div>
  </article>
</Base>
