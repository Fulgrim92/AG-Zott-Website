---
/**
 * Zoomable microscopy viewer (OpenSeadragon). Each channel is a plain image or a Deep Zoom (.dzi)
 * tile source, composited additively so channels can be toggled. Data: src/data/assets.json → ihc.
 * Generate .dzi tiles with e.g. `vips dzsave input.tif output` for very large sections.
 */
import Label from './Label.astro';
import Placeholder from './Placeholder.astro';
import assets from '../data/assets.json';
import { url } from '../lib/url';

const a = assets.ihc as any;
const channels: { name: string; color: string; src: string }[] = a.channels ?? [];
const hasData = channels.length > 0 && channels.every((c) => c.src);
const config = {
  channels: channels.map((c) => ({ ...c, src: url(c.src) })),
  hotspots: a.hotspots ?? [],
  umPerPx: a.scaleBarMicronsPerPixel ?? null,
};
---
<div class="dz" data-dz data-config={JSON.stringify(config)}>
  {hasData ? (
    <>
      <div class="dz__viewer" data-dz-viewer role="application" aria-label={a.alt || 'Zoomable immunohistochemistry image. Use + and − to zoom, arrow keys to pan.'}></div>
      <span class="dz__scale mono" data-dz-scale hidden></span>
    </>
  ) : (
    <Placeholder title="High-resolution immunohistochemistry section" hint="Add one image or .dzi tile set per channel in src/data/assets.json → ihc.channels (e.g. DAPI, NeuN, GFAP). The deep-zoom viewer with channel toggles, minimap, scale bar and annotated hotspots activates automatically." minHeight="440px" />
  )}
  <div class="dz__controls" role="group" aria-label="Channels">
    {(hasData ? channels : [{ name: 'DAPI', color: 'blue' }, { name: 'Marker 1', color: 'green' }, { name: 'Marker 2', color: 'red' }]).map((c, i) => (
      <button class="btn btn--sm" aria-pressed="true" data-dz-ch={i} style={`--c:var(--${c.color})`} disabled={!hasData}>{c.name}</button>
    ))}
    <button class="btn btn--sm" data-dz-home disabled={!hasData}>Reset view</button>
    <Label kind={hasData ? 'data' : 'placeholder'} />
    {hasData && a.caption && <span class="small muted">{a.caption}</span>}
  </div>
  {config.hotspots.length > 0 && (
    <ol class="dz__notes" data-dz-notes>
      {config.hotspots.map((h: any, i: number) => <li><button class="linklike" data-dz-goto={i}><b>{h.label}</b></button> — {h.text}</li>)}
    </ol>
  )}
</div>

<style>
  .dz { display: grid; gap: var(--s2); position: relative; }
  .dz__viewer { height: min(72vh, 680px); background: #000; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .dz__scale { position: absolute; left: 16px; top: calc(min(72vh, 680px) - 36px); color: #fff; border-bottom: 3px solid #fff; font-size: .7rem; pointer-events: none; }
  .dz__controls { display: flex; flex-wrap: wrap; gap: var(--s1); align-items: center; }
  .dz__notes { color: var(--text-2); font-size: .9rem; }
  .linklike { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; text-decoration: underline; }
  :global(.dz-hotspot) { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #fff; background: color-mix(in srgb, var(--accent) 60%, transparent); color: #000; font: 700 11px var(--font-mono); display: grid; place-items: center; cursor: pointer; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dz]').forEach(async (root) => {
    const el = root.querySelector<HTMLElement>('[data-dz-viewer]');
    if (!el) return;
    const cfg = JSON.parse(root.dataset.config!);
    const { default: OSD } = await import('openseadragon');
    const viewer = OSD({
      element: el,
      prefixUrl: '', // no third-party requests; custom controls replace OSD's icon buttons
      showNavigationControl: false,
      showNavigator: true, navigatorPosition: 'TOP_RIGHT',
      animationTime: document.documentElement.dataset.motion === 'off' ? 0 : 0.9,
      gestureSettingsMouse: { clickToZoom: false },
      tileSources: cfg.channels.map((c: any, i: number) => ({
        tileSource: c.src.endsWith('.dzi') ? c.src : { type: 'image', url: c.src },
        compositeOperation: i === 0 ? undefined : 'lighter',
      })),
    });
    const items = () => Array.from({ length: viewer.world.getItemCount() }, (_, i) => viewer.world.getItemAt(i));

    root.querySelectorAll<HTMLButtonElement>('[data-dz-ch]').forEach((b) => b.addEventListener('click', () => {
      const on = b.getAttribute('aria-pressed') !== 'true';
      b.setAttribute('aria-pressed', String(on));
      items()[+b.dataset.dzCh!]?.setOpacity(on ? 1 : 0);
    }));
    root.querySelector('[data-dz-home]')?.addEventListener('click', () => viewer.viewport.goHome());

    viewer.addHandler('open', () => {
      const first = items()[0];
      cfg.hotspots.forEach((h: any, i: number) => {
        const dot = document.createElement('button');
        dot.className = 'dz-hotspot'; dot.textContent = String(i + 1); dot.setAttribute('aria-label', h.label);
        dot.addEventListener('click', () => zoomTo(i));
        viewer.addOverlay({ element: dot, location: first.imageToViewportCoordinates(h.x * first.getContentSize().x, h.y * first.getContentSize().y), placement: OSD.Placement.CENTER });
      });
      const zoomTo = (i: number) => {
        const h = cfg.hotspots[i];
        const p = first.imageToViewportCoordinates(h.x * first.getContentSize().x, h.y * first.getContentSize().y);
        viewer.viewport.panTo(p); viewer.viewport.zoomTo(viewer.viewport.getMaxZoom() * 0.4);
      };
      root.querySelectorAll<HTMLButtonElement>('[data-dz-goto]').forEach((b) => b.addEventListener('click', () => zoomTo(+b.dataset.dzGoto!)));
    });

    // Scale bar that updates with zoom (needs microns-per-pixel of the original image)
    const scale = root.querySelector<HTMLElement>('[data-dz-scale]');
    if (cfg.umPerPx && scale) {
      scale.hidden = false;
      const nice = [1, 2, 5, 10, 20, 50, 100, 200, 500, 1000, 2000];
      const update = () => {
        const first = items()[0]; if (!first) return;
        const screenPxPerImagePx = first.viewportToImageZoom(viewer.viewport.getZoom(true));
        const umPerScreenPx = cfg.umPerPx / screenPxPerImagePx;
        const um = nice.find((n) => n / umPerScreenPx > 80) ?? 2000;
        scale.style.width = `${um / umPerScreenPx}px`;
        scale.textContent = um >= 1000 ? `${um / 1000} mm` : `${um} µm`;
      };
      viewer.addHandler('animation', update); viewer.addHandler('open', update);
    }
  });
</script>
