---
/**
 * Zoomable microscopy viewer (OpenSeadragon) for src/data/assets.json → ihc.
 * Each "section" is one image (plain image or Deep Zoom .dzi tiles); visitors switch between
 * sections, zoom/pan, and follow numbered hotspots with explanations.
 * For very large originals create tiles with `vips dzsave input.tif output`.
 */
import Label from './Label.astro';
import Placeholder from './Placeholder.astro';
import assets from '../data/assets.json';
import { url } from '../lib/url';

const a = assets.ihc;
const sections = a.sections.filter((s) => s.src).map((s) => ({ ...s, src: url(s.src) }));
---
{sections.length === 0 ? (
  <Placeholder title="Immunohistochemistry / confocal images" hint="Add sections to src/data/assets.json → ihc.sections." />
) : (
<div class="dz" data-dz data-config={JSON.stringify(sections)}>
  <div class="dz__top">
    <div role="tablist" aria-label="Section" class="seg">
      {sections.map((s, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-sec={i}>{s.label}</button>)}
    </div>
    <div class="dz__btns">
      <button class="btn btn--sm" data-zoom="in" aria-label="Zoom in">＋</button>
      <button class="btn btn--sm" data-zoom="out" aria-label="Zoom out">－</button>
      <button class="btn btn--sm" data-home>Reset view</button>
    </div>
  </div>
  <div class="dz__viewer" data-dz-viewer role="application" aria-label="Zoomable confocal image. Use the zoom buttons or scroll, drag to pan; numbered markers explain structures."></div>
  <ul class="dz__legend small">
    {a.stains.map((s) => <li><i style={`--c:${s.color === 'grey' ? '#bbb' : '#3fe0ff'}`}></i><b>{s.name}</b> — {s.target}</li>)}
  </ul>
  <p class="small" data-caption>{sections[0].caption}</p>
  <ol class="dz__notes" data-notes></ol>
  <p class="dz__src small">
    <Label kind="data" text="Published lab data" />
    <span class="muted">{a.source} · <a href={`https://doi.org/${a.doi}`}>doi:{a.doi}</a>. {a.note}</span>
  </p>
</div>
)}

<style>
  .dz { display: grid; gap: var(--s2); }
  .dz__top { display: flex; justify-content: space-between; flex-wrap: wrap; gap: var(--s2); }
  .seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); }
  .seg button { border: 0; background: transparent; padding: .4em 1em; border-radius: 999px; cursor: pointer; font-size: .85rem; color: var(--text-2); }
  .seg button[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
  .dz__btns { display: flex; gap: 6px; }
  .dz__viewer { height: min(68vh, 620px); background: #000; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  .dz__legend { list-style: none; display: flex; gap: var(--s3); flex-wrap: wrap; padding: 0; margin: 0; color: var(--text-2); }
  .dz__legend i { display: inline-block; width: 9px; height: 9px; border-radius: 50%; background: var(--c); margin-right: 6px; box-shadow: 0 0 8px var(--c); }
  [data-caption] { margin: 0; color: var(--text-2); }
  .dz__notes { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--s2); grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .dz__notes :global(li) { border: 1px solid var(--line); border-radius: 10px; padding: var(--s2); background: var(--surface); font-size: .9rem; color: var(--text-2); }
  .dz__notes :global(button) { background: none; border: 0; padding: 0; color: var(--accent); cursor: pointer; font-family: var(--font-serif); font-size: 1.05rem; text-align: left; display: block; margin-bottom: 4px; }
  .dz__src { display: flex; gap: var(--s2); align-items: center; flex-wrap: wrap; margin: 0; }
  :global(.dz-hotspot) { width: 24px; height: 24px; border-radius: 50%; border: 2px solid #fff; background: color-mix(in srgb, var(--accent) 75%, #000); color: #000; font: 700 11px var(--font-mono); display: grid; place-items: center; cursor: pointer; box-shadow: 0 0 0 4px rgba(0,0,0,.35); }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-dz]').forEach(async (root) => {
    const el = root.querySelector<HTMLElement>('[data-dz-viewer]')!;
    const sections = JSON.parse(root.dataset.config!);
    const caption = root.querySelector<HTMLElement>('[data-caption]')!;
    const notes = root.querySelector<HTMLOListElement>('[data-notes]')!;
    const { default: OSD } = await import('openseadragon');
    const viewer = OSD({
      element: el,
      prefixUrl: '', // no third-party requests; custom controls replace OSD's icon buttons
      showNavigationControl: false,
      showNavigator: true, navigatorPosition: 'TOP_RIGHT', navigatorSizeRatio: 0.18,
      maxZoomPixelRatio: 4, visibilityRatio: 0.8,
      animationTime: document.documentElement.dataset.motion === 'off' ? 0 : 0.9,
      gestureSettingsMouse: { clickToZoom: false },
    });
    let current = 0;
    const src = (s: any) => (s.src.endsWith('.dzi') ? s.src : { type: 'image', url: s.src });

    const zoomTo = (i: number) => {
      const item = viewer.world.getItemAt(0); if (!item) return;
      const h = sections[current].hotspots[i], size = item.getContentSize();
      viewer.viewport.panTo(item.imageToViewportCoordinates(h.x * size.x, h.y * size.y));
      viewer.viewport.zoomTo(viewer.viewport.getHomeZoom() * 2.6);
    };

    viewer.addHandler('open', () => {
      const s = sections[current], item = viewer.world.getItemAt(0), size = item.getContentSize();
      el.setAttribute('aria-label', `${s.alt} Zoom with the buttons or scroll; numbered markers explain structures.`);
      caption.textContent = s.caption;
      notes.innerHTML = '';
      s.hotspots.forEach((h: any, i: number) => {
        const dot = document.createElement('button');
        dot.className = 'dz-hotspot'; dot.textContent = String(i + 1); dot.setAttribute('aria-label', `${i + 1}: ${h.label}`);
        dot.addEventListener('click', () => zoomTo(i));
        viewer.addOverlay({ element: dot, location: item.imageToViewportCoordinates(h.x * size.x, h.y * size.y), placement: OSD.Placement.CENTER });
        const li = document.createElement('li');
        const b = document.createElement('button'); b.textContent = `${i + 1}. ${h.label}`; b.addEventListener('click', () => zoomTo(i));
        li.append(b, document.createTextNode(h.text)); notes.append(li);
      });
    });
    const open = (i: number) => { current = i; viewer.clearOverlays(); viewer.open(src(sections[i])); };
    open(0);

    root.querySelectorAll<HTMLButtonElement>('[data-sec]').forEach((b, _, all) => b.addEventListener('click', () => {
      all.forEach((x) => x.setAttribute('aria-selected', String(x === b)));
      open(+b.dataset.sec!);
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-zoom]').forEach((b) => b.addEventListener('click', () => viewer.viewport.zoomBy(b.dataset.zoom === 'in' ? 1.6 : 1 / 1.6)));
    root.querySelector('[data-home]')!.addEventListener('click', () => viewer.viewport.goHome());
  });
</script>
