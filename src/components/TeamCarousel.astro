---
/** Horizontally scrolling team cards (scroll-snap, arrows, dots, drag on desktop). People come from src/data/team.json. */
import team from '../data/team.json';
import { url } from '../lib/url';
const initials = (n: string) => n.replace(/\[.*?\]/g, '').trim().split(/\s+/).map((w) => w[0]).slice(0, 2).join('') || '?';
const focus = (f: string | string[]) => (Array.isArray(f) ? f : [f]).slice(0, 2);
---
<div class="tc" data-carousel>
  <ul class="tc__track" role="list" data-track tabindex="0" aria-label="Team members">
    {team.map((m, i) => (
      <li class="tc__item" data-reveal>
        <a class="tc__card" href={url('/team/')} aria-label={`${m.name.replace(/\[.*?\]\s*/, '')} — ${m.position}`}>
          <div class:list={['tc__photo', { 'is-ph': !m.photo }]} style={`--h:${(i * 47) % 360}`}>
            {m.photo
              ? <img src={url(m.photo)} alt="" loading="lazy" width="400" height="460" />
              : <><span class="tc__mono">{initials(m.name)}</span><span class="tc__note">Photo to come</span></>}
          </div>
          <div class="tc__body">
            <h3 class:list={[{ ph: m.placeholder }]}>{m.name.replace('[PLACEHOLDER] ', '')}</h3>
            <p class="tc__pos">{m.position}</p>
            <ul class="tc__focus" role="list">{focus(m.focus).map((f) => <li class:list={[{ ph: f.startsWith('[') }]}>{f}</li>)}</ul>
          </div>
        </a>
      </li>
    ))}
  </ul>
  <div class="tc__ctrl">
    <div class="tc__dots" data-dots aria-hidden="true"></div>
    <div class="tc__arrows">
      <button class="tc__btn" data-prev aria-label="Previous team members"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <button class="tc__btn" data-next aria-label="Next team members"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </div>
</div>

<style>
  .tc { min-width: 0; }
  .tc__track { list-style: none; margin: 0; padding: 4px 4px 18px; display: grid; grid-auto-flow: column; grid-auto-columns: minmax(220px, calc((100% - 3 * var(--s3)) / 3.3));
    gap: var(--s3); overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; cursor: grab; }
  .tc__track::-webkit-scrollbar { display: none; }
  .tc__track.is-drag { cursor: grabbing; scroll-snap-type: none; }
  .tc__track.is-drag a { pointer-events: none; }
  .tc__item { scroll-snap-align: start; }
  .tc__card { display: grid; height: 100%; border-radius: var(--radius); overflow: hidden; background: var(--surface); border: 1px solid var(--line);
    text-decoration: none; color: var(--text); box-shadow: var(--shadow-sm); transition: transform .4s var(--ease), box-shadow .4s var(--ease); }
  .tc__card:hover { transform: translateY(-4px); box-shadow: var(--shadow-md); color: var(--text); }
  .tc__photo { position: relative; aspect-ratio: 5 / 5.4; overflow: hidden; background: var(--surface-2); }
  .tc__photo img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
  .tc__card:hover .tc__photo img { transform: scale(1.04); }
  .tc__photo.is-ph { display: grid; place-content: center; justify-items: center; gap: 6px;
    background: radial-gradient(120% 90% at 30% 20%, hsl(var(--h) 45% 94%), transparent 60%), linear-gradient(160deg, #eef4f5, #e3ecee); }
  .tc__photo.is-ph::after { content: ''; position: absolute; inset: 10px; border: 1px dashed color-mix(in srgb, var(--amber) 45%, transparent); border-radius: 10px; }
  .tc__mono { font-family: var(--font-serif); font-size: 3rem; color: color-mix(in srgb, var(--primary) 55%, #9aa); transition: transform .6s var(--ease); }
  .tc__card:hover .tc__mono { transform: scale(1.08); }
  .tc__note { font-size: .66rem; letter-spacing: .12em; text-transform: uppercase; color: var(--amber); }
  .tc__body { padding: var(--s2) var(--s2) var(--s3); }
  .tc__body h3 { font-family: var(--font-sans); font-weight: 600; font-size: 1rem; margin: 0 0 2px; letter-spacing: 0; }
  .tc__pos { margin: 0 0 10px; font-size: .86rem; color: var(--primary); font-weight: 500; }
  .tc__focus { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; font-size: .8rem; color: var(--text-3); line-height: 1.4; }
  .tc__ctrl { display: flex; justify-content: space-between; align-items: center; margin-top: var(--s2); }
  .tc__dots { display: flex; gap: 8px; }
  .tc__dots span { width: 7px; height: 7px; border-radius: 99px; background: var(--line-2); transition: width .4s var(--ease), background .3s; }
  .tc__dots span.is-on { width: 24px; background: var(--primary); }
  .tc__arrows { display: flex; gap: 8px; }
  .tc__btn { width: 42px; height: 42px; border-radius: 50%; border: 1px solid var(--line-2); background: var(--surface); display: grid; place-items: center; cursor: pointer; color: var(--text);
    transition: border-color .2s, color .2s, transform .2s, opacity .2s; }
  .tc__btn:hover { border-color: var(--primary); color: var(--primary); }
  .tc__btn:active { transform: scale(.94); }
  .tc__btn:disabled { opacity: .35; cursor: default; }
  @media (max-width: 767px) { .tc__track { grid-auto-columns: 72%; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const dots = root.querySelector<HTMLElement>('[data-dots]')!;
    const prev = root.querySelector<HTMLButtonElement>('[data-prev]')!;
    const next = root.querySelector<HTMLButtonElement>('[data-next]')!;
    const items = [...track.children] as HTMLElement[];
    const step = () => items[1] ? items[1].offsetLeft - items[0].offsetLeft : track.clientWidth;
    const pages = () => Math.max(1, Math.ceil((track.scrollWidth - track.clientWidth) / step()) + 1);
    const update = () => {
      const n = pages(), i = Math.round(track.scrollLeft / step());
      if (dots.children.length !== n) dots.innerHTML = Array.from({ length: n }, () => '<span></span>').join('');
      [...dots.children].forEach((d, k) => d.classList.toggle('is-on', k === Math.min(i, n - 1)));
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft > track.scrollWidth - track.clientWidth - 4;
    };
    prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
    next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));
    track.addEventListener('scroll', update, { passive: true });
    new ResizeObserver(update).observe(track);
    // Drag to scroll with a mouse
    let down = false, x0 = 0, s0 = 0, moved = false;
    track.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') return; down = true; moved = false; x0 = e.clientX; s0 = track.scrollLeft; });
    addEventListener('pointermove', (e) => {
      if (!down) return;
      if (Math.abs(e.clientX - x0) > 5) { moved = true; track.classList.add('is-drag'); }
      track.scrollLeft = s0 - (e.clientX - x0);
    });
    addEventListener('pointerup', () => {
      if (!down) return; down = false;
      if (moved) { track.classList.remove('is-drag'); const i = Math.round(track.scrollLeft / step()); track.scrollTo({ left: i * step(), behavior: 'smooth' }); }
    });
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); next.click(); } else if (e.key === 'ArrowLeft') { e.preventDefault(); prev.click(); }
    });
  });
</script>
