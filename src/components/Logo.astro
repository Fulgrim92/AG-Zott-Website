---
/**
 * Lab mark: a CA1 pyramidal neuron (soma, apical and basal dendrites) inside the arc of a microscope
 * objective's field of view. The soma flashes now and then like a calcium transient.
 */
interface Props { size?: number; class?: string }
const { size = 32, class: cls } = Astro.props;
const id = `lg${Math.random().toString(36).slice(2, 7)}`;
---
<svg class:list={['logo', cls]} viewBox="0 0 40 40" width={size} height={size} aria-hidden="true" fill="none" stroke-linecap="round" stroke-linejoin="round">
  <defs>
    <linearGradient id={`${id}-g`} x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="var(--logo-a)" /><stop offset="1" stop-color="var(--logo-b)" /></linearGradient>
    <radialGradient id={`${id}-s`} cx="50%" cy="40%" r="60%"><stop offset="0" stop-color="#eafff4" /><stop offset=".5" stop-color="#4dff9a" /><stop offset="1" stop-color="#4dff9a" stop-opacity="0" /></radialGradient>
  </defs>
  <!-- field of view: an open ring with a scale notch -->
  <path d="M33.6 9.2 A18 18 0 1 1 25.4 2.8" stroke={`url(#${id}-g)`} stroke-width="1.4" opacity=".55" />
  <path d="M29.3 4.9 l1.4 -1.4" stroke="var(--logo-b)" stroke-width="1.4" opacity=".8" />
  <!-- neuron -->
  <g stroke={`url(#${id}-g)`} stroke-width="1.8">
    <path d="M20 24.8 V11.5 M20 15 L14.6 9.4 M20 12.6 L25.2 7 M14.6 9.4 L12.4 6 M14.6 9.4 L11 10.4 M25.2 7 L27.8 4.8 M25.2 7 L28.8 8.6 M20 19 L25.4 16.2" />
    <path d="M16.2 29.6 L12.2 33.4 M23.8 29.6 L27.8 33.4 M18 29.8 L17 34.6 M22 29.8 L23 34.6" stroke-width="1.5" />
  </g>
  <path d="M20 23.6 L15.4 30 Q20 31.6 24.6 30 Z" fill={`url(#${id}-g)`} />
  <circle class="logo__flash" cx="20" cy="27.6" r="6.5" fill={`url(#${id}-s)`} />
</svg>
<style>
  .logo { --logo-a: #2a8f8a; --logo-b: var(--primary); flex: none; overflow: visible; }
  :global(.theme-dark) .logo { --logo-a: #9ff2e3; --logo-b: var(--glow); }
  .logo__flash { opacity: 0; transform-origin: 20px 27.6px; animation: logo-flash 6s ease-out infinite 1.2s; mix-blend-mode: screen; }
  @keyframes logo-flash { 0%, 100% { opacity: 0; transform: scale(.6); } 4% { opacity: .95; transform: scale(1); } 22% { opacity: 0; transform: scale(1.25); } }
  :global(a:hover) > .logo .logo__flash { animation-duration: 1.4s; animation-delay: 0s; }
  :global(:root[data-motion='off']) .logo__flash { animation: none; }
</style>
