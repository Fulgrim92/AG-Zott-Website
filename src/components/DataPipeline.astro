---
/**
 * "The data, for real": a scrollytelling walk through the lab's analysis pipeline on a real recording
 * (raw movie → projections → ROIs → ΔF/F → events → synced playback). Data: src/data/pipeline.json,
 * generated by scripts/build-pipeline.py. Text: src/data/home.json → pipeline.
 */
import home from '../data/home.json';
import assets from '../data/assets.json';
import Label from './Label.astro';
import { url } from '../lib/url';
const P = home.pipeline;
const rec = assets.twoPhoton.recordings[0];
---
<section class="dp" data-dp aria-labelledby="dp-h">
  <h3 id="dp-h" class="visually-hidden">The data, for real</h3>
  <div class="dp__grid">
    <ol class="dp__steps" role="list">
      {P.steps.map((s, i) => (
        <li class="dp__step" data-dp-step={i}>
          <span class="dp__n mono">{String(i + 1).padStart(2, '0')}</span>
          <h4>{s.title}</h4>
          <p>{s.text}</p>
          {i === 1 && (
            <label class="dp__slider">
              <span>Mean</span>
              <input type="range" min="0" max="100" value="0" data-dp-mix aria-label="Blend between mean image and correlation image" />
              <span>Correlation</span>
            </label>
          )}
          {i === 4 && <p class="dp__stat mono" data-dp-stat aria-live="polite"></p>}
          {i === 5 && (
            <div class="dp__end">
              <button class="btn btn--sm" data-dp-play aria-pressed="true">Pause</button>
              <a class="link-arrow" href={url(P.cta.href)}>{P.cta.label}</a>
            </div>
          )}
        </li>
      ))}
    </ol>

    <div class="dp__sticky">
      <figure class="dp__stage" data-dp-stage data-step="0">
        <div class="dp__img">
          <video data-dp-video src={url(rec.src)} poster={url(rec.poster)} muted loop playsinline preload="metadata" aria-label={rec.alt}></video>
          <img data-dp-mean src={url('/assets/lab/2p/pipeline/mean.jpg')} alt="Mean projection of the recording: densely packed CA1 pyramidal cell bodies." width="502" height="458" loading="lazy" />
          <img data-dp-corr src={url('/assets/lab/2p/pipeline/corr.jpg')} alt="Local correlation image: neurons that were active appear as bright discs." width="502" height="458" loading="lazy" />
          <svg data-dp-overlay viewBox="0 0 502 458" aria-hidden="true"><g data-dp-props></g><g data-dp-rois></g></svg>
          <span class="dp__time mono" data-dp-time>t = 0.0 s</span>
          <span class="dp__lbl"><Label kind="data" text={P.label} /></span>
        </div>
        <div class="dp__traces" data-dp-traces>
          <svg viewBox="0 0 560 460" data-dp-plot aria-hidden="true"></svg>
          <div class="dp__legend mono small" data-dp-legend></div>
        </div>
      </figure>
      <p class="dp__foot small">{P.footnote}</p>
    </div>
  </div>
</section>

<style>
  .dp { padding: 0 clamp(var(--s2), 4vw, var(--s6)) var(--s7); }
  .dp__grid { max-width: 1480px; margin: 0 auto; display: grid; grid-template-columns: minmax(250px, 0.62fr) minmax(0, 1.9fr); gap: clamp(var(--s3), 3.5vw, var(--s5)); }
  .dp__steps { list-style: none; margin: 0; padding: 30vh 0 40vh; display: grid; gap: 0; }
  .dp__step { min-height: 72vh; display: grid; align-content: center; gap: 4px; opacity: .28; transition: opacity .5s var(--ease); }
  .dp__step.is-on { opacity: 1; }
  .dp__n { color: var(--glow); font-size: .78rem; letter-spacing: .1em; }
  .dp__step h4 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.6rem, 2.5vw, 2.2rem); line-height: 1.1; margin: 4px 0 var(--s2); }
  .dp__step p { color: var(--text-2); }
  .dp__slider { display: flex; align-items: center; gap: 10px; font-size: .8rem; color: var(--text-2); }
  .dp__slider input { flex: 1; max-width: 220px; accent-color: var(--glow); }
  .dp__stat { color: var(--glow); font-size: .85rem; min-height: 1.5em; }
  .dp__end { display: flex; flex-wrap: wrap; gap: var(--s2); align-items: center; }

  .dp__sticky { align-self: start; position: sticky; top: calc(var(--header-h) + 12px); height: calc(100svh - var(--header-h) - 24px); display: grid; align-content: center; gap: 10px; }
  .dp__stage { margin: 0; display: grid; grid-template-columns: 100% 0%; gap: 0; border: 1px solid var(--line); border-radius: 20px; overflow: hidden; background: #050d12;
    transition: grid-template-columns .9s var(--ease), width .9s var(--ease); aspect-ratio: 502 / 458; justify-self: center;
    --sh: calc(100svh - var(--header-h) - 110px); width: min(100%, calc(var(--sh) * 1.096)); }
  .dp__stage.is-split { grid-template-columns: 46.6% 53.4%; aspect-ratio: 2.35 / 1; width: min(100%, calc(var(--sh) * 2.35)); }
  .dp__img { position: relative; overflow: hidden; background: #000; min-width: 0; }
  .dp__img video, .dp__img img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; transition: opacity .7s var(--ease); }
  .dp__img img { opacity: 0; }
  .dp__img svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .dp__time { display: none; position: absolute; left: 12px; top: 10px; font-size: .72rem; color: #e9f1f3; background: rgba(5, 13, 18, .7); padding: 2px 8px; border-radius: 5px; }
  .dp__lbl { position: absolute; right: 10px; bottom: 10px; }
  .dp__traces { position: relative; min-width: 0; opacity: 0; transition: opacity .6s var(--ease) .2s; border-left: 1px solid var(--line); background: linear-gradient(180deg, #071820, #050f14); }
  .is-split .dp__traces { opacity: 1; }
  .dp__traces svg { width: 100%; height: 100%; }
  .dp__legend { position: absolute; left: 14px; right: 14px; bottom: 8px; display: flex; flex-wrap: wrap; gap: 4px 14px; color: var(--text-3); font-size: .7rem; }
  .dp__legend i { display: inline-block; width: 14px; height: 2px; margin-right: 6px; vertical-align: middle; }
  .dp__foot { color: var(--text-3); max-width: 80ch; margin: 0; }

  .dp__stage :global(.roi) { fill: none; stroke-width: 2.2; transition: opacity .4s, stroke-width .3s; }
  .dp__stage :global(.roi.is-dim) { opacity: .25; }
  .dp__stage :global(.roi.is-hot) { stroke-width: 4; }
  .dp__stage :global(.roi-fill) { transition: opacity .3s; }
  .dp__stage :global(.prop) { fill: none; stroke: #ffd166; stroke-width: 1.4; stroke-dasharray: 4 4; transition: opacity .5s; }
  .dp__traces :global(text) { font-family: var(--font-mono); font-size: 12px; fill: #86a0a9; }
  .dp__traces :global(.ttl) { font-size: 13px; fill: #a9bcc3; }
  .dp__traces :global(.eq) { font-family: var(--font-serif); font-size: 22px; fill: #e9f1f3; font-style: italic; }
  .dp__traces :global(.tr) { cursor: pointer; }

  @media (max-width: 960px) {
    .dp__grid { grid-template-columns: 1fr; }
    .dp__sticky { order: -1; top: 0; height: auto; z-index: 2; background: var(--bg); padding: calc(var(--header-h) + 6px) 0 8px; margin-top: calc(-1 * var(--header-h)); }
    .dp__stage { --sh: 46svh; }
    .dp__stage.is-split { grid-template-columns: 100%; grid-template-rows: 54% 46%; aspect-ratio: .92; width: min(100%, calc(var(--sh) * .92)); }
    .dp__traces { border-left: 0; border-top: 1px solid var(--line); }
    .dp__legend { display: none; }
    .dp__steps { padding: 4vh 0 30vh; }
    .dp__step { min-height: 60vh; align-content: start; padding-top: 4vh; }
    .dp__foot { display: none; }
  }
</style>
