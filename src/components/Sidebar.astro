---
import site from '../data/site.json';
import { url, stripBase } from '../lib/url';

const path = stripBase(Astro.url.pathname);

const icons: Record<string, string> = {
  home: 'M3 11l9-7 9 7v9a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z',
  research: 'M12 3a4 4 0 0 0-4 4 4 4 0 0 0-3 6.5A4 4 0 0 0 9 20h.5M12 3a4 4 0 0 1 4 4 4 4 0 0 1 3 6.5A4 4 0 0 1 15 20h-.5M12 3v18',
  team: 'M16 19v-1a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v1M9 10a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm13 9v-1a4 4 0 0 0-3-3.9M16 4.1a3 3 0 0 1 0 5.8',
  papers: 'M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8zM14 3v5h5M9 13h6M9 17h6',
  news: 'M4 5h13v14a2 2 0 0 0 2 2H6a2 2 0 0 1-2-2zM17 9h3v10a2 2 0 0 1-2 2M8 9h5M8 13h5M8 17h3',
  funding: 'M12 2l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 15.6 6.6 18.5l1.2-6L3.3 8.3l6.1-.7z',
  teaching: 'M2 8l10-5 10 5-10 5zM6 10v5c0 1.7 2.7 3 6 3s6-1.3 6-3v-5M22 8v6',
  alumni: 'M12 15a6 6 0 1 0 0-12 6 6 0 0 0 0 12zM8.2 13.9L7 22l5-3 5 3-1.2-8.1',
  contact: 'M3 6l9 6 9-6M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1z',
};

const research = [
  { href: '/research/two-photon/', label: 'Two-photon CA1', color: 'var(--green)' },
  { href: '/research/immunohistochemistry/', label: 'Immunohistochemistry', color: 'var(--blue)' },
  { href: '/research/electrophysiology/', label: 'Electrophysiology', color: 'var(--red)' },
  ...(site.features.glymphatic ? [{ href: '/research/glymphatic/', label: 'Glymphatic system', color: 'var(--magenta)' }] : []),
];

const nav = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'research', href: '/research/', label: 'Research', children: research },
  { key: 'team', href: '/team/', label: 'Team' },
  { key: 'papers', href: '/papers/', label: 'Papers' },
  { key: 'news', href: '/news/', label: 'News' },
  { key: 'funding', href: '/funding/', label: 'Funding' },
  { key: 'teaching', href: '/teaching/', label: 'Teaching' },
  { key: 'alumni', href: '/alumni/', label: 'Alumni' },
  { key: 'contact', href: '/contact/', label: 'Contact' },
];

const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!-- Mobile top bar -->
<header class="topbar">
  <a href={url('/')} class="brand brand--small" aria-label="AG Zott — home">
    <span class="brand__mark" aria-hidden="true"></span><span>AG Zott</span>
  </a>
  <div class="topbar__quick">
    <a href={url('/papers/')} class="topbar__link">Papers</a>
    <a href={url('/contact/')} class="topbar__link">Contact</a>
    <button class="menu-btn" aria-controls="sidebar" aria-expanded="false" data-menu-toggle>
      <span class="visually-hidden">Open menu</span>
      <span class="menu-btn__bars" aria-hidden="true"></span>
    </button>
  </div>
</header>

<div class="scrim" data-scrim hidden></div>

<aside id="sidebar" class="sidebar" aria-label="Site">
  <a href={url('/')} class="brand" aria-label="AG Zott — home">
    <span class="brand__mark" aria-hidden="true"></span>
    <span class="brand__text">
      <span class="brand__name">AG Zott</span>
      <span class="brand__aff">{site.affiliation}</span>
    </span>
  </a>

  <nav aria-label="Main" class="nav">
    <ul role="list">
      {nav.map((item) => (
        <li class:list={['nav__item', { 'is-active': isActive(item.href) }]}>
          <a href={url(item.href)} aria-current={isActive(item.href) && (item.href === path) ? 'page' : undefined} data-tip={item.label}>
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={icons[item.key]} /></svg>
            <span class="nav__label">{item.label}</span>
          </a>
          {item.children && (
            <ul role="list" class="nav__sub">
              {item.children.map((c) => (
                <li class:list={[{ 'is-active': path.startsWith(c.href) }]} style={`--c:${c.color}`}>
                  <a href={url(c.href)} aria-current={path.startsWith(c.href) ? 'page' : undefined}>{c.label}</a>
                </li>
              ))}
            </ul>
          )}
        </li>
      ))}
    </ul>
  </nav>

  <div class="sidebar__foot">
    <a href={url('/funding/')} class="funders" aria-label="Funded by ERC and DFG — see funding">
      <span class="funders__lbl">Funded by</span>
      <span class="funders__marks"><span>ERC</span><span aria-hidden="true">·</span><span>DFG</span></span>
    </a>
    <div class="toggles" role="group" aria-label="Display settings">
      <button class="tgl" data-toggle-motion aria-pressed="false" title="Reduce motion">Motion</button>
      <button class="tgl" data-toggle-palette aria-pressed="false" title="Colour-blind-safe palette">CB-safe</button>
      <span class="tgl tgl--lang" title="German version in preparation"><b>EN</b>&nbsp;/&nbsp;<span aria-disabled="true">DE</span></span>
    </div>
    <div class="quick">
      <a href={`mailto:${site.email}`}>Email</a>
      {site.links.orcid && <a href={site.links.orcid}>ORCID</a>}
      {site.links.scholar && <a href={site.links.scholar}>Scholar</a>}
      {site.links.institute && <a href={site.links.institute}>Institute</a>}
    </div>
  </div>

  <button class="rail-pin" data-rail-pin aria-expanded="false" aria-controls="sidebar">
    <span class="visually-hidden">Expand navigation</span>
    <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 6l6 6-6 6" /></svg>
  </button>
</aside>

<style>
  .sidebar {
    position: fixed; inset: 0 auto 0 0; width: var(--sidebar-w); z-index: 100;
    display: flex; flex-direction: column; gap: var(--s4);
    padding: var(--s4) var(--s3);
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(14px);
    border-right: 1px solid var(--line);
    overflow-y: auto; overscroll-behavior: contain;
    transition: width .35s var(--ease), transform .35s var(--ease);
  }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand__mark {
    width: 30px; height: 30px; border-radius: 50%; flex: none;
    background:
      radial-gradient(circle at 35% 35%, var(--green) 0 22%, transparent 24%),
      radial-gradient(circle at 66% 62%, var(--magenta) 0 16%, transparent 18%),
      radial-gradient(circle at 60% 30%, var(--blue) 0 10%, transparent 12%),
      #0f1522;
    box-shadow: 0 0 18px color-mix(in srgb, var(--green) 35%, transparent), inset 0 0 0 1px var(--line);
  }
  .brand__text { display: grid; line-height: 1.2; }
  .brand__name { font-family: var(--font-serif); font-size: 1.45rem; }
  .brand__aff { font-size: .7rem; color: var(--amber); margin-top: 3px; }

  .nav ul { list-style: none; margin: 0; padding: 0; }
  .nav__item > a {
    display: flex; align-items: center; gap: 12px; padding: 9px 12px; border-radius: 10px;
    text-decoration: none; font-family: var(--font-mono); font-size: .78rem; letter-spacing: .14em; text-transform: uppercase;
    color: var(--text-2); position: relative; transition: color .2s, background .2s;
  }
  .nav__item > a svg { flex: none; opacity: .75; }
  .nav__item > a:hover { color: var(--text); background: var(--surface); }
  .nav__item.is-active > a { color: var(--text); font-weight: 600; }
  .nav__item.is-active > a::before {
    content: ''; position: absolute; left: -24px; top: 8px; bottom: 8px; width: 3px; border-radius: 0 3px 3px 0;
    background: var(--accent); box-shadow: 0 0 12px var(--accent);
  }
  .nav__item.is-active > a svg { opacity: 1; color: var(--accent); }
  .nav__sub { margin: 2px 0 8px 44px !important; border-left: 1px solid var(--line); }
  .nav__sub a { display: block; padding: 5px 12px; font-size: .85rem; color: var(--text-3); text-decoration: none; position: relative; }
  .nav__sub a::before { content: ''; position: absolute; left: -4px; top: 50%; width: 7px; height: 7px; margin-top: -3.5px; border-radius: 50%; background: var(--c); opacity: .35; transition: opacity .2s, box-shadow .2s; }
  .nav__sub a:hover { color: var(--text); }
  .nav__sub a:hover::before, .nav__sub .is-active a::before { opacity: 1; box-shadow: 0 0 10px var(--c); }
  .nav__sub .is-active a { color: var(--text); }

  .sidebar__foot { margin-top: auto; display: grid; gap: var(--s2); font-size: .8rem; }
  .funders { display: flex; justify-content: space-between; align-items: center; padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; text-decoration: none; }
  .funders__lbl { color: var(--text-3); font-size: .7rem; text-transform: uppercase; letter-spacing: .1em; }
  .funders__marks { font-family: var(--font-mono); font-weight: 600; display: flex; gap: 6px; color: var(--text); }
  .toggles { display: flex; gap: 6px; flex-wrap: wrap; }
  .tgl { background: transparent; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; font-size: .72rem; color: var(--text-2); cursor: pointer; }
  .tgl[aria-pressed='true'] { color: var(--accent); border-color: var(--accent); }
  .tgl--lang { cursor: default; } .tgl--lang span { color: var(--text-3); }
  .quick { display: flex; gap: 12px; flex-wrap: wrap; color: var(--text-2); }
  .quick a { text-decoration: none; } .quick a:hover { color: var(--accent); }

  .rail-pin, .topbar, .scrim { display: none; }

  /* ---- Tablet: icon rail ---- */
  @media (max-width: 1199px) and (min-width: 768px) {
    .sidebar:not(.is-expanded) { width: var(--rail-w); padding-inline: 12px; overflow: visible; }
    .sidebar:not(.is-expanded) .brand__text,
    .sidebar:not(.is-expanded) .nav__label,
    .sidebar:not(.is-expanded) .nav__sub,
    .sidebar:not(.is-expanded) .sidebar__foot { display: none; }
    .sidebar:not(.is-expanded) .brand { justify-content: center; }
    .sidebar:not(.is-expanded) .nav__item > a { justify-content: center; padding: 11px; }
    .sidebar:not(.is-expanded) .nav__item.is-active > a::before { left: -12px; }
    .sidebar:not(.is-expanded) .nav__item > a:hover::after,
    .sidebar:not(.is-expanded) .nav__item > a:focus-visible::after {
      content: attr(data-tip); position: absolute; left: calc(100% + 12px); top: 50%; transform: translateY(-50%);
      background: var(--surface-2); border: 1px solid var(--line); padding: 4px 10px; border-radius: 6px; white-space: nowrap; color: var(--text);
    }
    .sidebar.is-expanded { box-shadow: 20px 0 60px rgba(0,0,0,.5); background: var(--bg-2); }
    .rail-pin {
      display: grid; place-items: center; position: absolute; right: -13px; top: 74px; width: 26px; height: 26px;
      border-radius: 50%; border: 1px solid var(--line); background: var(--surface-2); cursor: pointer;
    }
    .sidebar.is-expanded .rail-pin svg { transform: rotate(180deg); }
  }

  /* ---- Mobile: top bar + drawer ---- */
  @media (max-width: 767px) {
    .topbar {
      display: flex; position: fixed; inset: 0 0 auto 0; height: 60px; z-index: 90; align-items: center; justify-content: space-between;
      padding: 0 var(--s2); background: color-mix(in srgb, var(--bg) 90%, transparent); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line);
    }
    .brand--small { font-family: var(--font-serif); font-size: 1.2rem; }
    .brand--small .brand__mark { width: 24px; height: 24px; }
    .topbar__quick { display: flex; align-items: center; gap: 14px; }
    .topbar__link { font-family: var(--font-mono); font-size: .7rem; letter-spacing: .1em; text-transform: uppercase; text-decoration: none; color: var(--text-2); }
    .menu-btn { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 10px; background: var(--surface); display: grid; place-items: center; cursor: pointer; }
    .menu-btn__bars, .menu-btn__bars::before, .menu-btn__bars::after { display: block; width: 18px; height: 1.5px; background: var(--text); position: relative; content: ''; }
    .menu-btn__bars::before { position: absolute; top: -6px; } .menu-btn__bars::after { position: absolute; top: 6px; }
    .sidebar { width: min(86vw, 320px); transform: translateX(-102%); z-index: 120; background: var(--bg-2); }
    .sidebar.is-open { transform: none; box-shadow: 20px 0 80px rgba(0,0,0,.6); }
    .scrim:not([hidden]) { display: block; position: fixed; inset: 0; background: rgba(0,0,0,.55); z-index: 110; }
  }
</style>
