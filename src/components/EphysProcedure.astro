---
/**
 * "How we record": zoomable, step-by-step schematics of the two electrophysiology procedures
 * (acute-slice field recordings / LTP, and chronic video-EEG). GSAP tweens the SVG viewBox
 * between steps so the visitor zooms from the whole rig down to the electrode tips.
 * Illustrative schematics — typical parameters, not lab data.
 */
import Label from './Label.astro';
import { fepspAt, fepspPath, STIM_MS, VOLLEY_MS, ONSET_MS, TAU_MS } from '../lib/fepsp';

// --- tiny deterministic helpers for illustrative traces (build time) ---
let seed = 5; const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
// Screen: fEPSPs before (grey) and after LTP (green), 0–20 ms; 0.025 mV per px
const scr = { x: 872, y: 268, w: 272, mvPerPx: 0.025, tMax: 20 };
const tx = (t: number) => scr.x + (t / scr.tMax) * scr.w;
const vy = (v: number) => scr.y - v / scr.mvPerPx;
// initial slope: 20–60 % of the rise of the potentiated response
const s0 = ONSET_MS + 0.12 * TAU_MS, s1 = ONSET_MS + 0.5 * TAU_MS;
const slope = { x1: tx(s0), y1: vy(fepspAt(s0, 1.55)), x2: tx(s1), y2: vy(fepspAt(s1, 1.55)) };
const ext = 0.45; // extend the slope line a little beyond the measured segment
const slopeLine = { x1: slope.x1 - (slope.x2 - slope.x1) * ext, y1: slope.y1 - (slope.y2 - slope.y1) * ext, x2: slope.x2 + (slope.x2 - slope.x1) * ext, y2: slope.y2 + (slope.y2 - slope.y1) * ext };
const ltpPts = Array.from({ length: 60 }, (_, i) => {
  const m = i - 15, base = 100, v = m < 0 ? base : 150 + 80 * Math.exp(-m / 2.5);
  return { x: 842 + i * 5.1, y: 452 - (v + (rnd() - 0.5) * 10 - 80) * 0.55 };
});
let eeg = 'M840 300';
for (let i = 1; i <= 300; i++) {
  const x = 840 + i, t = i / 300;
  const seizure = t > 0.55 && t < 0.78 ? 1 : 0;
  const spike = t > 0.3 && rnd() < 0.04 + 0.08 * (t > 0.45 ? 1 : 0) ? -(10 + rnd() * 18) : 0;
  const amp = 2.5 + seizure * 16 * Math.sin(Math.PI * (t - 0.55) / 0.23);
  eeg += ` L${x} ${(300 + (rnd() - 0.5) * amp * 2 + spike).toFixed(1)}`;
}
const ticks = Array.from({ length: 70 }, () => 840 + 90 + rnd() * 210).sort((a, b) => a - b);

const slice = [
  { box: '0 0 1200 700', title: 'The rig', plain: 'A living brain slice sits in a recording chamber, continuously bathed in oxygenated artificial cerebrospinal fluid (ACSF). Micromanipulators position two electrodes; an amplifier and stimulator connect them to the computer.', expert: 'Submerged or interface chamber, perfusion with carbogenated ACSF (typically 2–3 ml/min, 30–32 °C).' },
  { box: '228 236 420 245', title: 'Acute hippocampal slice', plain: 'The brain is cut into 300–400 µm thick slices with a vibratome. A transverse slice keeps the hippocampal circuit intact: entorhinal cortex → dentate gyrus → CA3 → CA1. A small grid holds it in place.', expert: 'Slices recover ≥ 1 h before recording; the CA3→CA1 Schaffer-collateral pathway is preserved within the slice plane.' },
  { box: '355 300 180 105', title: 'Electrodes in CA1', plain: 'A stimulating electrode activates the Schaffer collaterals — axons coming from CA3. A fine glass electrode in CA1 stratum radiatum picks up the combined synaptic response of many neurons.', expert: 'Bipolar stimulation electrode in proximal CA1 s. radiatum (towards CA2); ACSF-filled glass pipette (1–3 MΩ) in s. radiatum a few hundred µm further along CA1.' },
  { box: '822 200 344 200', title: 'Stimulate & record', plain: 'Each brief pulse first gives a stimulus artefact and a small fibre volley (the axons firing), then the field EPSP: a negative deflection, because positive ions flow into the dendrites at the activated synapses. Its initial slope measures synaptic strength.', expert: 'Test pulses every 15–30 s at ~30–50 % of the maximal response; slope measured on the early part of the falling phase, clear of the fibre volley. After LTP the fEPSP grows while the fibre volley stays the same.' },
  { box: '815 330 370 216', title: 'Induce LTP', plain: 'After a stable baseline, a short theta-burst stimulus is given. If the synapses strengthen, the response stays larger for an hour or more — long-term potentiation, a cellular model of memory.', expert: 'Theta-burst stimulation (bursts of 4 pulses at 100 Hz, every 200 ms); potentiation quantified 50–60 min after induction relative to baseline.' },
];
const vivo = [
  { box: '0 0 1200 700', title: 'Video-EEG setup', plain: 'The mouse moves freely in its home cage. A light cable and a rotating commutator connect the implanted electrodes to the amplifier, while a camera films behaviour in synchrony with the EEG.', expert: 'Tethered recording through a low-torque commutator; synchronised video for seizure scoring and sleep/wake staging.' },
  { box: '376 414 128 75', title: 'Electrode implantation', plain: 'Under anaesthesia, small screw electrodes are placed on the skull over the cortex, a reference over the cerebellum, and fine wires in the neck muscles record muscle tone (EMG). Mice recover for about a week before recording.', expert: 'Epidural screw electrodes, cerebellar reference/ground, bilateral nuchal EMG; stereotaxic coordinates relative to bregma.' },
  { box: '815 196 370 216', title: 'Recording', plain: 'Hours of continuous EEG are recorded. In an acute seizure model, injections (arrows) make the network over-excitable: epileptic spikes and seizures appear.', expert: 'Continuous acquisition over hours; baseline period followed by systemic injections, e.g. kainic acid.' },
  { box: '815 250 370 216', title: 'Analysis', plain: 'Spikes are detected automatically and seizures are identified from changes in signal power, then compared between groups of animals.', expert: 'Spike detection e.g. by thresholding the Teager–Kaiser energy; seizures from 20–60 Hz power; cumulative counts compared between genotypes.' },
];
---
<div class="ep" data-ep>
  <div class="ep__top">
    <div class="seg" role="tablist" aria-label="Procedure">
      <button role="tab" aria-selected="true" data-proc="slice">Brain slice · LTP</button>
      <button role="tab" aria-selected="false" data-proc="vivo">In vivo · video-EEG</button>
    </div>
    <div class="ep__ctl">
      <button class="btn btn--sm" data-prev aria-label="Previous step">←</button>
      <button class="btn btn--sm" data-play aria-pressed="false">▶ Walk through</button>
      <button class="btn btn--sm" data-next aria-label="Next step">→</button>
    </div>
  </div>

  {[['slice', slice], ['vivo', vivo]].map(([id, steps]) => (
    <div class="ep__proc" data-panel={id} hidden={id !== 'slice'} data-steps={JSON.stringify((steps as typeof slice).map((s) => s.box))}>
      <div class="ep__stage">
        <svg viewBox="0 0 1200 700" data-svg data-step="0" role="img" aria-label={id === 'slice' ? 'Schematic of an acute-slice field recording setup: perfused recording chamber with a hippocampal slice, stimulating and recording electrodes in CA1, amplifier and screen.' : 'Schematic of a video-EEG setup: mouse in a cage with an implanted headstage and cable to a commutator, camera, amplifier and screen.'}>
          <defs>
            <radialGradient id={`acsf-${id}`} cx="50%" cy="45%" r="60%"><stop offset="0" stop-color="#12324a" /><stop offset="1" stop-color="#0a1824" /></radialGradient>
            <linearGradient id={`glass-${id}`} x1="0" x2="1"><stop offset="0" stop-color="#bfe9ff" stop-opacity=".55" /><stop offset="1" stop-color="#7fb7d6" stop-opacity=".25" /></linearGradient>
          </defs>
          <rect width="1200" height="700" fill="#070a10" />

          {/* ---------------- shared: amplifier + screen ---------------- */}
          <g class="hw">
            <rect x="820" y="80" width="350" height="86" rx="10" class="box" />
            <text x="840" y="112" class="t-md">Amplifier &amp; stimulator</text>
            {[0, 1, 2, 3, 4].map((i) => <circle cx={850 + i * 26} cy="140" r="7" class="knob" />)}
            <rect x="1020" y="128" width="130" height="22" rx="4" class="lcd" />
            <rect x="820" y="196" width="350" height="350" rx="12" class="box" />
            <rect x="832" y="208" width="326" height="326" rx="6" fill="#03060a" />
            <text x="842" y="226" class="t-xs dim">{id === 'slice' ? 'fEPSP · CA1 stratum radiatum' : 'EEG (µV) · hours'}</text>
            <text x="842" y="364" class="t-xs dim">{id === 'slice' ? 'fEPSP slope (% of baseline) · min' : 'Detected events'}</text>
            <line x1="842" x2="1150" y1="350" y2="350" class="grid" />
          </g>

          {id === 'slice' ? (
            <>
              {/* perfusion */}
              <path d="M40 395 H190" class="tube" /><path d="M40 395 H190" class="flow" />
              <path d="M670 395 H760 V650" class="tube" /><path d="M670 395 H760 V650" class="flow" />
              <text x="44" y="380" class="t-sm acsf">ACSF in (O₂/CO₂)</text>
              <text x="690" y="380" class="t-sm acsf">out</text>
              {/* chamber */}
              <circle cx="430" cy="395" r="240" class="chamber" />
              <circle cx="430" cy="395" r="226" fill={`url(#acsf-${id})`} />
              {/* acute transverse hippocampal slice (local coordinates, scaled into the chamber) */}
              <g transform="translate(267 268) scale(0.68)" class="hc">
                {/* tissue: hippocampus with subiculum and a strip of entorhinal cortex */}
                <path d="M30 120 C40 60 150 22 290 30 C390 36 470 86 492 168 C510 236 478 312 404 330 C330 346 250 340 190 318 C120 296 40 330 8 286 C-12 250 18 180 30 120 Z" class="tissue" />
                {/* alveus (axons along the outer surface) */}
                <path d="M44 128 C70 64 170 36 290 44 C380 50 450 96 470 160" class="alveus" />
                {/* hippocampal fissure between CA1 and the dentate gyrus */}
                <path d="M120 192 C180 176 260 176 340 196" class="fissure" />
                {/* pyramidal cell layer: CA1 → CA2 → CA3, ending in the hilus */}
                <path d="M68 168 C96 104 190 74 290 80 C360 85 420 112 446 162" class="ca1" />
                <path d="M446 162 C470 212 456 262 410 280 C372 294 336 282 314 262" class="ca3" />
                {/* dentate gyrus granule cell layer: upper and lower blade, opening towards CA3 */}
                <path d="M346 214 C300 196 238 204 220 240 C206 268 240 302 334 302" class="dg" />
                {/* Schaffer collaterals: CA3 axons to CA1 stratum radiatum */}
                <g class="sc">
                  <path d="M428 244 C412 186 392 140 336 126 C270 112 190 116 110 138" />
                  <path d="M418 256 C404 196 382 152 330 140 C262 128 186 132 104 152" />
                  <path d="M436 230 C424 176 402 126 344 114 C280 102 200 104 120 124" />
                </g>
                {/* mossy fibres: dentate granule cells to CA3 (stratum lucidum) */}
                <path d="M300 252 C340 254 392 268 424 248 C446 230 444 188 428 150" class="mf" />
                {/* perforant path from entorhinal cortex to the dentate gyrus and CA1 */}
                <path d="M30 262 C80 236 150 206 236 196" class="pp" />
                {/* action potentials travelling along the Schaffer collaterals, from stimulation to recording site */}
                <circle r="4" class="pulse"><animateMotion dur="1.3s" repeatCount="indefinite" path="M346 125 C300 118 250 118 192 124" /></circle>
                <circle r="4" class="pulse"><animateMotion dur="1.3s" begin="0.45s" repeatCount="indefinite" path="M346 125 C300 118 250 118 192 124" /></circle>
              </g>
              {/* harp */}
              <g class="harp"><path d="M262 300 C 300 520, 560 520, 600 300" />{[0, 1, 2, 3, 4, 5, 6].map((i) => <line x1={300 + i * 42} x2={300 + i * 42} y1="275" y2="505" />)}</g>
              {/* electrodes + manipulators */}
              <rect x="640" y="70" width="90" height="46" rx="6" class="manip" /><text x="648" y="62" class="t-sm dim">Manipulator</text>
              <path d="M685 116 L 503.5 352.5 L 500.5 351.5 L 676 112 Z" class="stim" />
              <rect x="150" y="70" width="90" height="46" rx="6" class="manip" />
              <path d="M195 116 L 395 353 L 398 352 L 210 112 Z" fill={`url(#glass-${id})`} class="pipette" />
              <path d="M396 350 L 220 110" class="pipette-wire" />
              {/* cables to amplifier */}
              <path d="M730 92 C 780 92, 790 110, 820 110" class="cable" />
              <path d="M240 92 C 420 20, 760 30, 820 100" class="cable" />
              {/* screen content: illustrative fEPSPs (0–20 ms) and LTP time course */}
              <defs><clipPath id="scr-clip"><rect x="832" y="208" width="326" height="146" /></clipPath></defs>
              <g clip-path="url(#scr-clip)">
                <path d={fepspPath(1.0, scr)} class="trace base" />
                <path d={fepspPath(1.55, scr)} class="trace post" />
              </g>
              <g class="annot">
                <text x={tx(STIM_MS) - 5} y={scr.y - 4} text-anchor="end" class="t-xs">stimulus</text>
                <text x={tx(VOLLEY_MS) + 6} y={vy(0.62)} class="t-xs">fibre volley</text>
                <path d={`M${tx(VOLLEY_MS) + 8} ${vy(0.52)} L${tx(VOLLEY_MS)} ${vy(-0.12)}`} class="lead" />
                <line x1={slopeLine.x1} y1={slopeLine.y1} x2={slopeLine.x2} y2={slopeLine.y2} class="slope" />
                <text x={slopeLine.x2 - 34} y={slopeLine.y2 + 14} class="t-xs">initial slope</text>
                <text x={tx(ONSET_MS + TAU_MS) + 34} y={vy(-1.5)} class="t-xs">fEPSP</text>
                <path d={`M${tx(17) - 40} 342 h${(5 / 20) * scr.w} M${tx(17) - 40 + (5 / 20) * scr.w} 342 v${-0.5 / 0.025}`} class="bars" />
                <text x={tx(17) - 40 + (2.5 / 20) * scr.w} y="338" text-anchor="middle" class="t-xs dim">5 ms</text>
                <text x={tx(17) - 44 + (5 / 20) * scr.w} y="318" text-anchor="end" class="t-xs dim">0.5 mV</text>
              </g>
              <g class="ltp">
                {ltpPts.map((p, i) => <circle cx={p.x} cy={p.y} r="2.4" class:list={['pt', { after: i >= 15 }]} />)}
                <line x1="918" x2="918" y1="372" y2="460" class="tbs" /><text x="922" y="384" class="t-xs">TBS</text>
                <line x1="842" x2="1150" y1="452" y2="452" class="grid" /><text x="1096" y="446" class="t-xs dim">100 %</text>
                {[0, 20, 40].map((m) => <text x={842 + (m + 15) * 5.1} y="474" text-anchor="middle" class="t-xs dim">{m}</text>)}
                <text x="1150" y="488" text-anchor="end" class="t-xs dim">min after TBS</text>
              </g>
              {/* labels per step (font sizes follow the zoom level) */}
              <g class="lbl" data-for="0">
                <text x="430" y="660" text-anchor="middle" class="t-lg">Recording chamber</text>
                <text x="995" y="580" text-anchor="middle" class="t-lg">Acquisition</text>
              </g>
              <g class="lbl" data-for="1">
                <text x="400" y="282" text-anchor="middle" class="t-s1">CA1</text>
                <text x="580" y="404" class="t-s1">CA3</text>
                <text x="548" y="324" class="t-s1 dim">CA2</text>
                <text x="404" y="440" text-anchor="middle" class="t-s1">DG</text>
                <text x="276" y="356" class="t-s2 dim">subiculum</text>
                <text x="250" y="462" class="t-s2 dim">entorhinal cortex</text>
                <text x="470" y="381" text-anchor="middle" class="t-s2 mfc">mossy fibres</text>
                <text x="372" y="345" text-anchor="middle" class="t-s2 scc">Schaffer collaterals</text>
                <text x="300" y="413" class="t-s2 ppc">perforant path</text>
                <text x="350" y="262" class="t-s2 dim">alveus</text>
              </g>
              <g class="lbl" data-for="2">
                <text x="505" y="346" class="t-s3 stimc">stimulation</text>
                <text x="392" y="346" text-anchor="end" class="t-s3 recc">recording</text>
                <text x="448" y="361" text-anchor="middle" class="t-s3 scc">Schaffer collaterals</text>
                <text x="414" y="313" class="t-s3 dim">stratum oriens</text>
                <text x="414" y="323.5" class="t-s3 onband">stratum pyramidale</text>
                <text x="414" y="336" class="t-s3 dim">stratum radiatum</text>
                <text x="414" y="378" class="t-s3 dim">str. lacunosum-moleculare</text>
                <text x="414" y="389" class="t-s3 dim">hippocampal fissure</text>
              </g>
            </>
          ) : (
            <>
              {/* cage */}
              <rect x="130" y="250" width="500" height="380" rx="16" class="cage" />
              {Array.from({ length: 140 }, () => <circle cx={150 + rnd() * 460} cy={270 + rnd() * 340} r={1 + rnd() * 1.6} class="bedding" />)}
              {/* camera */}
              <g class="cam"><rect x="40" y="150" width="70" height="44" rx="8" /><rect x="110" y="160" width="22" height="24" rx="4" /><circle cx="64" cy="172" r="12" class="lens" /></g>
              <path d="M132 172 L 300 300 M132 172 L 420 280" class="fovline" />
              {/* commutator + tether */}
              <rect x="420" y="60" width="54" height="44" rx="8" class="manip" /><text x="482" y="88" class="t-sm dim">Commutator</text>
              <path d="M447 104 C 440 220, 470 330, 452 448" class="tether" />
              <path d="M474 82 C 640 70, 760 80, 820 110" class="cable" />
              {/* mouse (top view) */}
              <path d="M285 482 C 230 500, 200 540, 170 560" class="tail" />
              <ellipse cx="360" cy="470" rx="78" ry="44" class="mouse" transform="rotate(-8 360 470)" />
              <ellipse cx="445" cy="455" rx="36" ry="27" class="mouse" />
              <circle cx="424" cy="433" r="11" class="ear" /><circle cx="424" cy="478" r="11" class="ear" />
              <circle cx="481" cy="455" r="3" class="nose" />
              {/* skull detail (visible when zoomed) */}
              <g class="skull">
                <path d="M412 455 C 412 440, 432 432, 452 434 C 470 436, 478 446, 478 455 C 478 464, 470 474, 452 476 C 432 478, 412 470, 412 455 Z" class="bone" />
                <line x1="414" y1="455" x2="477" y2="455" class="suture" />
                <line x1="448" y1="436" x2="448" y2="474" class="suture" /><line x1="428" y1="438" x2="428" y2="472" class="suture" />
                <text x="449.5" y="440" class="t-micro dim">bregma</text><text x="429.5" y="440" class="t-micro dim">lambda</text>
                {[[460, 447], [460, 463], [438, 447], [438, 463]].map(([x, y]) => <circle cx={x} cy={y} r="2" class="screw" />)}
                <circle cx="419" cy="455" r="1.8" class="ref" />
                <path d="M413 451 L 398 447 M413 459 L 398 463" class="emg" />
                <rect x="452" y="452" width="4" height="6" class="headstage" />
              </g>
              <g class="lbl" data-for="1">
                <text x="460" y="430" class="t-micro" text-anchor="middle">EEG screw electrodes</text>
                <path d="M455 431 L 459 445 M462 431 L 460 445" class="leader" />
                <text x="408" y="441" class="t-micro" text-anchor="end">reference (cerebellum)</text>
                <path d="M409 441.5 L 418 454" class="leader" />
                <text x="396" y="470" class="t-micro" text-anchor="end">EMG (neck)</text>
                <text x="453" y="482" class="t-micro" text-anchor="middle">headstage connector</text>
                <path d="M453 479.5 L 454 459" class="leader" />
              </g>
              {/* screen content */}
              <path d={eeg} class="trace eeg" />
              <g class="annot"><path d="M1002 236 l -5 -8 h 10 z M1022 236 l -5 -8 h 10 z" class="ka" /><text x="1030" y="234" class="t-xs">injections</text></g>
              <g class="ltp">
                <rect x={840 + 300 * 0.55} y="372" width={300 * 0.23} height="40" class="seizure" />
                {ticks.map((x) => <line x1={x} x2={x} y1="420" y2="438" class="tick" />)}
                <text x="842" y="452" class="t-xs dim">spikes</text><text x={845 + 300 * 0.55} y="404" class="t-xs">seizure</text>
              </g>
              <g class="lbl" data-for="0">
                <text x="380" y="660" text-anchor="middle" class="t-lg">Home cage</text>
                <text x="74" y="222" text-anchor="middle" class="t-sm dim">Camera</text>
                <text x="995" y="580" text-anchor="middle" class="t-lg">Acquisition</text>
              </g>
            </>
          )}
        </svg>
      </div>

      <ol class="ep__steps" role="list">
        {(steps as typeof slice).map((s, i) => (
          <li>
            <button class:list={['ep__step', { 'is-on': i === 0 }]} data-goto={i} aria-current={i === 0 ? 'step' : undefined}>
              <span class="mono">{String(i + 1).padStart(2, '0')}</span> {s.title}
            </button>
          </li>
        ))}
      </ol>
      <div class="ep__text" aria-live="polite">
        {(steps as typeof slice).map((s, i) => (
          <div data-text={i} hidden={i !== 0}>
            <h4>{s.title}</h4>
            <p>{s.plain}</p>
            <p class="small muted"><span class="mono">Detail · </span>{s.expert}</p>
          </div>
        ))}
      </div>
    </div>
  ))}

  <p class="ep__note small"><Label kind="schematic" /> <span class="muted">Schematic of the general procedures with typical parameters; not to scale and not lab data.</span></p>
</div>

<style>
  .ep { display: grid; gap: var(--s2); }
  .ep__top { display: flex; justify-content: space-between; gap: var(--s2); flex-wrap: wrap; align-items: center; }
  .seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); flex-wrap: wrap; }
  .seg button { border: 0; background: transparent; padding: .45em 1.1em; border-radius: 999px; cursor: pointer; font-size: .88rem; color: var(--text-2); }
  .seg button[aria-selected='true'] { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
  .ep__ctl { display: flex; gap: 6px; }
  .ep__proc { display: grid; grid-template-columns: minmax(0, 1fr) 260px; grid-template-areas: 'stage steps' 'text text'; gap: var(--s2) var(--s3); }
  .ep__proc[hidden] { display: none; }
  @media (max-width: 960px) { .ep__proc { grid-template-columns: 1fr; grid-template-areas: 'stage' 'steps' 'text'; } }
  .ep__stage { grid-area: stage; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; background: #070a10; aspect-ratio: 12 / 7; }
  .ep__stage svg { width: 100%; height: 100%; display: block; }
  .ep__steps { grid-area: steps; list-style: none; margin: 0; padding: 0; display: grid; gap: 4px; align-content: start; counter-reset: s; }
  @media (max-width: 960px) { .ep__steps { display: flex; flex-wrap: wrap; } }
  .ep__step { width: 100%; text-align: left; background: transparent; border: 0; border-left: 2px solid var(--line); padding: 10px 14px; cursor: pointer; color: var(--text-2); font-family: var(--font-serif); font-size: 1.05rem; transition: color .2s, border-color .2s, background .2s; }
  .ep__step .mono { font-size: .72rem; color: var(--text-3); margin-right: 6px; }
  .ep__step:hover { color: var(--text); background: var(--surface); }
  .ep__step.is-on { color: var(--accent); border-color: var(--accent); }
  .ep__step.is-on .mono { color: var(--accent); }
  .ep__text { grid-area: text; min-height: 7.5em; }
  .ep__text h4 { font-family: var(--font-serif); font-size: 1.3rem; font-weight: 400; margin: 0 0 6px; }
  .ep__text p { margin: 0 0 6px; }
  .ep__note { display: flex; gap: var(--s2); align-items: center; margin: 0; }

  /* --- SVG styling --- */
  svg :global(.box) { fill: #0e1522; stroke: #26324a; }
  svg :global(.knob) { fill: #1c2638; stroke: #3a4a66; }
  svg :global(.lcd) { fill: #0b2a1b; stroke: #1e5a3a; }
  svg :global(.grid) { stroke: #1b2434; stroke-dasharray: 2 4; }
  svg :global(text) { fill: var(--text); font-family: var(--font-sans); }
  svg :global(.t-lg) { font-size: 22px; font-family: var(--font-serif); }
  svg :global(.t-md) { font-size: 17px; }
  svg :global(.t-sm) { font-size: 13px; }
  svg :global(.t-xs) { font-size: 10px; font-family: var(--font-mono); }
  svg :global(.t-xxs) { font-size: 6px; font-family: var(--font-mono); }
  svg :global(.t-micro) { font-size: 2.4px; font-family: var(--font-mono); }
  svg :global(.leader) { stroke: var(--text-2); stroke-width: .18; fill: none; }
  svg :global(.dim) { fill: var(--text-3); }
  svg :global(.acsf) { fill: var(--blue); }
  svg :global(.tube) { stroke: #1a3a55; stroke-width: 16; fill: none; stroke-linecap: round; }
  svg :global(.flow) { stroke: var(--blue); stroke-width: 3; fill: none; stroke-dasharray: 6 14; animation: ep-flow 1.4s linear infinite; }
  svg :global(.chamber) { fill: #0c1520; stroke: #2a3b4f; stroke-width: 3; }
  svg :global(.slice) { fill: rgba(232, 220, 200, .12); stroke: rgba(232, 220, 200, .35); stroke-width: 1.5; }
  svg :global(.tissue) { fill: rgba(232, 220, 200, .13); stroke: rgba(232, 220, 200, .4); stroke-width: 2; }
  svg :global(.alveus) { fill: none; stroke: rgba(240, 236, 226, .28); stroke-width: 7; stroke-linecap: round; }
  svg :global(.fissure) { fill: none; stroke: rgba(7, 10, 16, .9); stroke-width: 3; stroke-dasharray: 6 4; }
  svg :global(.ca1) { fill: none; stroke: var(--green); stroke-width: 13; stroke-linecap: round; opacity: .9; }
  svg :global(.ca3) { fill: none; stroke: var(--green); stroke-width: 19; stroke-linecap: round; opacity: .6; }
  svg :global(.dg) { fill: none; stroke: var(--blue); stroke-width: 11; stroke-linecap: round; opacity: .9; }
  svg :global(.sc path) { fill: none; stroke: var(--magenta); stroke-width: 1.6; stroke-dasharray: 5 4; opacity: .75; }
  svg :global(.mf) { fill: none; stroke: var(--amber); stroke-width: 2.4; stroke-dasharray: 2 4; opacity: .8; stroke-linecap: round; }
  svg :global(.pp) { fill: none; stroke: #b9a8ff; stroke-width: 2; stroke-dasharray: 1 4; opacity: .8; stroke-linecap: round; }
  svg :global(.t-s1) { font-size: 12px; font-family: var(--font-sans); font-weight: 600; }
  svg :global(.t-s2) { font-size: 7px; font-family: var(--font-mono); }
  svg :global(.t-s3) { font-size: 4.2px; font-family: var(--font-mono); }
  svg :global(.onband) { fill: #06301c; font-weight: 600; }
  svg :global(.mfc) { fill: var(--amber); } svg :global(.scc) { fill: var(--magenta); } svg :global(.ppc) { fill: #b9a8ff; }
  svg :global(.stimmark) { stroke: var(--amber); stroke-width: 1.4; }
  svg :global(.lead) { stroke: var(--text-2); stroke-width: .8; }
  svg :global(.bars) { stroke: var(--text-2); stroke-width: 1.2; fill: none; }
  svg :global(.harp path), svg :global(.harp line) { fill: none; stroke: rgba(255,255,255,.18); stroke-width: 1; }
  svg :global(.manip) { fill: #182132; stroke: #34425c; }
  svg :global(.stim) { fill: #c9c9d1; stroke: #e2e2ea; stroke-width: .6; }
  svg :global(.pipette) { stroke: rgba(191,233,255,.6); stroke-width: .6; }
  svg :global(.pipette-wire) { stroke: #d4b45a; stroke-width: .5; }
  svg :global(.cable) { fill: none; stroke: #2a3550; stroke-width: 3; }
  svg :global(.pulse) { fill: #fff; filter: drop-shadow(0 0 4px var(--magenta)); opacity: 0; transition: opacity .4s; }
  svg :global(.trace) { fill: none; stroke-width: 1.6; stroke-dasharray: 1600; stroke-dashoffset: 1600; transition: stroke-dashoffset 1.8s ease; }
  svg :global(.trace.base) { stroke: var(--text-3); }
  svg :global(.trace.post) { stroke: var(--green); transition-delay: .9s; }
  svg :global(.trace.eeg) { stroke: var(--red); stroke-width: 1; }
  svg :global(.annot), svg :global(.ltp), svg :global(.lbl) { opacity: 0; transition: opacity .6s; }
  svg :global(.slope) { stroke: var(--amber); stroke-width: 1.4; stroke-dasharray: 4 2; }
  svg :global(.annot text), svg :global(.ltp text) { fill: var(--text-2); }
  svg :global(.pt) { fill: var(--text-3); opacity: 0; transition: opacity .3s; }
  svg :global(.pt.after) { fill: var(--green); }
  svg :global(.tbs) { stroke: var(--amber); stroke-dasharray: 3 3; }
  svg :global(.stimc) { fill: #e2e2ea; } svg :global(.recc) { fill: #bfe9ff; }
  svg :global(.cage) { fill: #0d1219; stroke: #2a3346; stroke-width: 3; }
  svg :global(.bedding) { fill: #2a2418; }
  svg :global(.cam rect) { fill: #1a2233; stroke: #3a4763; } svg :global(.lens) { fill: #0a0f18; stroke: var(--blue); stroke-width: 2; }
  svg :global(.fovline) { stroke: rgba(90,169,255,.25); stroke-dasharray: 4 6; fill: none; }
  svg :global(.tether) { fill: none; stroke: #8a95a8; stroke-width: 1.4; }
  svg :global(.mouse) { fill: #c9c2b8; } svg :global(.ear) { fill: #d8b8b0; } svg :global(.nose) { fill: #e09a9a; }
  svg :global(.tail) { fill: none; stroke: #d8b8b0; stroke-width: 5; stroke-linecap: round; }
  svg :global(.bone) { fill: #efe6d6; stroke: #bdb2a0; stroke-width: .4; }
  svg :global(.suture) { stroke: #a99d88; stroke-width: .25; }
  svg :global(.screw) { fill: #9aa3ad; stroke: #59616b; stroke-width: .3; }
  svg :global(.ref) { fill: var(--amber); }
  svg :global(.emg) { stroke: var(--red); stroke-width: .4; fill: none; }
  svg :global(.headstage) { fill: #2b3a55; }
  svg :global(.skull) { opacity: 0; transition: opacity .8s; }
  svg :global(.ka) { fill: var(--amber); }
  svg :global(.seizure) { fill: color-mix(in srgb, var(--red) 18%, transparent); }
  svg :global(.tick) { stroke: var(--amber); stroke-width: 1; }

  /* step-dependent visibility */
  svg[data-step='0'] :global(.lbl[data-for='0']), svg[data-step='1'] :global(.lbl[data-for='1']), svg[data-step='2'] :global(.lbl[data-for='2']) { opacity: 1; }
  [data-panel='slice'] svg:is([data-step='2'], [data-step='3'], [data-step='4']) :global(.pulse) { opacity: 1; }
  [data-panel='slice'] svg:is([data-step='3'], [data-step='4']) :global(.trace.base),
  [data-panel='slice'] svg:is([data-step='3'], [data-step='4']) :global(.trace.post) { stroke-dashoffset: 0; }
  [data-panel='slice'] svg[data-step='3'] :global(.annot) { opacity: 1; }
  [data-panel='slice'] svg[data-step='4'] :global(.ltp), [data-panel='slice'] svg[data-step='4'] :global(.pt) { opacity: 1; }
  [data-panel='vivo'] svg:not([data-step='0']) :global(.skull) { opacity: 1; }
  [data-panel='vivo'] svg:is([data-step='2'], [data-step='3']) :global(.trace.eeg) { stroke-dashoffset: 0; }
  [data-panel='vivo'] svg:is([data-step='2'], [data-step='3']) :global(.annot) { opacity: 1; }
  [data-panel='vivo'] svg[data-step='3'] :global(.ltp) { opacity: 1; }
  @keyframes ep-flow { to { stroke-dashoffset: -40; } }
  :global(:root[data-motion='off']) svg :global(.flow) { animation: none; }
</style>

<script>
  import { gsap } from 'gsap';
  const motionOK = () => document.documentElement.dataset.motion !== 'off';

  document.querySelectorAll<HTMLElement>('[data-ep]').forEach((root) => {
    const panels = [...root.querySelectorAll<HTMLElement>('[data-panel]')];
    let panel = panels[0], step = 0, timer = 0;
    const playBtn = root.querySelector<HTMLButtonElement>('[data-play]')!;

    const go = (i: number, instant = false) => {
      const boxes: string[] = JSON.parse(panel.dataset.steps!);
      step = (i + boxes.length) % boxes.length;
      const svg = panel.querySelector<SVGSVGElement>('[data-svg]')!;
      svg.dataset.step = String(step);
      panel.querySelectorAll<HTMLElement>('[data-goto]').forEach((b) => {
        const on = +b.dataset.goto! === step;
        b.classList.toggle('is-on', on); on ? b.setAttribute('aria-current', 'step') : b.removeAttribute('aria-current');
      });
      panel.querySelectorAll<HTMLElement>('[data-text]').forEach((t) => (t.hidden = +t.dataset.text! !== step));
      // stagger the LTP time-course points in as the experiment "runs"
      panel.querySelectorAll<SVGCircleElement>('.pt').forEach((pt, k) => (pt.style.transitionDelay = `${k * 25}ms`));
      gsap.killTweensOf(svg);
      if (motionOK() && !instant) gsap.to(svg, { attr: { viewBox: boxes[step] }, duration: 1.6, ease: 'power3.inOut' });
      else svg.setAttribute('viewBox', boxes[step]);
    };
    const stopPlay = () => { clearInterval(timer); timer = 0; playBtn.setAttribute('aria-pressed', 'false'); playBtn.textContent = '▶ Walk through'; };

    root.querySelectorAll<HTMLButtonElement>('[data-goto]').forEach((b) => b.addEventListener('click', () => { stopPlay(); go(+b.dataset.goto!); }));
    root.querySelector('[data-prev]')!.addEventListener('click', () => { stopPlay(); go(step - 1); });
    root.querySelector('[data-next]')!.addEventListener('click', () => { stopPlay(); go(step + 1); });
    playBtn.addEventListener('click', () => {
      if (timer) return stopPlay();
      playBtn.setAttribute('aria-pressed', 'true'); playBtn.textContent = '❚❚ Pause';
      go(step + 1);
      timer = window.setInterval(() => go(step + 1), 5200);
    });
    root.querySelectorAll<HTMLButtonElement>('[data-proc]').forEach((t, _, all) => t.addEventListener('click', () => {
      stopPlay();
      all.forEach((x) => x.setAttribute('aria-selected', String(x === t)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== t.dataset.proc));
      panel = panels.find((p) => p.dataset.panel === t.dataset.proc)!;
      go(0, true);
    }));
    // keyboard: arrow keys move through steps when the explorer has focus
    root.addEventListener('keydown', (e) => {
      if ((e.target as HTMLElement).closest('input, select')) return;
      if (e.key === 'ArrowRight') { stopPlay(); go(step + 1); } else if (e.key === 'ArrowLeft') { stopPlay(); go(step - 1); }
    });
  });
</script>
