---
/** Ambient "fluorescence field": soft cells drift, occasionally flash (calcium-transient-like), and lean away from the pointer. Decorative only. */
---
<canvas class="fluo" data-fluo aria-hidden="true"></canvas>
<style>
  .fluo { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .9;
    mask-image: linear-gradient(90deg, transparent 0%, #000 35%, #000 100%); }
</style>
<script>
  document.querySelectorAll<HTMLCanvasElement>('[data-fluo]').forEach((canvas) => {
    const ctx = canvas.getContext('2d')!;
    const host = canvas.parentElement!;
    const motionOK = () => document.documentElement.dataset.motion !== 'off';
    let W = 0, H = 0, raf = 0, visible = true;
    let s = 17; const r = () => ((s = (s * 16807) % 2147483647) / 2147483647);
    const css = (v: string) => getComputedStyle(canvas).getPropertyValue(v).trim();
    type Cell = { x: number; y: number; r: number; vx: number; vy: number; hue: string; act: number; base: number };
    let cells: Cell[] = [];
    const pointer = { x: -999, y: -999 };

    const resize = () => {
      const dpr = Math.min(devicePixelRatio, 2);
      W = canvas.clientWidth; H = canvas.clientHeight;
      canvas.width = W * dpr; canvas.height = H * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const n = Math.round((W * H) / 13000);
      const hues = ['--accent', '--accent', '--accent', '--blue', '--magenta'];
      cells = Array.from({ length: n }, () => ({
        x: r() * W, y: r() * H, r: 3 + r() * 9, vx: (r() - 0.5) * 0.15, vy: (r() - 0.5) * 0.12,
        hue: hues[Math.floor(r() * hues.length)], act: 0, base: 0.08 + r() * 0.16,
      }));
      draw(false);
    };

    const draw = (advance = true) => {
      ctx.clearRect(0, 0, W, H);
      ctx.globalCompositeOperation = 'lighter';
      const col: Record<string, string> = {};
      for (const c of cells) {
        if (advance) {
          c.x += c.vx; c.y += c.vy;
          if (c.x < -20) c.x = W + 20; if (c.x > W + 20) c.x = -20; if (c.y < -20) c.y = H + 20; if (c.y > H + 20) c.y = -20;
          const dx = c.x - pointer.x, dy = c.y - pointer.y, d2 = dx * dx + dy * dy;
          if (d2 < 22000) { const f = (1 - d2 / 22000) * 0.9; c.x += (dx / Math.sqrt(d2 + 1)) * f; c.y += (dy / Math.sqrt(d2 + 1)) * f; }
          if (c.act <= 0.01 && r() < 0.0025) c.act = 1; // transient onset
          c.act *= 0.965;                                // decay
        }
        const color = (col[c.hue] ??= css(c.hue) || '#4dff9a');
        const a = c.base + c.act * 0.85, rad = c.r * (1 + c.act * 0.6);
        const g = ctx.createRadialGradient(c.x, c.y, 0, c.x, c.y, rad * 2.2);
        g.addColorStop(0, color); g.addColorStop(0.35, color); g.addColorStop(1, 'transparent');
        ctx.globalAlpha = Math.min(1, a);
        ctx.fillStyle = g; ctx.beginPath(); ctx.arc(c.x, c.y, rad * 2.2, 0, Math.PI * 2); ctx.fill();
      }
      ctx.globalAlpha = 1; ctx.globalCompositeOperation = 'source-over';
    };
    const loop = () => { draw(); raf = requestAnimationFrame(loop); };
    const run = () => { cancelAnimationFrame(raf); raf = 0; if (visible && motionOK()) raf = requestAnimationFrame(loop); else draw(false); };

    host.addEventListener('pointermove', (e) => { const b = canvas.getBoundingClientRect(); pointer.x = e.clientX - b.left; pointer.y = e.clientY - b.top; });
    host.addEventListener('pointerleave', () => { pointer.x = pointer.y = -999; });
    new ResizeObserver(resize).observe(canvas);
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; run(); }).observe(canvas);
    addEventListener('agz:motion', run);
  });
</script>
