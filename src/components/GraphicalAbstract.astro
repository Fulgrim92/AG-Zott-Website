---
/**
 * Scroll-driven graphical abstract (illustrative, literature-based):
 * told from a real recording down to the synapse: real data → circuit imbalance → vicious cycle →
 * β-amyloid blocks glutamate reuptake → healthy synapse. Text and references: src/data/home.json → abstract.
 */
import home from '../data/home.json';
import assets from '../data/assets.json';
import Label from './Label.astro';
import { url } from '../lib/url';
const A = home.abstract;
const refs = home.references as Record<string, { short: string; full: string; doi: string }>;
const rec = assets.twoPhoton.recordings[0];
---
<section class="ga" data-ga aria-labelledby="ga-h">
  <h3 id="ga-h" class="visually-hidden">{home.deep.parts[0]}</h3>
  <div class="ga__pin" data-ga-pin>
    <div class="ga__text">
      <div class="ga__meta">
        <span class="ga__count mono"><span data-ga-num>01</span> / 0{A.chapters.length}</span>
        <div class="ga__bar" aria-hidden="true"><i data-ga-bar></i></div>
      </div>
      <div class="ga__chapters" role="tablist" aria-label="Chapters" data-ga-tabs>
        {A.chapters.map((c, i) => <button role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-ga-tab={i} aria-label={c.title}><span></span></button>)}
      </div>
      <ol class="ga__list" role="list">
        {A.chapters.map((c, i) => (
          <li class:list={['ga__ch', { 'is-on': i === 0 }]} data-ga-ch={i}>
            <h4>{c.title}</h4>
            <p>{c.text}</p>
            <p class="ga__refs">
              {c.cite.map((k) => refs[k] && <a href={`https://doi.org/${refs[k].doi}`} title={refs[k].full} rel="noopener">{refs[k].short}</a>)}
            </p>
          </li>
        ))}
      </ol>
      <p class="ga__handoff" data-ga-handoff>{A.handoff} <span aria-hidden="true">↓</span></p>
    </div>

    <figure class="ga__stage" aria-label="Sequence from a real two-photon recording of CA1 neurons, through an illustrated CA1 population with hyperactive and silent neurons near a plaque, a self-amplifying cycle of hyperactivity and β-amyloid blocking glutamate reuptake, down to a healthy glutamatergic synapse.">
      <svg viewBox="0 0 1200 800" data-ga-svg aria-hidden="true" preserveAspectRatio="xMidYMid slice">
        <defs>
          <radialGradient id="ga-pre" cx="50%" cy="20%" r="80%"><stop offset="0" stop-color="#174a5c" /><stop offset="1" stop-color="#0c2a36" /></radialGradient>
          <radialGradient id="ga-post" cx="50%" cy="10%" r="90%"><stop offset="0" stop-color="#16454a" /><stop offset="1" stop-color="#0b2328" /></radialGradient>
          <radialGradient id="ga-astro" cx="50%" cy="50%" r="70%"><stop offset="0" stop-color="#2c2560" /><stop offset="1" stop-color="#1a1638" /></radialGradient>
          <radialGradient id="ga-ca" cx="50%" cy="30%" r="60%"><stop offset="0" stop-color="#4dff9a" stop-opacity=".95" /><stop offset=".5" stop-color="#4dff9a" stop-opacity=".35" /><stop offset="1" stop-color="#4dff9a" stop-opacity="0" /></radialGradient>
          <radialGradient id="ga-glow" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#fff" stop-opacity=".9" /><stop offset=".4" stop-color="#4dff9a" stop-opacity=".6" /><stop offset="1" stop-color="#4dff9a" stop-opacity="0" /></radialGradient>
          <radialGradient id="ga-focus" cx="50%" cy="50%" r="50%"><stop offset="0" stop-color="#fff" /><stop offset=".3" stop-color="#ff5a4a" stop-opacity=".9" /><stop offset="1" stop-color="#ff5a4a" stop-opacity="0" /></radialGradient>
          <linearGradient id="ga-beam" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#ff3b30" stop-opacity=".0" /><stop offset=".6" stop-color="#ff3b30" stop-opacity=".22" /><stop offset="1" stop-color="#ff7a59" stop-opacity=".55" /></linearGradient>
          <filter id="ga-blur" x="-50%" y="-50%" width="200%" height="200%"><feGaussianBlur stdDeviation="6" /></filter>
          <pattern id="ga-grid" width="40" height="40" patternUnits="userSpaceOnUse"><path d="M40 0H0V40" fill="none" stroke="#5fd3c6" stroke-opacity=".05" /></pattern>
        </defs>
        <rect width="1200" height="800" fill="url(#ga-grid)" />

        <!-- ============ Synapse ============ -->
        <g id="ga-syn" data-ga-syn>
          <!-- astrocyte processes -->
          <g class="astro">
            <path d="M-20 215 C130 225 245 270 292 335 C318 372 300 420 240 438 C150 462 60 440 -20 452 Z" fill="url(#ga-astro)" stroke="#9b8cff" stroke-opacity=".55" stroke-width="2" />
            <path d="M1220 215 C1070 225 955 270 908 335 C882 372 900 420 960 438 C1050 462 1140 440 1220 452 Z" fill="url(#ga-astro)" stroke="#9b8cff" stroke-opacity=".55" stroke-width="2" />
          </g>
          <!-- presynaptic terminal -->
          <path d="M300 -20 C300 190 420 322 600 322 C780 322 900 190 900 -20 Z" fill="url(#ga-pre)" stroke="#5fd3c6" stroke-opacity=".7" stroke-width="2.5" />
          <path d="M318 -20 C318 180 432 306 600 306 C768 306 882 180 882 -20" fill="none" stroke="#5fd3c6" stroke-opacity=".18" stroke-width="1.5" />
          <!-- mitochondrion (energy for vesicle cycling) -->
          <g transform="translate(748 104) rotate(16)" class="mito">
            <ellipse rx="62" ry="26" />
            <path d="M-44 -12 C-38 0 -38 6 -44 16 M-24 -20 C-16 0 -16 6 -24 22 M-4 -22 C4 0 4 6 -4 22 M16 -22 C24 0 24 6 16 22 M36 -16 C42 0 42 6 36 16" />
          </g>
          <g data-ga-vesicles></g>
          <!-- active zone with dense projections -->
          <path d="M530 318 Q600 326 670 318" stroke="#5fd3c6" stroke-width="4" stroke-linecap="round" opacity=".55" />
          {[548, 574, 600, 626, 652].map((x) => <path d={`M${x} 319 l-5 -12 h10 z`} fill="#5fd3c6" opacity=".45" />)}
          <!-- postsynaptic spine on a dendrite -->
          <path d="M-20 820 L-20 720 C200 700 520 724 560 645 C578 604 468 560 452 470 C444 420 520 398 600 398 C680 398 756 420 748 470 C732 560 622 604 640 645 C680 724 1000 700 1220 720 L1220 820 Z" fill="url(#ga-post)" stroke="#8ff0c8" stroke-opacity=".7" stroke-width="2.5" />
          <path d="M-20 732 C200 712 520 736 560 657 M640 657 C680 736 1000 712 1220 732" fill="none" stroke="#8ff0c8" stroke-opacity=".16" stroke-width="1.5" />
          <ellipse cx="600" cy="470" rx="150" ry="80" fill="url(#ga-ca)" data-ga-ca opacity="0" />
          <!-- postsynaptic density -->
          <path d="M478 400 Q600 386 722 400" stroke="#8ff0c8" stroke-width="9" stroke-linecap="round" opacity=".22" />
          <!-- receptors -->
          <g data-ga-receptors>
            {[480, 525, 570, 630, 675, 720].map((x, i) => (
              <rect x={x - 7} y={i === 0 || i === 5 ? 404 : 393} width="14" height="22" rx="5" fill={i % 2 ? '#5fd3c6' : '#7cc8ff'} opacity=".9" />
            ))}
          </g>
          <!-- transporters (GLT-1) on the astrocyte membranes -->
          <g data-ga-transporters>
            {[[296, 340], [302, 386], [276, 420], [904, 340], [898, 386], [924, 420]].map(([x, y]) => (
              <g transform={`translate(${x} ${y})`}>
                <rect x="-9" y="-12" width="18" height="24" rx="8" class="tp" />
                <path d="M-7 -7 L7 7 M7 -7 L-7 7" class="tp-x" />
              </g>
            ))}
          </g>
          <g data-ga-glu></g>
          <g data-ga-abeta></g>
          <!-- labels -->
          <g class="lbl" data-ga-lbl="0">
            <text x="560" y="92" text-anchor="middle">Presynaptic terminal</text>
            <text x="700" y="575">Postsynaptic spine</text>
            <text x="120" y="350" text-anchor="middle">Astrocyte</text>
            <text x="1080" y="350" text-anchor="middle">Astrocyte</text>
            <text x="760" y="372" text-anchor="middle" class="lbl--glu">glutamate</text>
            <text x="200" y="480" text-anchor="middle" class="lbl--small">GLT-1 transporters</text>
            <text x="600" y="455" text-anchor="middle" class="lbl--small">AMPA · NMDA receptors</text>
            <text x="748" y="58" text-anchor="middle" class="lbl--small">mitochondrion</text>
          </g>
          <g class="lbl" data-ga-lbl="1" opacity="0">
            <text x="1040" y="520" text-anchor="middle" class="lbl--ab">soluble Aβ</text>
            <text x="1040" y="545" text-anchor="middle" class="lbl--small">impairs glutamate reuptake</text>
          </g>
        </g>

        <!-- vicious cycle overlay -->
        <g data-ga-cycle opacity="0">
          <path d="M600 60 A340 340 0 1 1 599 60" fill="none" stroke="#ff7a59" stroke-width="2.5" stroke-dasharray="10 10" opacity=".55" data-ga-ring pathLength="1" />
          {[
            [930, 150, 'more Aβ released'], [1010, 640, 'reuptake blocked'], [780, 738, 'glutamate lingers'], [170, 640, 'neuron hyperactive'],
          ].map(([x, y, t]) => (
            <g class="pill" transform={`translate(${x} ${y})`}><rect x="-104" y="-20" width="208" height="40" rx="20" /><text text-anchor="middle" y="6">{t}</text></g>
          ))}
          {[[860, 95, 40], [1060, 470, 120], [330, 760, 220], [150, 300, 300]].map(([x, y, r]) => (
            <path d="M-12 -9 L4 0 L-12 9" transform={`translate(${x} ${y}) rotate(${r})`} fill="none" stroke="#ff7a59" stroke-width="3" stroke-linecap="round" />
          ))}
        </g>

        <!-- ============ CA1 population ============ -->
        <g data-ga-pop opacity="0">
          <rect x="0" y="118" width="1200" height="34" fill="#9fb6c0" opacity=".06" />
          <text x="40" y="141" class="lbl lbl--layer">alveus</text>
          <text x="40" y="290" class="lbl lbl--layer">stratum oriens</text>
          <text x="40" y="410" class="lbl lbl--layer">stratum pyramidale</text>
          <text x="40" y="700" class="lbl lbl--layer">stratum radiatum</text>
          <g data-ga-plaque opacity="0" transform="translate(870 585)">
            <circle r="95" fill="#ff7a59" opacity=".08" />
            <g data-ga-fibrils stroke="#ff9a76" stroke-width="2.4" stroke-linecap="round" opacity=".85"></g>
            <circle r="34" fill="#ff7a59" opacity=".55" filter="url(#ga-blur)" />
            <circle r="22" fill="#ffb199" opacity=".85" />
            <text y="128" text-anchor="middle" class="lbl lbl--ab">amyloid plaque</text>
          </g>
          <g data-ga-neurons></g>
          <g class="legend" transform="translate(40 80)">
            <circle cx="8" cy="0" r="7" fill="#4dff9a" /><text x="24" y="5">hyperactive</text>
            <circle cx="160" cy="0" r="7" fill="#5fd3c6" opacity=".55" /><text x="176" y="5">normal</text>
            <circle cx="282" cy="0" r="7" fill="none" stroke="#86a0a9" stroke-dasharray="3 3" /><text x="298" y="5">silent</text>
          </g>
          <text x="1160" y="745" text-anchor="end" class="lbl lbl--phase" data-ga-phase>before plaques</text>
        </g>

        <!-- ============ Two-photon imaging ============ -->
        <g data-ga-img opacity="0">
          <path d="M520 -10 L680 -10 L668 30 L532 30 Z" fill="#1d3a47" stroke="#86a0a9" stroke-width="2" />
          <text x="700" y="22" class="lbl lbl--small">objective · 920 nm pulsed laser</text>
          <text x="700" y="44" class="lbl lbl--small lbl--faint">imaging window above CA1</text>
          <path data-ga-beam d="M540 30 L660 30 L600 470 Z" fill="url(#ga-beam)" />
          <circle data-ga-focus cx="600" cy="470" r="26" fill="url(#ga-focus)" />
          <rect data-ga-fov x="330" y="330" width="400" height="260" fill="none" stroke="#5fd3c6" stroke-width="2" stroke-dasharray="8 6" rx="4" />
          <text data-ga-fovlbl x="330" y="318" class="lbl lbl--small">field of view</text>
          <!-- GCaMP inset -->
          <g transform="translate(1010 160)" data-ga-gcamp>
            <circle r="118" fill="#071820" stroke="#5fd3c6" stroke-opacity=".5" stroke-width="2" />
            <rect x="-46" y="-32" width="92" height="64" rx="30" fill="#0e3a2a" stroke="#4dff9a" stroke-width="2" data-ga-gc />
            <circle r="60" fill="url(#ga-glow)" opacity="0" data-ga-gcglow />
            <g data-ga-ions fill="#ffd166">
              {[[-80, -60], [70, -70], [-90, 40], [80, 60]].map(([x, y]) => <circle cx={x} cy={y} r="7" />)}
            </g>
            <text y="-78" text-anchor="middle" class="lbl lbl--small">Ca²⁺ + GCaMP</text>
            <text y="92" text-anchor="middle" class="lbl lbl--small" data-ga-gctext>→ fluorescence</text>
          </g>
        </g>

        <!-- illustrative postsynaptic Ca²⁺ meter -->
        <g class="meter" transform="translate(30 30)" data-ga-meter>
          <rect width="260" height="74" rx="8" fill="#071820" fill-opacity=".75" stroke="#1d3a47" />
          <polyline data-ga-trace fill="none" stroke="#4dff9a" stroke-width="2" points="" />
          <text x="10" y="18" class="lbl lbl--small">spine Ca²⁺ (illustrative)</text>
        </g>
      </svg>

      <div class="ga__real" data-ga-real>
        <video src={url(rec.src)} poster={url(rec.poster)} muted loop playsinline preload="none" aria-label={rec.alt}></video>
        <span class="ga__reallbl"><Label kind="data" text="Lab data · real recording" /></span>
      </div>
      <figcaption class="ga__label" data-ga-label><Label kind="schematic" text={A.label} /></figcaption>
    </figure>
  </div>
</section>

<style>
  .ga { position: relative; }
  .ga__pin { height: 100vh; height: 100svh; display: grid; grid-template-columns: minmax(280px, 0.8fr) minmax(0, 1.6fr); gap: clamp(var(--s3), 4vw, var(--s6));
    align-items: center; padding: calc(var(--header-h) * 0.5) clamp(var(--s2), 4vw, var(--s6)); max-width: 1480px; margin: 0 auto; }
  .ga__text { position: relative; display: grid; gap: var(--s3); align-content: center; }
  .ga__meta { display: flex; align-items: center; gap: var(--s2); }
  .ga__count { color: var(--glow); font-size: .8rem; letter-spacing: .1em; }
  .ga__bar { flex: 1; height: 2px; background: var(--line); border-radius: 2px; overflow: hidden; max-width: 220px; }
  .ga__bar i { display: block; height: 100%; width: 100%; background: linear-gradient(90deg, var(--glow), #4dff9a); transform-origin: 0 50%; transform: scaleX(0); }
  .ga__chapters { display: flex; gap: 6px; }
  .ga__chapters button { width: 34px; height: 22px; padding: 0; border: 0; background: none; cursor: pointer; display: grid; place-items: center; }
  .ga__chapters span { width: 100%; height: 3px; border-radius: 3px; background: var(--line-2); transition: background .3s; }
  .ga__chapters button[aria-selected='true'] span { background: var(--glow); }
  .ga__chapters button:hover span { background: var(--text-3); }
  .ga__list { list-style: none; margin: 0; padding: 0; display: grid; min-height: 300px; }
  .ga__ch { grid-area: 1 / 1; opacity: 0; transform: translateY(18px); transition: opacity .5s var(--ease), transform .6s var(--ease); pointer-events: none; }
  .ga__ch.is-on { opacity: 1; transform: none; pointer-events: auto; }
  .ga__ch h4 { font-family: var(--font-serif); font-weight: 400; font-size: clamp(1.7rem, 2.8vw, 2.5rem); line-height: 1.1; margin: 0 0 var(--s2); }
  .ga__ch p { color: var(--text-2); font-size: 1.04rem; }
  .ga__refs { display: flex; flex-wrap: wrap; gap: 6px; font-size: .8rem; }
  .ga__refs a { font-family: var(--font-mono); font-size: .72rem; padding: .25em .6em; border: 1px solid var(--line-2); border-radius: 6px; color: var(--text-2); text-decoration: none; background: none !important; }
  .ga__refs a:hover { color: var(--glow); border-color: var(--glow); }
  .ga__handoff { font-family: var(--font-serif); font-style: italic; font-size: 1.3rem; color: var(--glow); opacity: 0; margin: 0; }

  .ga__stage { position: relative; margin: 0; aspect-ratio: 3 / 2; max-height: calc(100svh - var(--header-h) - 40px); width: 100%; justify-self: center;
    border-radius: 20px; overflow: hidden; border: 1px solid var(--line); background: radial-gradient(120% 90% at 50% 40%, #0c2733, #061218); }
  .ga__stage svg { width: 100%; height: 100%; }
  .ga__label { position: absolute; left: 14px; bottom: 12px; margin: 0; }
  .ga__real { position: absolute; inset: 0; opacity: 0; clip-path: inset(41.25% 39.17% 26.25% 27.5% round 6px); display: grid; place-items: center; background: #000; pointer-events: none; }
  .ga__real video { width: 100%; height: 100%; object-fit: cover; }
  .ga__reallbl { position: absolute; right: 14px; top: 12px; }

  svg :global(.lbl) { font-family: var(--font-mono); font-size: 17px; fill: #a9bcc3; letter-spacing: .04em; }
  svg :global(.lbl--small) { font-size: 14px; fill: #86a0a9; }
  svg :global(.lbl--glu) { fill: #ffd166; font-size: 14px; }
  svg :global(.lbl--ab) { fill: #ff9a76; font-size: 18px; }
  svg :global(.lbl--faint) { fill: #5f7f8a; font-size: 12px; }
  svg :global(.mito ellipse) { fill: #13394a; stroke: #5fd3c6; stroke-opacity: .45; stroke-width: 2; }
  svg :global(.mito path) { fill: none; stroke: #5fd3c6; stroke-opacity: .35; stroke-width: 2; }
  svg :global(.lbl--layer) { font-size: 13px; fill: #5f7f8a; text-transform: uppercase; letter-spacing: .14em; }
  svg :global(.lbl--phase) { font-family: var(--font-serif); font-style: italic; font-size: 26px; fill: #e9f1f3; }
  svg :global(.tp) { fill: #b9a8ff; transition: fill .4s; }
  svg :global(.tp-x) { stroke: #ff7a59; stroke-width: 3; stroke-linecap: round; opacity: 0; }
  svg :global(.pill rect) { fill: #071820; stroke: #ff7a59; stroke-opacity: .7; }
  svg :global(.pill text) { font-family: var(--font-mono); font-size: 15px; fill: #ffc1ad; }
  svg :global(.legend text) { font-family: var(--font-mono); font-size: 14px; fill: #a9bcc3; }

  @media (max-width: 960px) {
    .ga__pin { grid-template-columns: 1fr; grid-template-rows: auto 1fr; align-content: start; gap: var(--s2); padding-top: calc(var(--header-h) + 8px); }
    .ga__stage { order: -1; aspect-ratio: 4 / 3; max-height: 48svh; }
    .ga__list { min-height: 0; }
    .ga__ch h4 { font-size: 1.45rem; margin-bottom: 8px; }
    .ga__ch p { font-size: .95rem; margin-bottom: 8px; }
    .ga__handoff { font-size: 1.05rem; }
    .ga__label { right: 10px; bottom: 8px; left: 10px; }
    .ga__label :global(.label) { white-space: normal; font-size: .58rem; }
  }
  /* Without scroll choreography the chapters are chosen with the tabs */
  :global(:root[data-motion='off']) .ga__pin { height: auto; padding-block: var(--s6); }
</style>
