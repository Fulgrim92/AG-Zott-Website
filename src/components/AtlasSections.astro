---
/**
 * Coronal reference sections through the hippocampus from the Allen Mouse Brain CCFv3 (25 µm):
 * serial two-photon tomography average template with the atlas annotation as an interactive overlay.
 * Built by scripts/build-atlas-sections.py. Reference anatomy, not lab data and not immunohistochemistry.
 */
import Label from './Label.astro';
import { url } from '../lib/url';
---
<div class="as" data-as data-base={url('/assets/atlas/sections/')}>
  <div class="as__top">
    <div class="seg" role="group" aria-label="Overlay">
      <button aria-pressed="true" data-ov="hip">Hippocampus</button>
      <button aria-pressed="false" data-ov="all">All regions</button>
      <button aria-pressed="false" data-ov="outline">Outlines</button>
      <button aria-pressed="false" data-ov="none">None</button>
    </div>
    <span class="mono small as__readout" data-readout aria-live="polite">Hover a region</span>
  </div>

  <div class="as__stage" data-wipe>
    <canvas data-canvas aria-label="Coronal section of the mouse brain from the Allen atlas with region overlay. Use the slider to move through the hippocampus."></canvas>
    <p class="as__loading mono small" data-loading>Loading Allen atlas sections…</p>
  </div>

  <div class="as__nav">
    <button class="btn btn--sm" data-step="-1" aria-label="Previous section">←</button>
    <input type="range" min="0" max="0" value="0" data-slider aria-label="Section position (anterior to posterior)" />
    <button class="btn btn--sm" data-step="1" aria-label="Next section">→</button>
    <span class="mono small" data-pos></span>
  </div>

  <ul class="as__legend small" data-legend></ul>

  <p class="as__src small">
    <Label kind="schematic" text="Reference atlas" />
    <span class="muted">Allen Mouse Brain Common Coordinate Framework v3: average serial two-photon tomography template of 1,675 mice with the atlas annotation (Wang et al., 2020, <i>Cell</i>). © Allen Institute for Brain Science, via the <a href="https://portal.brain-map.org/atlases-and-data/bkp/abc-atlas" rel="noopener">Allen Brain Cell Atlas</a>. Bregma positions are approximate.</span>
  </p>
</div>

<style>
  .as { display: grid; gap: var(--s2); }
  .as__top { display: flex; justify-content: space-between; align-items: center; gap: var(--s2); flex-wrap: wrap; }
  .seg { display: inline-flex; gap: 2px; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); flex-wrap: wrap; }
  .seg button { border: 0; background: transparent; padding: .4em 1em; border-radius: 999px; cursor: pointer; font-size: .85rem; color: var(--text-2); }
  .seg button[aria-pressed='true'] { background: color-mix(in srgb, var(--accent) 18%, transparent); color: var(--accent); }
  .as__readout { color: var(--text-2); min-height: 1.4em; }
  .as__stage { position: relative; aspect-ratio: 456 / 320; background: #000; border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
  canvas { width: 100%; height: 100%; display: block; cursor: crosshair; }
  .as__loading { position: absolute; inset: 0; display: grid; place-items: center; margin: 0; color: var(--text-3); }
  .as__nav { display: flex; gap: var(--s1) var(--s2); align-items: center; flex-wrap: wrap; }
  .as__nav input { flex: 1; min-width: 160px; accent-color: var(--accent); }
  [data-pos] { color: var(--text-2); min-width: 22ch; }
  .as__legend { list-style: none; display: flex; flex-wrap: wrap; gap: 6px 16px; padding: 0; margin: 0; color: var(--text-2); }
  .as__legend :global(i) { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
  .as__src { display: flex; gap: var(--s2); align-items: flex-start; margin: 0; }
</style>

<script>
  type Region = { acronym: string; structure: string; division: string; name: string; color: string } | null;
  type Slice = { file: number; ap_voxel: number; bregma_mm_approx: number; palette: Region[] };
  type Meta = { width: number; height: number; step_um: number; slices: Slice[] };

  const HIP = new Set(['CA1', 'CA2', 'CA3', 'DG']);
  // Hippocampus view: distinct colours per field/layer (CA1 layers match the CA1 layer diagram on this site)
  const HIP_COLORS: [string, string, string][] = [
    ['CA1so', '#5aa9ff', 'CA1, stratum oriens'], ['CA1sp', '#4dff9a', 'CA1, pyramidal layer'], ['CA1sr', '#ff6b4a', 'CA1, stratum radiatum'],
    ['CA1slm', '#ff4fd8', 'CA1, lacunosum-moleculare'], ['CA2', '#ffc857', 'CA2'], ['CA3', '#b48cff', 'CA3'], ['DG', '#7fe7ff', 'Dentate gyrus'],
  ];
  const hipColor = (r: NonNullable<Region>) => (HIP_COLORS.find(([k]) => r.acronym === k) ?? HIP_COLORS.find(([k]) => r.structure === k) ?? [null, '#4dff9a'])[1];

  document.querySelectorAll<HTMLElement>('[data-as]').forEach(async (root) => {
    const base = root.dataset.base!;
    const canvas = root.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const ctx = canvas.getContext('2d')!;
    const slider = root.querySelector<HTMLInputElement>('[data-slider]')!;
    const pos = root.querySelector<HTMLElement>('[data-pos]')!;
    const readout = root.querySelector<HTMLElement>('[data-readout]')!;
    const legend = root.querySelector<HTMLUListElement>('[data-legend]')!;
    let meta: Meta;
    try { meta = await (await fetch(`${base}sections.json`)).json(); }
    catch { root.querySelector('[data-loading]')!.textContent = 'Atlas sections could not be loaded.'; return; }
    const W = meta.width, H = meta.height;
    const cache = new Map<number, Promise<{ tmpl: HTMLImageElement; labels: Uint8ClampedArray }>>();
    const off = document.createElement('canvas'); off.width = W; off.height = H;
    const octx = off.getContext('2d', { willReadFrequently: true })!;
    const overlay = document.createElement('canvas'); overlay.width = W; overlay.height = H;
    const ovctx = overlay.getContext('2d')!;
    let idx = Math.floor(meta.slices.length / 3), mode = 'hip', hover = -1, pinned = -1, current: { tmpl: HTMLImageElement; labels: Uint8ClampedArray } | null = null;

    const img = (src: string) => new Promise<HTMLImageElement>((res, rej) => { const i = new Image(); i.onload = () => res(i); i.onerror = rej; i.src = src; });
    const load = (k: number) => {
      if (!cache.has(k)) {
        const f = String(meta.slices[k].file).padStart(3, '0');
        cache.set(k, Promise.all([img(`${base}s${f}.jpg`), img(`${base}l${f}.png`)]).then(([tmpl, lab]) => {
          octx.clearRect(0, 0, W, H); octx.drawImage(lab, 0, 0);
          const d = octx.getImageData(0, 0, W, H).data, labels = new Uint8ClampedArray(W * H);
          for (let i = 0; i < W * H; i++) labels[i] = d[i * 4];
          return { tmpl, labels };
        }));
      }
      return cache.get(k)!;
    };

    const hex = (c: string) => [parseInt(c.slice(1, 3), 16), parseInt(c.slice(3, 5), 16), parseInt(c.slice(5, 7), 16)];
    const draw = () => {
      if (!current) return;
      const s = meta.slices[idx], pal = s.palette, labels = current.labels;
      const cw = canvas.clientWidth, ch = canvas.clientHeight, dpr = Math.min(devicePixelRatio, 2);
      canvas.width = cw * dpr; canvas.height = ch * dpr;
      ctx.imageSmoothingEnabled = true; ctx.drawImage(current.tmpl, 0, 0, canvas.width, canvas.height);
      const od = ovctx.createImageData(W, H), o = od.data;
      const rgb = pal.map((r) => (r ? hex(mode === 'hip' && HIP.has(r.structure) && r.division === 'HPF' ? hipColor(r) : r.color) : [0, 0, 0]));
      const focus = pinned >= 0 ? pinned : hover;
      for (let y = 0; y < H; y++) for (let x = 0; x < W; x++) {
        const i = y * W + x, l = labels[i], r = pal[l];
        if (!r) continue;
        const edge = (x < W - 1 && labels[i + 1] !== l) || (y < H - 1 && labels[i + W] !== l);
        const inHip = HIP.has(r.structure) && r.division === 'HPF';
        let a = 0;
        if (mode === 'all') a = edge ? 230 : 90;
        else if (mode === 'hip') a = inHip ? (edge ? 240 : 120) : (edge ? 40 : 0);
        else if (mode === 'outline') a = edge ? 170 : 0;
        if (l === focus) a = edge ? 255 : 190;
        if (!a) continue;
        const c = mode === 'outline' && l !== focus ? [255, 255, 255] : rgb[l];
        o[i * 4] = c[0]; o[i * 4 + 1] = c[1]; o[i * 4 + 2] = c[2]; o[i * 4 + 3] = a;
      }
      ovctx.putImageData(od, 0, 0);
      ctx.imageSmoothingEnabled = false; ctx.drawImage(overlay, 0, 0, canvas.width, canvas.height);
      pos.textContent = `Section ${idx + 1}/${meta.slices.length} · ≈ ${s.bregma_mm_approx.toFixed(2)} mm from bregma`;
    };

    const show = async (k: number) => {
      idx = Math.max(0, Math.min(meta.slices.length - 1, k)); slider.value = String(idx); hover = -1; pinned = -1;
      current = await load(idx);
      root.querySelector('[data-loading]')?.remove();
      draw();
      [idx - 1, idx + 1].forEach((n) => n >= 0 && n < meta.slices.length && load(n));
    };

    const regionAt = (e: PointerEvent) => {
      if (!current) return -1;
      const b = canvas.getBoundingClientRect();
      const x = Math.floor(((e.clientX - b.left) / b.width) * W), y = Math.floor(((e.clientY - b.top) / b.height) * H);
      return x >= 0 && y >= 0 && x < W && y < H ? current.labels[y * W + x] : -1;
    };
    const describe = (l: number) => { const r = meta.slices[idx].palette[l]; return r ? `${r.name} (${r.acronym})` : 'Outside the brain'; };
    canvas.addEventListener('pointermove', (e) => {
      const l = regionAt(e); if (l === hover) return;
      hover = l; readout.textContent = l >= 0 ? describe(l) : ''; if (pinned < 0) draw();
    });
    canvas.addEventListener('pointerleave', () => { hover = -1; if (pinned < 0) { readout.textContent = 'Hover a region'; draw(); } });
    canvas.addEventListener('click', (e) => { const l = regionAt(e); pinned = pinned === l ? -1 : l; readout.textContent = l >= 0 ? `${describe(l)}${pinned >= 0 ? ' · pinned' : ''}` : ''; draw(); });

    slider.max = String(meta.slices.length - 1);
    slider.addEventListener('input', () => show(+slider.value));
    root.querySelectorAll<HTMLButtonElement>('[data-step]').forEach((b) => b.addEventListener('click', () => show(idx + +b.dataset.step!)));
    root.querySelectorAll<HTMLButtonElement>('[data-ov]').forEach((b, _, all) => b.addEventListener('click', () => {
      mode = b.dataset.ov!; all.forEach((x) => x.setAttribute('aria-pressed', String(x === b))); legend.hidden = mode !== 'hip'; draw();
    }));
    new ResizeObserver(() => draw()).observe(canvas);

    legend.innerHTML = HIP_COLORS.map(([, c, label]) => `<li><i style="background:${c}"></i>${label}</li>`).join('');

    show(idx);
  });
</script>
