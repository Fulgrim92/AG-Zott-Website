---
/**
 * Illustrative time course of MRI enhancement after intrathecal injection of a contrast agent (gadobutrol) as a
 * CSF tracer, shaped after Ringstad et al. (2018) JCI Insight 3:e121537: CSF enhancement peaks at ~6–9 h,
 * brain tissue at ~24 h, both largely cleared by 48 h. Curves are schematic (relative units), not patient data.
 */
const W = 520, H = 260, L = 46, R = 16, T = 22, B = 44;
const hours = [0, 2, 6, 9, 24, 48];
// time axis: square-root scale so the first hours are readable
const X = (h: number) => L + (Math.sqrt(h) / Math.sqrt(48)) * (W - L - R);
const Y = (v: number) => H - B - v * (H - T - B);
const csf = (h: number) => (h <= 0 ? 0 : h < 7.5 ? Math.sin((h / 7.5) * Math.PI / 2) : h < 24 ? 1 - ((h - 7.5) / 16.5) * 0.5 : Math.max(0.05, 0.5 - ((h - 24) / 24) * 0.42));
const tissue = (h: number) => (h <= 0 ? 0 : h < 24 ? 0.62 * Math.pow(h / 24, 0.9) : Math.max(0.12, 0.62 - ((h - 24) / 24) * 0.45));
const path = (f: (h: number) => number) => Array.from({ length: 160 }, (_, i) => (i / 159) ** 2 * 48).map((h, i) => `${i ? 'L' : 'M'}${X(h).toFixed(1)} ${Y(f(h)).toFixed(1)}`).join(' ');
---
<figure class="mri" data-mri>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label="Illustrative time course: after injection into the spinal fluid, MRI enhancement of the fluid around the brain peaks after about 6 to 9 hours, enhancement of brain tissue peaks after about 24 hours, and both decline by 48 hours.">
    <g class="mri__grid">
      {hours.map((h) => <><line x1={X(h)} x2={X(h)} y1={T} y2={H - B} /><text x={X(h)} y={H - B + 18} text-anchor="middle">{h}</text></>)}
      <line x1={L} x2={W - R} y1={H - B} y2={H - B} class="ax" />
      <text x={(L + W - R) / 2} y={H - 6} text-anchor="middle">hours after injection</text>
      <text x="14" y={(T + H - B) / 2} transform={`rotate(-90 14 ${(T + H - B) / 2})`} text-anchor="middle">enhancement</text>
    </g>
    <path d={path(csf)} class="mri__c mri__c--csf" pathLength="1" />
    <path d={path(tissue)} class="mri__c mri__c--tis" pathLength="1" />
    <g class="mri__peaks">
      <circle cx={X(7.5)} cy={Y(1)} r="4" class="k1" /><text x={X(7.5) + 8} y={Y(1) - 6}>fluid peak ≈ 6–9 h</text>
      <circle cx={X(24)} cy={Y(0.62)} r="4" class="k2" /><text x={X(24) - 8} y={Y(0.62) - 10} text-anchor="end">tissue peak ≈ 24 h</text>
    </g>
    <g class="mri__key" transform={`translate(${W - R - 170} ${T + 4})`}>
      <line x1="0" x2="18" y1="0" y2="0" class="mri__c--csf" /><text x="24" y="4">CSF around the brain</text>
      <line x1="0" x2="18" y1="18" y2="18" class="mri__c--tis" /><text x="24" y="22">brain tissue</text>
    </g>
  </svg>
  <ol class="mri__steps small">
    <li><b>Fluid first.</b> The tracer spreads through the cerebrospinal fluid around the brain.</li>
    <li><b>Along the arteries.</b> It enters brain tissue next to the large arteries at the surface.</li>
    <li><b>Inwards, then out.</b> It spreads deeper, peaks after about a day, and is cleared over the following days.</li>
  </ol>
</figure>

<style>
  .mri { margin: 0; display: grid; gap: var(--s2); }
  .mri svg { width: 100%; height: auto; border-radius: var(--radius); background: radial-gradient(90% 90% at 30% 20%, #1d1030, #08070d); border: 1px solid var(--line); }
  .mri__grid line { stroke: #ffffff14; }
  .mri__grid .ax { stroke: #ffffff40; }
  .mri__grid text, .mri__key text, .mri__peaks text { font: 10px var(--font-mono); fill: #b9a9c9; }
  .mri__c { fill: none; stroke-width: 2.6; stroke-linecap: round; stroke-dasharray: 1; stroke-dashoffset: 1; }
  .mri__c--csf { stroke: #ff5fd2; } .mri__c--tis { stroke: #8fd0ff; }
  .mri__key line { stroke-width: 2.6; }
  .mri__peaks > * { opacity: 0; }
  .mri__peaks .k1 { fill: #ff5fd2; } .mri__peaks .k2 { fill: #8fd0ff; }
  .mri.is-in .mri__c { transition: stroke-dashoffset 2.2s var(--ease); stroke-dashoffset: 0; }
  .mri.is-in .mri__c--tis { transition-delay: .5s; }
  .mri.is-in .mri__peaks > * { opacity: 1; transition: opacity .5s 2.2s; }
  .mri__steps { margin: 0; padding-left: 1.2em; display: grid; gap: 4px; color: var(--text-2); }
  :global(:root[data-motion='off']) .mri__c { stroke-dashoffset: 0; transition: none; }
  :global(:root[data-motion='off']) .mri__peaks > * { opacity: 1; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-mri]').forEach((el) => {
    new IntersectionObserver(([e], o) => { if (e.isIntersecting) { el.classList.add('is-in'); o.disconnect(); } }, { threshold: 0.4 }).observe(el);
  });
</script>
