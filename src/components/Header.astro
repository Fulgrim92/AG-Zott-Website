---
import site from '../data/site.json';
import Logo from './Logo.astro';
import { url, stripBase } from '../lib/url';

const path = stripBase(Astro.url.pathname);

// Navigation. Edit labels/links here; research topics follow site.json → features.
const research = [
  { href: '/research/', label: 'Overview', note: 'Questions & approach' },
  { href: '/research/two-photon/', label: 'Two-photon imaging in CA1', note: 'In vivo calcium imaging', color: 'var(--green)' },
  ...(site.features.glymphatic ? [{ href: '/research/glymphatic/', label: 'Glymphatic system', note: 'Fluid clearance, from mouse to human MRI', color: 'var(--magenta)' }] : []),
  { href: '/research/immunohistochemistry/', label: 'Immunohistochemistry', note: 'Plaques & cells in brain sections', color: 'var(--blue)' },
  { href: '/research/electrophysiology/', label: 'Electrophysiology', note: 'EEG, LTP and field potentials', color: 'var(--red)' },
  { href: '/#methods', label: 'From photons to findings', note: 'Our analysis pipeline, step by step', sep: true },
];
const lab = [
  { href: '/funding/', label: 'Funding' },
  { href: '/teaching/', label: 'Teaching & theses' },
  { href: '/alumni/', label: 'Alumni' },
];
const nav = [
  { href: '/', label: 'Home' },
  { href: '/research/', label: 'Research', children: research },
  { href: '/team/', label: 'Team' },
  { href: '/papers/', label: 'Publications' },
  { href: '/news/', label: 'News' },
  { href: '/funding/', label: 'Lab', children: lab, match: ['/funding/', '/teaching/', '/alumni/'] },
  { href: '/contact/', label: 'Contact' },
];
const isActive = (item: { href: string; match?: string[] }) =>
  item.href === '/' ? path === '/' : (item.match ?? [item.href]).some((h) => path.startsWith(h));
---
<header class="site-header" data-header>
  <div class="hd">
    <a href={url('/')} class="brand" aria-label={`${site.name} — home`}>
      <Logo size={34} />
      <span class="brand__text">
        <span class="brand__name">{site.name.startsWith('AG ') ? <><span class="brand__ag">AG</span>{site.name.slice(3)}</> : site.name}</span>
        <span class="brand__sub">{site.tagline}</span>
      </span>
    </a>

    <nav aria-label="Main" class="hd__nav" id="main-nav">
      <ul role="list" class="hd__list">
        {nav.map((item, i) => (
          <li class:list={['hd__item', { 'has-menu': item.children, 'is-active': isActive(item) }]}>
            {item.children ? (
              <>
                <button class="hd__link" aria-expanded="false" aria-controls={`menu-${i}`} data-menu-btn>
                  {item.label}
                  <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2 4l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" /></svg>
                </button>
                <div class:list={['menu', { 'menu--wide': item.children.length > 4 }]} id={`menu-${i}`} data-menu>
                  <span class="menu__hl" aria-hidden="true" data-menu-hl></span>
                  <ul role="list">
                    {item.children.map((c: any, k: number) => (
                      <li class:list={[{ 'menu__sep': c.sep }]} style={`--k:${k}`}>
                        <a href={url(c.href)} aria-current={path === c.href ? 'page' : undefined} style={`--c:${c.color ?? 'var(--primary)'}`}>
                          <span class="menu__label">{c.color && <i class="menu__dot" aria-hidden="true"></i>}{c.label}<span class="menu__arr" aria-hidden="true">→</span></span>
                          {c.note && <span class="menu__note">{c.note}</span>}
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              </>
            ) : (
              <a class="hd__link" href={url(item.href)} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a>
            )}
          </li>
        ))}
      </ul>
      <a class="btn btn--primary hd__cta hd__cta--drawer" href={url('/contact/')}>Get in touch <span class="arr" aria-hidden="true">→</span></a>
    </nav>

    <div class="hd__end">
      <a class="btn btn--primary hd__cta" href={url('/contact/')} data-magnetic>Get in touch <span class="arr" aria-hidden="true">→</span></a>
      <button class="hd__burger" aria-controls="main-nav" aria-expanded="false" data-burger>
        <span class="visually-hidden">Menu</span><span class="bars" aria-hidden="true"></span>
      </button>
    </div>
  </div>
</header>
<div class="hd-scrim" data-scrim hidden></div>

<style>
  .site-header { position: fixed; inset: 0 0 auto 0; z-index: 200; height: var(--header-h);
    background: color-mix(in srgb, #fff 94%, transparent); backdrop-filter: saturate(1.6) blur(14px); -webkit-backdrop-filter: saturate(1.6) blur(14px);
    border-bottom: 1px solid transparent; transition: transform .45s var(--ease), border-color .3s, box-shadow .3s; }
  .site-header.is-scrolled { border-color: var(--line); box-shadow: 0 6px 24px -18px rgba(8, 30, 40, .35); }
  .site-header.is-hidden { transform: translateY(-100%); }
  .hd { max-width: 1360px; height: 100%; margin: 0 auto; padding: 0 clamp(var(--s2), 4vw, var(--s5)); display: flex; align-items: center; gap: var(--s3); }
  .brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; color: var(--text); }
  .brand:hover { color: var(--text); }
  .brand__text { display: grid; line-height: 1.15; }
  .brand__name { font-family: var(--font-serif); font-size: 1.34rem; letter-spacing: -.01em; display: inline-flex; align-items: baseline; gap: 6px; }
  .brand__ag { font: 700 .62rem var(--font-mono); letter-spacing: .14em; padding: 2px 5px 1px; border-radius: 4px; color: #fff;
    background: linear-gradient(135deg, #2a8f8a, var(--primary)); transform: translateY(-3px); }
  .brand:hover .brand__ag { background: linear-gradient(135deg, var(--glow), var(--primary)); }
  .brand__sub { font-size: .7rem; color: var(--text-3); max-width: 24ch; }

  .hd__nav { margin-left: auto; }
  .hd__list { list-style: none; margin: 0; padding: 0; display: flex; gap: 2px; align-items: center; }
  .hd__item { position: relative; }
  .hd__link { display: inline-flex; align-items: center; gap: 6px; padding: 8px 13px; border-radius: 8px; border: 0; background: none; cursor: pointer;
    font-size: .92rem; font-weight: 500; color: var(--text-2); text-decoration: none; position: relative; transition: color .2s, background .2s; }
  .hd__link:hover, .hd__link[aria-expanded='true'] { color: var(--text); background: var(--surface-2); }
  .hd__link svg { transition: transform .3s var(--ease); }
  .hd__link[aria-expanded='true'] svg { transform: rotate(180deg); }
  .hd__item.is-active > .hd__link { color: var(--text); }
  .hd__item.is-active > .hd__link::after { content: ''; position: absolute; left: 13px; right: 13px; bottom: 1px; height: 2px; border-radius: 2px; background: var(--primary); }

  .menu { position: absolute; top: calc(100% + 10px); left: -12px; min-width: 250px; padding: 8px; border-radius: 16px;
    background: color-mix(in srgb, #fff 97%, transparent); backdrop-filter: blur(20px) saturate(1.4); -webkit-backdrop-filter: blur(16px) saturate(1.4);
    border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(8, 40, 50, .45), 0 2px 6px rgba(8, 40, 50, .06);
    opacity: 0; visibility: hidden; transform: translateY(-8px) scale(.97); transform-origin: 24px 0;
    transition: opacity .22s var(--ease), transform .35s var(--ease), visibility 0s .35s; }
  /* accent hairline along the top edge */
  .menu::before { content: ''; position: absolute; left: 16px; right: 16px; top: -1px; height: 2px; border-radius: 2px;
    background: linear-gradient(90deg, transparent, var(--glow), var(--primary), transparent); transform: scaleX(0); transition: transform .6s var(--ease) .05s; }
  .menu--wide { min-width: 340px; }
  .menu.is-open { opacity: 1; visibility: visible; transform: none; transition: opacity .22s var(--ease), transform .35s var(--ease); }
  .menu.is-open::before { transform: none; }
  .menu ul { position: relative; list-style: none; margin: 0; padding: 0; display: grid; }
  .menu li { opacity: 0; transform: translateY(-4px); transition: opacity .25s var(--ease), transform .35s var(--ease); }
  .menu.is-open li { opacity: 1; transform: none; transition-delay: calc(var(--k) * 35ms + 60ms); }
  .menu__sep { margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--line); }
  /* one soft highlight that glides to the hovered item */
  .menu__hl { position: absolute; left: 8px; right: 8px; top: 0; height: 0; border-radius: 10px; pointer-events: none; opacity: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--hc, var(--primary)) 12%, #fff), color-mix(in srgb, var(--hc, var(--primary)) 4%, #fff));
    box-shadow: inset 3px 0 0 var(--hc, var(--primary)); transition: transform .32s var(--ease), height .32s var(--ease), opacity .2s, --hc .3s; }
  .menu__hl.is-on { opacity: 1; }
  .menu a { position: relative; display: grid; gap: 1px; padding: 9px 12px; border-radius: 10px; text-decoration: none; color: var(--text); transition: color .2s; }
  .menu a:hover, .menu a[aria-current] { color: var(--text); }
  .menu a[aria-current] { background: var(--surface-2); }
  .menu__label { display: flex; align-items: center; gap: 9px; font-weight: 550; font-size: .92rem; }
  .menu__arr { margin-left: auto; color: var(--c); opacity: 0; transform: translateX(-6px); transition: opacity .25s, transform .3s var(--ease); }
  .menu a:hover .menu__arr, .menu a:focus-visible .menu__arr { opacity: 1; transform: none; }
  .menu__note { font-size: .78rem; color: var(--text-3); padding-left: 0; transition: color .2s; }
  .menu a:hover .menu__note { color: var(--text-2); }
  .menu__dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--c); box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 18%, transparent); transition: transform .3s var(--ease); }
  .menu__dot::after { content: ''; position: absolute; inset: -3px; border-radius: 50%; border: 1.5px solid var(--c); opacity: 0; }
  .menu a:hover .menu__dot { transform: scale(1.25); }
  .menu a:hover .menu__dot::after { animation: menu-ping 1.2s var(--ease) infinite; }
  @keyframes menu-ping { from { transform: scale(.6); opacity: .9; } to { transform: scale(2.4); opacity: 0; } }
  .menu a:has(.menu__dot) .menu__note { padding-left: 17px; }
  :global(:root[data-motion='off']) .menu li, :global(:root[data-motion='off']) .menu__hl { transition: none; }
  :global(:root[data-motion='off']) .menu a:hover .menu__dot::after { animation: none; }

  .hd__end { display: flex; align-items: center; gap: 10px; }
  .hd__cta { padding: .62em 1.15em; font-size: .88rem; }
  .hd__cta--drawer { display: none; }
  .hd__burger { display: none; width: 42px; height: 42px; border-radius: 10px; border: 1px solid var(--line); background: #fff; cursor: pointer; place-items: center; }
  .bars, .bars::before, .bars::after { display: block; width: 18px; height: 1.6px; background: var(--text); position: relative; content: ''; transition: transform .3s var(--ease), background .2s; }
  .bars::before { position: absolute; top: -6px; } .bars::after { position: absolute; top: 6px; }
  [aria-expanded='true'] > .bars { background: transparent; }
  [aria-expanded='true'] > .bars::before { transform: translateY(6px) rotate(45deg); }
  [aria-expanded='true'] > .bars::after { transform: translateY(-6px) rotate(-45deg); }
  .hd-scrim { position: fixed; inset: 0; z-index: 190; background: rgba(7, 24, 32, .35); backdrop-filter: blur(2px); }
  .hd-scrim[hidden] { display: none; }

  @media (max-width: 1180px) { .brand__sub { display: none; } .hd__link { padding: 8px 10px; } }
  @media (max-width: 1023px) {
    .hd__burger { display: grid; }
    .hd__end .hd__cta { display: none; }
    .hd__end { margin-left: auto; }
    .hd__nav { position: fixed; top: var(--header-h); right: 0; bottom: 0; width: min(92vw, 380px); margin: 0; background: #fff; border-left: 1px solid var(--line);
      padding: var(--s3); overflow-y: auto; transform: translateX(102%); transition: transform .45s var(--ease); display: flex; flex-direction: column; gap: var(--s3); }
    .hd__nav.is-open { transform: none; box-shadow: -30px 0 60px -30px rgba(8, 30, 40, .4); }
    .hd__list { flex-direction: column; align-items: stretch; gap: 0; }
    .hd__item { border-bottom: 1px solid var(--line); }
    .hd__link { width: 100%; justify-content: space-between; padding: 14px 4px; font-size: 1.02rem; border-radius: 0; }
    .hd__link:hover, .hd__link[aria-expanded='true'] { background: none; }
    .hd__item.is-active > .hd__link::after { left: 0; right: auto; width: 3px; top: 14px; bottom: 14px; height: auto; margin-left: -12px; }
    .menu { position: static; opacity: 1; visibility: visible; transform: none; box-shadow: none; border: 0; padding: 0 0 10px; min-width: 0; display: none; }
    .menu.is-open { display: block; }
    .menu::before, .menu__hl { display: none; }
    .menu li { opacity: 1; transform: none; }
    .menu { background: none; backdrop-filter: none; -webkit-backdrop-filter: none; }
    .hd__cta--drawer { display: inline-flex; }
  }
</style>
